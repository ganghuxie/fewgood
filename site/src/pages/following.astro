---
import Layout from '../components/Layout.astro';
import { SITE_NAME } from '../lib/brand.mjs';
---
<Layout title={`已关注 · ${SITE_NAME}`} active="trending">
  <section class="following" data-base={import.meta.env.BASE_URL.replace(/\/$/, '')}>
    <h1>已关注</h1>
    <p class="empty" data-empty hidden>还没有关注的频道。去看看喜欢的视频吧。</p>
    <div class="video-grid" id="following-feed"></div>
    <div class="infinite-sentinel" data-infinite-sentinel aria-hidden="true"></div>
    <div class="infinite-spinner" data-infinite-spinner hidden>加载中…</div>
  </section>
</Layout>
<script>
  import { KEYS, list as libraryList, migrate } from '../scripts/library.js';
  import { CARD_THUMB_SIZES, relativePublishedTime, thumbFallbackAttr, thumbFor, thumbSrcset } from '../lib/format.mjs';

  const root = document.querySelector('.following');
  const base = root.dataset.base;
  const feed = root.querySelector('#following-feed');
  const empty = root.querySelector('[data-empty]');
  const sentinel = root.querySelector('[data-infinite-sentinel]');
  const spinner = root.querySelector('[data-infinite-spinner]');
  const esc = value => String(value || '').replace(/[&<>"']/g, char => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[char]));
  const date = value => value ? new Date(value).toISOString().slice(0, 10) : '';
  const duration = value => { const seconds = Number(value) || 0; return `${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, '0')}`; };
  const cardAvatar = channel => channel.thumbnail ? `<img class="channel-avatar" src="${esc(channel.thumbnail)}" alt="">` : `<span class="channel-avatar channel-avatar-letter" style="background:#607d8b">${esc([... (channel.title || '')][0] || '频')}</span>`;
  const views = value => Number(value) ? ` · ${Number(value).toLocaleString('zh-CN')}次观看` : '';
 const card = item => { const published = relativePublishedTime(item.video.published_at); return `<article class="video-card"><a class="card-link" href="https://www.youtube.com/watch?v=${esc(item.video.id)}" target="_blank" rel="noopener noreferrer"><div class="thumbnail"><img loading="lazy" src="${esc(thumbFor(item.video))}" srcset="${esc(thumbSrcset(item.video))}" sizes="${CARD_THUMB_SIZES}" ${thumbFallbackAttr(item.video.id)} alt=""><span class="duration">${duration(item.video.duration_seconds)}</span><button class="watch-later-action" type="button" data-watch-later data-id="${esc(item.video.id)}" data-title="${esc(item.video.title || item.video.id)}" data-channel="${esc(item.channel.title)}" data-duration="${Number(item.video.duration_seconds) || 0}" data-published-at="${esc(item.video.published_at || '')}" aria-label="添加到稍后观看" aria-pressed="false"></button></div><div class="video-info">${cardAvatar(item.channel)}<div class="video-copy"><h2 class="video-title">${esc(item.video.title || item.video.id)}</h2><p class="video-meta"><span class="video-meta-channel">${esc(item.channel.title)}</span>${Number(item.video.view_count) > 0 ? `<span class="video-meta-separator">·</span><span class="video-meta-views">${Number(item.video.view_count).toLocaleString('zh-CN')} 次播放</span>` : ''}${published ? `<span class="video-meta-separator">·</span><span class="video-meta-time">${published}</span>` : ''}</p></div></div></a></article>`; };
  let all = [];
  let shown = 0;
  const renderMore = () => { const next = all.slice(shown, shown + 20); if (!next.length) return; feed.insertAdjacentHTML('beforeend', next.map(card).join('')); shown += next.length; document.dispatchEvent(new Event('youtuber:library-change')); };
  const render = channels => {
    const map = Object.fromEntries(channels.map(channel => [channel.id, channel]));
    const followed = libraryList(KEYS.following).map(saved => ({ ...map[saved.id], ...saved })).filter(channel => channel.id);
    empty.hidden = followed.length > 0;
    all = followed.flatMap(channel => (channel.videos || []).map(video => ({ channel, video }))).sort((a, b) => Date.parse(b.video.published_at || '') - Date.parse(a.video.published_at || ''));
    feed.innerHTML = ''; shown = 0; renderMore();
  };
  fetch(`${base}/channels.json`).then(response => response.json()).then(data => { migrate(KEYS.following, [], data); render(data.channels || []); }).catch(() => render([]));
  const observer = new IntersectionObserver(entries => { if (entries.some(entry => entry.isIntersecting)) { spinner.hidden = false; requestAnimationFrame(() => { renderMore(); spinner.hidden = true; }); } }, { rootMargin: '500px' });
  observer.observe(sentinel);
</script>
<style>
.following h1{font-size:26px;margin:0 0 22px}.empty{color:#606060;padding:30px 0}.infinite-sentinel{height:1px}.infinite-spinner{text-align:center;color:#606060;padding:20px}
</style>
