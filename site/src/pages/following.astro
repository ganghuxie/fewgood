---
import Layout from '../components/Layout.astro';
import { SITE_NAME } from '../lib/brand.mjs';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Layout title={`已加入 · ${SITE_NAME}`} active="trending"><section class="following" data-base={base}><h1>已加入</h1><p class="empty" data-empty>还没有加入的频道。去看看喜欢的视频吧。</p><div class="channel-grid" data-list></div></section></Layout>
<script>
 import { KEYS, list as libraryList, migrate, toggleChannel } from '../scripts/library.js';
 const root = document.querySelector('[data-base]'), base = root.dataset.base, list = root.querySelector('[data-list]'), empty = root.querySelector('[data-empty]');
 const esc = s => String(s || '').replace(/[&<>"]/g, c => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;' }[c]));
 const render = channels => { const selected = libraryList(KEYS.following); const map = Object.fromEntries(channels.map(c => [c.id, c])); empty.hidden = !!selected.length; list.innerHTML = selected.map(c => { const data = map[c.id] || c; return `<article><a href="${base}/channel/${c.id}/"><img src="${esc(data.thumbnail || c.thumbnail)}" alt=""><b>${esc(data.title || c.title)}</b><small>${data.subscriber_count ? `${new Intl.NumberFormat('zh-CN', { notation: 'compact', maximumFractionDigits: 1 }).format(data.subscriber_count)} 位订阅者` : ''}</small></a><button data-id="${c.id}">已加入</button></article>`; }).join(''); list.querySelectorAll('button').forEach(b => b.onclick = () => { toggleChannel(selected.find(c => c.id === b.dataset.id)); render(channels); }); };
 fetch(`${base}/channels.json`).then(r => r.json()).then(data => { migrate(KEYS.following, [], data); render(data.channels || []); }).catch(() => render([]));
</script>
<style>.following h1{font-size:26px}.empty{color:#606060;padding:30px 0}.channel-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:24px 18px}.following article{position:relative;display:flex;flex-direction:column;align-items:center;text-align:center;padding:18px 12px;border:1px solid #eee;border-radius:12px}.following article a{display:flex;flex-direction:column;align-items:center;gap:8px;text-decoration:none;color:#0f0f0f}.following img,.avatar{width:96px;height:96px;border-radius:50%;object-fit:cover;background:#e5e5e5}.following article b{font-size:16px}.following article small{color:#606060}.following button{margin-top:12px;border:0;background:#f2f2f2;color:#0f0f0f;border-radius:18px;padding:9px 14px;cursor:pointer;font-weight:500}</style>
