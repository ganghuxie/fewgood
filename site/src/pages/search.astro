---
import Layout from '../components/Layout.astro';
import { SITE_NAME } from '../lib/brand.mjs';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Layout title={SITE_NAME + ' · 搜索'}><section class="search-page" data-base={base}><h1>搜索</h1><p class="search-note">只搜索 fewgood 精选池</p><p class="search-summary" data-summary>输入关键词，搜索视频标题和频道。只搜索 fewgood 精选池。</p><section class="video-section" data-video-section hidden><h2>视频</h2><div class="sr-video-grid" data-results></div></section><section class="channel-section" data-channel-section hidden><h2>频道</h2><div class="sr-channel-results" data-channels></div><button class="show-more" data-channel-more type="button" hidden>更多频道</button></section></section></Layout>
<script>
 import { track } from '../scripts/analytics.js';
 import { thumbFallbackAttr, thumbFor } from '../lib/format.mjs';
 const root = document.querySelector('[data-base]'), base = root.dataset.base, query = new URLSearchParams(location.search).get('q')?.trim() || '';
 const results = root.querySelector('[data-results]'), channelsEl = root.querySelector('[data-channels]'), summary = root.querySelector('[data-summary]'), channelSection = root.querySelector('[data-channel-section]'), videoSection = root.querySelector('[data-video-section]'), moreButton = root.querySelector('[data-channel-more]');
 const esc = value => String(value ?? '').replace(/[&<>"']/g, char => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[char]));
 const normalize = value => String(value || '').normalize('NFKC').toLocaleLowerCase();
 const latinTokens = value => normalize(value).match(/[a-z0-9]+/g) || [];
 const cjkText = value => normalize(value).match(/[\p{Script=Han}]+/gu)?.join('') || '';
 const hasCjk = value => /\p{Script=Han}/u.test(value);
 const editDistance = (a, b) => { if (Math.abs(a.length - b.length) > 2) return 99; let row = Array.from({ length: b.length + 1 }, (_, i) => i); for (let i = 0; i < a.length; i++) { const next = [i + 1]; for (let j = 0; j < b.length; j++) next.push(Math.min(next[j] + 1, row[j + 1] + 1, row[j] + (a[i] === b[j] ? 0 : 1))); row = next; } return row[b.length]; };
 const tokenMatches = (field, token) => { const text = normalize(field); if (hasCjk(token)) return cjkText(text).includes(cjkText(token)); const words = latinTokens(text); const escaped = token.replace(/[^\w\s-]/g, '\\$&'); const boundary = new RegExp('(?:^|[^a-z0-9])' + escaped + '(?=$|[^a-z0-9])'); return boundary.test(text) || (token.length >= 4 && words.some(word => editDistance(word, token) <= (token.length >= 8 ? 2 : 1))); };
 const cjkBigramOverlap = (field, queryText) => { const text = cjkText(field), queryCjk = cjkText(queryText); if (queryCjk.length < 2) return 0; const grams = new Set([...queryCjk].slice(0, -1).map((_, i) => queryCjk.slice(i, i + 2))); return [...grams].filter(g => text.includes(g)).length / grams.size; };
 let channelMap = {};
 const sectionLabels = ['全部', 'AI前沿', '播客', '音乐', '社区推荐'];
 const sectionNames = ['trending', 'ai', 'podcast', 'music', 'community'];
 const score = (item, q) => { const phrase = normalize(q), tokens = [...new Set([...latinTokens(q), ...(q.match(/[\p{Script=Han}]+/gu) || [])])]; const title = normalize((item.t || '') + ' ' + (item.z || '')), channel = normalize(channelMap[item.h]?.t || item.t), description = normalize(item.d || ''), labels = normalize(sectionLabels[item.s] || ''); const titlePhrase = tokenMatches(title, phrase); const titleHits = tokens.filter(token => tokenMatches(title, token)).length; const channelHits = tokens.filter(token => tokenMatches(channel, token)).length; const descHits = tokens.filter(token => tokenMatches(description, token)).length; const labelHits = tokens.filter(token => tokenMatches(labels, token)).length; const all = tokens.length > 0 && titleHits === tokens.length; const cjkBoost = cjkBigramOverlap(title + ' ' + channel + ' ' + description, q) * 60; if (!titlePhrase && !all && !channelHits && !descHits && !labelHits && !cjkBoost) return -1; return (titlePhrase ? 1000 : 0) + (all ? 700 : 0) + titleHits * 90 + channelHits * 55 + descHits * 25 + labelHits * 8 + cjkBoost; };
 const avatar = (channel, name) => { const title = channel?.t || name || '频道'; const letter = [...title.trim()][0] || '频'; let hash = 0; for (const character of title) hash = (hash * 31 + character.codePointAt(0)) >>> 0; const color = ['#d14b4b', '#b06b2f', '#8a6d1d', '#4f8a3d', '#357a8a', '#5367a6', '#7a5795'][hash % 7]; return channel?.m ? '<img class="sr-channel-avatar" src="' + esc(channel.m) + '" alt="">' : '<span class="sr-channel-avatar sr-channel-avatar-letter" style="background-color:' + color + '" aria-hidden="true">' + esc(letter) + '</span>'; };
 const duration = n => Math.floor(n / 60) + ':' + String(n % 60).padStart(2, '0');
 const normalizeVideoId = value => { const raw = String(value || '').trim(); try { const url = new URL(raw); if (url.hostname === 'youtu.be') return url.pathname.slice(1).split('/')[0]; if (url.hostname.endsWith('youtube.com')) return url.searchParams.get('v') || url.pathname.split('/').filter(Boolean).pop() || raw; } catch {} return raw.replace(/[?#].*$/, ''); };
 const normalizeTitle = value => String(value || '').normalize('NFKC').toLocaleLowerCase().replace(/[^\p{L}\p{N}]+/gu, '');
 const dedupeVideos = items => { const records = new Map(), aliases = new Map(); for (const item of items) { const id = normalizeVideoId(item.i), idKey = id && 'id:' + id, titleKey = 'title:' + normalizeTitle(channelMap[item.h]?.t) + ':' + normalizeTitle(item.t); const key = (idKey && aliases.get(idKey)) || aliases.get(titleKey) || idKey || titleKey; const prior = records.get(key); const itemRichness = (Number(item.u) > 0 ? 1 : 0) + (Number(item.d) > 0 ? 1 : 0); const priorRichness = prior ? (Number(prior.u) > 0 ? 1 : 0) + (Number(prior.d) > 0 ? 1 : 0) : -1; records.set(key, !prior || itemRichness > priorRichness ? item : prior); if (idKey) aliases.set(idKey, key); aliases.set(titleKey, key); } return [...records.values()]; };
 const subscribers = n => { n = Number(n) || 0; if (n >= 1e8) return (n / 1e8).toFixed(n % 1e8 ? 1 : 0).replace(/\.0$/, '') + '亿位订阅者'; if (n >= 1e4) return (n / 1e4).toFixed(n % 1e4 ? 1 : 0).replace(/\.0$/, '') + '万位订阅者'; return n.toLocaleString('zh-CN') + '位订阅者'; };
 const renderChannels = (items, showAll = false) => { channelsEl.innerHTML = (showAll ? items : items.slice(0, 3)).map(c => '<a class="sr-channel-result" href="' + base + '/channel/' + encodeURIComponent(c.i) + '/">' + avatar(c, c.t) + '<div class="sr-channel-result-copy"><h3>' + esc(c.t) + '</h3><p class="sr-channel-subs">' + subscribers(c.n) + '</p>' + (c.d ? '<p class="sr-channel-description">' + esc(c.d) + '</p>' : '') + '</div></a>').join(''); moreButton.hidden = items.length <= 3 || showAll; };
 if (query) { track('search', { query }); summary.textContent = '正在搜索“' + query + '”…'; fetch(base + '/search-index.json').then(response => { if (!response.ok) throw new Error('index'); return response.json(); }).then(index => { channelMap = Object.fromEntries(index.channels.map((c, i) => { const [id, t, m, n, d, l] = c; return [i, { i: id, t, m, n, d, l }]; })); const channels = index.channels.map(([i, t, m, n, d, l]) => ({ i, t, m, n, d, l })); const videos = dedupeVideos(index.videos.map(([i, t, h, d, z, u, s, e]) => ({ i, t, h, d, z, u, s, e }))); const channelMatches = channels.map(item => ({ ...item, _score: score(item, query) })).filter(item => item._score >= 0).sort((a, b) => b._score - a._score); const videoMatches = videos.map(item => ({ ...item, _score: score(item, query) })).filter(item => item._score >= 0).sort((a, b) => b._score - a._score); channelSection.hidden = !channelMatches.length; videoSection.hidden = !videoMatches.length; renderChannels(channelMatches); moreButton.onclick = () => renderChannels(channelMatches, true); results.innerHTML = videoMatches.map(v => { const channel = channelMap[v.h]; const name = channel?.t || ''; const badge = Number(v.u) > 0 ? '<span class="sr-duration">' + duration(Number(v.u)) + '</span>' : ''; return '<a class="sr-video-card" href="' + (v.e ? 'https://www.youtube.com/watch?v=' + encodeURIComponent(v.i) : base + '/v/' + encodeURIComponent(v.i) + '/') + '"' + (v.e ? ' target="_blank" rel="noopener noreferrer"' : '') + '><div class="sr-thumbnail"><img loading="lazy" src="' + esc(thumbFor({ id: v.i })) + '" ' + thumbFallbackAttr(v.i) + ' alt="">' + badge + '</div><div class="sr-video-info">' + avatar(channel, name) + '<div class="video-copy"><h2 class="sr-video-title">' + esc(v.t) + '</h2><p class="sr-video-meta">' + esc(name) + '</p></div></div></a>'; }).join(''); const count = channelMatches.length + videoMatches.length; summary.textContent = count ? '“' + query + '”的 ' + count + ' 个结果' : '没有找到“' + query + '”相关内容。'; }).catch(() => summary.textContent = '搜索目录暂时无法加载。'); }
</script>
<style is:global>html,body{overflow-x:hidden}.search-page{min-width:0;overflow-x:hidden}.search-page h1{font-size:26px;margin:0 0 8px}.search-note{color:#606060;margin:0 0 8px;font-size:14px}.search-summary{color:#606060;margin:0 0 24px}.channel-section,.video-section{margin-top:28px}.channel-section h2,.video-section h2{font-size:20px;margin:0 0 14px}.sr-channel-results{display:flex;flex-direction:column;gap:2px}.sr-channel-result{display:flex;align-items:center;gap:24px;max-width:900px;padding:14px 0;color:inherit;text-decoration:none}.sr-channel-avatar{width:120px;height:120px;flex:none;border-radius:50%;object-fit:cover}.sr-channel-avatar-letter{display:grid;place-items:center;color:#fff;font-size:36px;font-weight:700}.sr-channel-result-copy{min-width:0}.sr-channel-result-copy h3{font-size:18px;line-height:24px;margin:0 0 5px;font-weight:700;color:inherit}.sr-channel-subs{font-size:14px;color:#606060;margin:0 0 6px}.sr-channel-description{font-size:14px;line-height:21px;color:#606060;margin:0;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.show-more{margin:8px 0 12px;border:0;background:#f2f2f2;border-radius:20px;padding:9px 18px;font-size:14px;cursor:pointer}.show-more:hover{background:#e5e5e5}.sr-video-card{display:block;color:inherit;text-decoration:none}.sr-thumbnail{position:relative;aspect-ratio:16/9;background:#eee;border-radius:12px;overflow:hidden}.sr-thumbnail img{display:block;width:100%;height:100%;object-fit:cover}.sr-duration{position:absolute;right:5px;bottom:5px;background:#0f0f0ee6;color:#fff;padding:3px 4px;border-radius:4px;font-size:12px;font-weight:600}.sr-video-info{display:grid;grid-template-columns:36px minmax(0,1fr);gap:9px;padding:9px 3px;align-items:start;min-width:0}.sr-video-info .sr-channel-avatar{width:36px;height:36px;grid-row:1;align-self:start}.sr-video-info .sr-channel-avatar-letter{font-size:17px}.sr-video-title{font-size:16px;line-height:22px;font-weight:500;margin:0;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.sr-video-meta{font-size:14px;color:#606060;margin:0}.sr-video-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px 16px;margin-top:0}@media(min-width:1600px){.sr-video-grid{grid-template-columns:repeat(5,minmax(0,1fr))}}@media(min-width:1300px) and (max-width:1599px){.sr-video-grid{grid-template-columns:repeat(4,minmax(0,1fr))}}@media(max-width:899px){.sr-video-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:599px){.sr-channel-result{gap:16px;padding:10px 0}.sr-channel-avatar{width:80px;height:80px}.sr-channel-avatar-letter{font-size:26px}.sr-channel-result-copy h3{font-size:16px;line-height:22px}.sr-channel-description{font-size:13px;line-height:19px}.sr-video-grid{grid-template-columns:1fr;gap:20px}}</style>
