---
import Layout from '../components/Layout.astro';
import { SITE_NAME } from '../lib/brand.mjs';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Layout title={SITE_NAME + ' · 搜索'}><section class="search-page" data-base={base}><h1>搜索</h1><p class="search-summary" data-summary>输入关键词，搜索视频标题和频道。</p><section class="channel-section" data-channel-section hidden><h2>频道</h2><div class="channel-results" data-channels></div><button class="show-more" data-channel-more type="button" hidden>显示更多</button></section><section class="video-section" data-video-section hidden><h2>视频</h2><div class="video-grid" data-results></div></section></section></Layout>
<script>
 import { track } from '../scripts/analytics.js';
 const root = document.querySelector('[data-base]'), base = root.dataset.base, query = new URLSearchParams(location.search).get('q')?.trim() || '';
 const results = root.querySelector('[data-results]'), channelsEl = root.querySelector('[data-channels]'), summary = root.querySelector('[data-summary]'), channelSection = root.querySelector('[data-channel-section]'), videoSection = root.querySelector('[data-video-section]'), moreButton = root.querySelector('[data-channel-more]');
 const esc = value => String(value ?? '').replace(/[&<>"']/g, char => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[char]));
 const normalize = value => String(value || '').normalize('NFKC').toLocaleLowerCase();
 const latinTokens = value => normalize(value).match(/[a-z0-9]+/g) || [];
 const cjkText = value => normalize(value).match(/[\p{Script=Han}]+/gu)?.join('') || '';
 const hasCjk = value => /\p{Script=Han}/u.test(value);
 const editDistance = (a, b) => { if (Math.abs(a.length - b.length) > 2) return 99; let row = Array.from({ length: b.length + 1 }, (_, i) => i); for (let i = 0; i < a.length; i++) { const next = [i + 1]; for (let j = 0; j < b.length; j++) next.push(Math.min(next[j] + 1, row[j + 1] + 1, row[j] + (a[i] === b[j] ? 0 : 1))); row = next; } return row[b.length]; };
 const tokenMatches = (field, token) => { const text = normalize(field); if (hasCjk(token)) return cjkText(text).includes(cjkText(token)); const words = latinTokens(text); const escaped = token.replace(/[^\w\s-]/g, '\\$&'); const boundary = new RegExp('(?:^|[^a-z0-9])' + escaped + '(?=$|[^a-z0-9])'); return boundary.test(text) || (token.length >= 4 && words.some(word => editDistance(word, token) <= (token.length >= 8 ? 2 : 1))); };
 const cjkBigramOverlap = (field, queryText) => { const text = cjkText(field), queryCjk = cjkText(queryText); if (queryCjk.length < 2) return 0; const grams = new Set([...queryCjk].slice(0, -1).map((_, i) => queryCjk.slice(i, i + 2))); return [...grams].filter(g => text.includes(g)).length / grams.size; };
 const score = (item, q) => { const phrase = normalize(q), tokens = [...new Set([...latinTokens(q), ...(q.match(/[\p{Script=Han}]+/gu) || [])])]; const title = normalize((item.title || '') + ' ' + (item.title_zh || '')), channel = normalize(item.channel || item.title), description = normalize((item.description || '') + ' ' + (item.summary_zh || '')); const titlePhrase = tokenMatches(title, phrase); const titleHits = tokens.filter(token => tokenMatches(title, token)).length; const channelHits = tokens.filter(token => tokenMatches(channel, token)).length; const descHits = tokens.filter(token => tokenMatches(description, token)).length; const all = tokens.length > 0 && titleHits === tokens.length; const cjkBoost = cjkBigramOverlap(title + ' ' + channel + ' ' + description, q) * 60; if (!titlePhrase && !all && !channelHits && !descHits && !cjkBoost) return -1; const recency = Date.parse(item.published_at || item.selected_at || '') || 0; return (titlePhrase ? 1000 : 0) + (all ? 700 : 0) + titleHits * 90 + channelHits * 55 + descHits * 25 + cjkBoost + Math.log10(1 + recency / 86400000) + Math.log10(1 + (item.view_count || 0)) * 0.2; };
 const avatar = (channel, name) => { const title = channel?.title || name || '频道'; const letter = [...title.trim()][0] || '频'; let hash = 0; for (const character of title) hash = (hash * 31 + character.codePointAt(0)) >>> 0; const color = ['#d14b4b', '#b06b2f', '#8a6d1d', '#4f8a3d', '#357a8a', '#5367a6', '#7a5795'][hash % 7]; return channel?.thumbnail ? '<img class="channel-avatar" src="' + esc(channel.thumbnail) + '" alt="">' : '<span class="channel-avatar channel-avatar-letter" style="background-color:' + color + '" aria-hidden="true">' + esc(letter) + '</span>'; };
 const duration = n => Math.floor((n || 0) / 60) + ':' + String((n || 0) % 60).padStart(2, '0');
 const subscribers = n => { n = Number(n) || 0; if (n >= 1e8) return (n / 1e8).toFixed(n % 1e8 ? 1 : 0).replace(/\.0$/, '') + '亿 位订阅者'; if (n >= 1e4) return (n / 1e4).toFixed(n % 1e4 ? 1 : 0).replace(/\.0$/, '') + '万 位订阅者'; return n.toLocaleString('zh-CN') + ' 位订阅者'; };
 const renderChannels = (items, showAll = false) => { channelsEl.innerHTML = (showAll ? items : items.slice(0, 4)).map(c => '<a class="channel-result" href="' + base + '/channel/' + encodeURIComponent(c.id) + '/">' + avatar(c, c.title) + '<div class="channel-result-copy"><h3>' + esc(c.title) + '</h3><p class="channel-subs">' + subscribers(c.subscriber_count) + '</p><p class="channel-description">' + esc(c.description || '在 YouTube 上发现更多精彩内容。') + '</p></div></a>').join(''); moreButton.hidden = items.length <= 4 || showAll; };
 if (query) { track('search', { query }); summary.textContent = '正在搜索“' + query + '”…'; fetch(base + '/search-index.json').then(response => { if (!response.ok) throw new Error('index'); return response.json(); }).then(index => { const channelMatches = index.channels.map(item => ({ ...item, _score: score(item, query) })).filter(item => item._score >= 0).sort((a, b) => b._score - a._score); const videoMatches = index.videos.map(item => ({ ...item, _score: score(item, query) })).filter(item => item._score >= 0).sort((a, b) => b._score - a._score); const channelMap = Object.fromEntries(index.channels.map(c => [c.id, c])); channelSection.hidden = !channelMatches.length; videoSection.hidden = !videoMatches.length; renderChannels(channelMatches); moreButton.onclick = () => renderChannels(channelMatches, true); results.innerHTML = videoMatches.map(v => '<a class="video-card" href="' + base + '/v/' + encodeURIComponent(v.id) + '/?from=' + encodeURIComponent(v.section) + '"><div class="thumbnail"><img loading="lazy" src="https://i.ytimg.com/vi/' + encodeURIComponent(v.id) + '/hqdefault.jpg" alt=""><span class="duration">' + duration(v.duration_seconds) + '</span></div><div class="video-info">' + avatar(channelMap[v.channel_id], v.channel) + '<div><h2 class="video-title">' + esc(v.title) + '</h2><p class="video-meta">' + esc(v.channel) + '</p></div></div></a>').join(''); const count = channelMatches.length + videoMatches.length; summary.textContent = count ? '“' + query + '”的 ' + count + ' 个结果' : '没有找到“' + query + '”相关内容。'; }).catch(() => summary.textContent = '搜索目录暂时无法加载。'); }
</script>
<style>.search-page h1{font-size:26px;margin:0 0 8px}.search-summary{color:#606060;margin:0 0 24px}.channel-section,.video-section{margin-top:28px}.channel-section h2,.video-section h2{font-size:20px;margin:0 0 14px}.channel-results{display:flex;flex-direction:column;gap:2px}.channel-result{display:grid;grid-template-columns:120px minmax(0,720px);align-items:center;gap:24px;max-width:900px;padding:14px 0;color:inherit;text-decoration:none}.channel-result .channel-avatar{width:120px;height:120px;flex:none}.channel-result img{width:100%;height:100%;object-fit:cover;border-radius:50%}.channel-result-copy{min-width:0}.channel-result-copy h3{font-size:18px;line-height:24px;margin:0 0 5px;font-weight:500}.channel-subs{font-size:14px;color:#606060;margin:0 0 6px}.channel-description{font-size:14px;line-height:21px;color:#606060;margin:0;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.show-more{margin:8px 0 12px;border:0;background:#f2f2f2;border-radius:20px;padding:9px 18px;font-size:14px;cursor:pointer}.show-more:hover{background:#e5e5e5}.video-section .video-grid{margin-top:0}@media(max-width:599px){.channel-result{grid-template-columns:80px minmax(0,1fr);gap:16px;padding:10px 0}.channel-result .channel-avatar{width:80px;height:80px}.channel-result-copy h3{font-size:16px;line-height:22px}.channel-description{font-size:13px;line-height:19px}}</style>
