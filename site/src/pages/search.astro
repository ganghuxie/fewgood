---
import Layout from '../components/Layout.astro';
import { SITE_NAME } from '../lib/brand.mjs';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Layout title={`搜索 · ${SITE_NAME}`}><section class="search-page" data-base={base}><h1>搜索</h1><p class="search-summary" data-summary>输入关键词，搜索视频标题和频道。</p><div class="video-grid" data-results></div></section></Layout>
<script>
 const root = document.querySelector('[data-base]'), base = root.dataset.base, query = new URLSearchParams(location.search).get('q')?.trim() || '', results = root.querySelector('[data-results]'), summary = root.querySelector('[data-summary]');
 const avatar = (channel, name) => { const title = channel?.title || name || '频道'; const letter = [...title.trim()][0] || '频'; let hash = 0; for (const character of title) hash = (hash * 31 + character.codePointAt(0)) >>> 0; const color = ['#d14b4b', '#b06b2f', '#8a6d1d', '#4f8a3d', '#357a8a', '#5367a6', '#7a5795'][hash % 7]; return channel?.thumbnail ? `<img class="channel-avatar" src="${channel.thumbnail}" alt="">` : `<span class="channel-avatar channel-avatar-letter" style="background-color:${color}" aria-hidden="true">${letter}</span>`; };
 const esc = value => String(value || '').replace(/[&<>"]/g, char => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;' }[char])); const duration = n => `${Math.floor(n / 60)}:${String(n % 60).padStart(2, '0')}`;
 if (query) { summary.textContent = `正在搜索“${query}”…`; Promise.all([fetch(`${base}/catalog.json`).then(r => r.json()), fetch(`${base}/channels.json`).then(r => r.ok ? r.json() : { channels: [] })]).then(([catalog, channelData]) => { const q = query.toLocaleLowerCase(); const matches = catalog.filter(v => `${v.title} ${v.channel}`.toLocaleLowerCase().includes(q)); const channels = (channelData.channels || []).filter(c => c.title.toLocaleLowerCase().includes(q)); const channelMap = Object.fromEntries((channelData.channels || []).map(c => [c.id, c])); summary.textContent = matches.length + channels.length ? `“${query}”的 ${matches.length + channels.length} 个结果` : `没有找到“${query}”相关视频。`; results.innerHTML = channels.map(c => `<a class="video-card channel-result" href="${base}/channel/${c.id}/"><div class="channel-avatar">${c.thumbnail ? `<img src="${c.thumbnail}" alt="">` : avatar(c, c.title)}</div><div><h2 class="video-title">${esc(c.title)}</h2><p class="video-meta">频道 · ${esc(c.subscriber_count)}</p></div></a>`).join('') + matches.map(v => `<a class="video-card" href="${base}/v/${v.id}/?from=${v.section}"><div class="thumbnail"><img src="https://i.ytimg.com/vi/${v.id}/hqdefault.jpg" alt=""><span class="duration">${duration(v.duration_seconds)}</span></div><div class="video-info">${avatar(channelMap[v.channel_id], v.channel)}<div><h2 class="video-title">${esc(v.title)}</h2><p class="video-meta">${esc(v.channel)}</p></div></div></a>`).join(''); }).catch(() => summary.textContent = '视频目录暂时无法加载。'); }
</script>
<style>.search-page h1{font-size:26px;margin:0 0 8px}.search-summary{color:#606060;margin:0 0 24px}.channel-result{display:flex;align-items:center;gap:12px}.channel-result .channel-avatar{width:72px;height:72px;flex:none}.channel-result img{width:100%;height:100%;object-fit:cover;border-radius:50%}</style>
