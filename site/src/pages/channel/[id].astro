---
import Layout from '../../components/Layout.astro';
import ChannelAvatar from '../../components/ChannelAvatar.astro';
import channelsData from '../../data/channels.json';
import { SITE_NAME } from '../../lib/brand.mjs';
export function getStaticPaths() { return (channelsData.channels || []).map(channel => ({ params: { id: channel.id }, props: { channel } })); }
const { channel } = Astro.props; const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const compact = n => new Intl.NumberFormat('zh-CN', { notation: 'compact', maximumFractionDigits: 1 }).format(n || 0);
---
<Layout title={`${channel.title} · ${SITE_NAME}`} active="trending"><section class="channel"><header><ChannelAvatar channel={channel} /><div class="channel-summary"><h1>{channel.title}</h1><p>{[channel.subscriber_count ? `${compact(channel.subscriber_count)} 位订阅者` : '', channel.videos?.length ? `${channel.videos.length} 个视频` : ''].filter(Boolean).join(' · ')}</p><button class="subscribe-btn" data-follow data-id={channel.id}>加入</button></div></header><a class="youtube" href={`https://www.youtube.com/playlist?list=${channel.uploads_playlist_id}`} target="_blank" rel="noopener noreferrer">在 YouTube 查看全部作品 ↗</a><div class="video-grid" data-channel-grid>{channel.videos.slice(0, 20).map(video => <a class="video-card" href={`https://www.youtube.com/watch?v=${video.id}`} target="_blank" rel="noopener noreferrer"><div class="thumbnail"><img src={video.thumb || `https://i.ytimg.com/vi/${video.id}/hqdefault.jpg`} alt=""/></div><div class="video-info"><ChannelAvatar channel={channel} /><div><h2 class="video-title">{video.title}</h2><p class="video-meta">{video.published_at?.slice(0, 10)}</p></div></div></a>)}</div><div class="infinite-sentinel" data-infinite-sentinel aria-hidden="true"></div><div class="infinite-spinner" data-infinite-spinner hidden>加载中…</div></section></Layout>
<script type="application/json" id="channel-videos" set:html={JSON.stringify(channel.videos).replace(/</g, '\u003c')}></script>
<script>
  const grid = document.querySelector('[data-channel-grid]');
  const sentinel = document.querySelector('[data-infinite-sentinel]');
  const spinner = document.querySelector('[data-infinite-spinner]');
  const avatarHtml = grid.querySelector('.video-info')?.innerHTML?.match(/<img class="channel-avatar"[^>]*>|<span class="channel-avatar[\s\S]*?<\/span>/)?.[0] || '';
  const data = JSON.parse(document.querySelector('#channel-videos').textContent);
  let cursor = grid.children.length, loading = false;
  const esc = v => String(v ?? '').replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
  const card = video => { const a = document.createElement('a'); a.className = 'video-card'; a.href = `https://www.youtube.com/watch?v=${video.id}`; a.target = '_blank'; a.rel = 'noopener noreferrer';
    a.innerHTML = `<div class="thumbnail"><img src="${esc(video.thumb || `https://i.ytimg.com/vi/${video.id}/hqdefault.jpg`)}" alt=""></div><div class="video-info">${avatarHtml}<div><h2 class="video-title">${esc(video.title)}</h2><p class="video-meta">${esc((video.published_at || '').slice(0,10))}</p></div></div>`; return a; };
  const load = async () => { if (loading || cursor >= data.length) return; loading = true; spinner.hidden = false; await new Promise(requestAnimationFrame); data.slice(cursor, cursor + 20).forEach(v => grid.append(card(v))); cursor += 20; loading = false; spinner.hidden = true; if (cursor >= data.length) observer.disconnect(); };
  const observer = new IntersectionObserver(entries => { if (entries[0].isIntersecting) load(); }, { rootMargin: '500px' });
  if (cursor < data.length) observer.observe(sentinel); else { sentinel?.remove(); spinner?.remove(); }
</script>
<style>.infinite-sentinel{height:1px}.infinite-spinner{text-align:center;color:#606060;padding:22px}</style>
<script>import { KEYS, has, markChannelSeen, toggleChannel } from '../../scripts/library.js'; const button = document.querySelector('[data-follow]'); const snapshot = { id: button.dataset.id, title: button.closest('header').querySelector('h1').textContent, thumbnail: button.closest('header').querySelector('img')?.src || '' }; const paint = () => { const following = has(KEYS.following, button.dataset.id); button.textContent = following ? '已加入' : '加入'; button.classList.toggle('is-following', following); }; markChannelSeen(button.dataset.id); paint(); button.onclick = () => { toggleChannel(snapshot); paint(); };</script>
<style>.channel header{display:flex;align-items:center;gap:24px;margin:4px 0 22px}.channel header>.channel-avatar{width:120px;height:120px;flex:none}.channel-summary{display:flex;flex-direction:column;align-items:flex-start;gap:8px}.channel h1{margin:0;font-size:30px;line-height:1.2;font-weight:700}.channel p{margin:0;color:#606060;font-size:14px}.subscribe-btn{height:36px;padding:0 16px;border:0;border-radius:18px;background:#0f0f0f;color:#fff;font-weight:500;cursor:pointer;white-space:nowrap}.subscribe-btn.is-following{background:#f2f2f2;color:#0f0f0f}.youtube{display:inline-block;margin:0 0 24px;border:0;border-radius:18px;padding:10px 15px;background:#f2f2f2;color:#0f0f0f;text-decoration:none;cursor:pointer;font-weight:500}@media(max-width:599px){.channel header{gap:14px}.channel header>.channel-avatar{width:80px;height:80px}.channel h1{font-size:24px}}</style>
