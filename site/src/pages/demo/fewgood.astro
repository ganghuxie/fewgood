---
const modules = import.meta.glob('../../data/fewgood-mvp.json', { eager: true });
const loaded = Object.values(modules)[0] as any;
const data = loaded?.default || loaded || null;
const fmt = (n:number) => n >= 3600 ? `${Math.floor(n/3600)}:${String(Math.floor(n%3600/60)).padStart(2,'0')}:${String(n%60).padStart(2,'0')}` : `${Math.floor(n/60)}:${String(n%60).padStart(2,'0')}`;
const beijing = data?.data_refreshed_at ? new Intl.DateTimeFormat('zh-CN',{dateStyle:'medium',timeStyle:'short',timeZone:'Asia/Shanghai'}).format(new Date(data.data_refreshed_at)) : '';
const sourceLabel = (s:string) => s.startsWith('channel_uploads:') ? '频道上传' : s.startsWith('search:') ? `搜索「${s.slice(7)}」` : s.startsWith('existing:') ? `已有数据 ${s.slice(9)}` : s;
const evidenceLabel = (s:string) => s === 'existing_registry' ? '原有 X→YouTube 名单' : s === 'x_bio_youtube_link' ? 'X 资料直接链接 YouTube' : s === 'x_profile_plus_known_channel' ? 'X 认证资料 + YouTube 核验' : s === 'x_post_lead' ? 'X 帖子线索 + YouTube 核验' : s === 'knowledge_lead' ? '公开线索 + YouTube 核验' : s.startsWith('youtube_discovery:') ? `YouTube 高播放发现「${s.slice('youtube_discovery:'.length)}」` : '其他公开线索';
---
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="robots" content="noindex,nofollow"/><link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml"/><link rel="apple-touch-icon" sizes="180x180" href={`${import.meta.env.BASE_URL}apple-touch-icon-180.png`}/><title>fewgood. · AI 前沿</title></head><body>
  <section class="fewgood">
    <p class="brand">fewgood.</p><p class="tagline">a few good videos</p><h1>AI 前沿 <small>第 {data?.round || 1} 轮 · 博主优先</small></h1>
    {!data || !data.topics?.length ? <p class="empty">暂无实验数据</p> : <>
      <p class="refresh">数据最近刷新：{beijing}（北京时间）</p>
      <p class="stats">usage：search.list 调用 {data.usage_summary?.search_calls ?? 0} 次，其他端点 {data.usage_summary?.other_units ?? 0} 单位。</p>
      <p class="disclosure">视频及其标题、频道、播放量等数据来自 YouTube（通过 YouTube Data API）；主题分组与「推荐依据」由 fewgood 按公开规则生成，不是 YouTube 提供的数据或评分。<a href="https://www.youtube.com/t/terms" target="_blank" rel="noopener">YouTube 服务条款</a></p>
      <div class="tabs" role="tablist">{data.topics.map((t:any,i:number)=><button class:list={{active:i===0}} data-tab={t.id}>{t.name_zh}</button>)}</div>
      {data.topics.map((t:any,i:number)=><section class:list={{panel:true,show:i===0}} id={t.id}>
        <p>{t.definition}</p><p class="stats">{data.round >= 3 ? `R3 类型配额：教程/解读/讲座 ${t.stats.mix_target?.tutorial ?? 3}/${t.stats.mix_target?.explainer ?? 2}/${t.stats.mix_target?.talk ?? 1} · 实际 ${t.stats.mix_shown?.tutorial ?? 0}/${t.stats.mix_shown?.explainer ?? 0}/${t.stats.mix_shown?.talk ?? 0} · 符合条件 ${t.stats.eligible ?? 0} · 展示 ${t.stats.shown ?? 0}` : data.round === 2 ? `本主题精选博主 ${t.stats.creators_in_topic ?? 0} · 博主近 30 天视频命中 ${t.stats.matched ?? 0} · 符合条件 ${t.stats.eligible ?? 0} · 展示 ${t.stats.shown ?? 0}` : `搜索次数 ${t.stats.searches ?? 0} · 命中数 ${t.stats.matched ?? 0} · 符合条件数 ${t.stats.eligible ?? 0} · 展示 ${t.stats.shown ?? 0}`}</p>
        <p class="stats">基线搜索 {t.stats.baseline_searches} · tier1/2/3：{t.stats.matched_tier1}/{t.stats.matched_tier2}/{t.stats.matched_tier3}</p>
        {data.round === 2 && <details class="creators"><summary>本主题精选博主（{t.stats.creators_in_topic ?? 0}）</summary>{(data.creators || []).filter((c:any)=>c.status === 'included' && c.subtopics?.includes(t.id)).map((c:any)=><p><b>{c.name}</b> · {c.lang === 'zh' ? '中文' : 'English'} · {c.evidence?.map(evidenceLabel).join(' / ')} · 订阅数 {c.subscriber_count != null ? c.subscriber_count.toLocaleString() : '未知'}（来自 YouTube） · <a href={`https://www.youtube.com/channel/${c.channel_id}`} target="_blank" rel="noopener">YouTube 频道 ↗</a></p>)}</details>}
        {t.videos.length < 6 && <p class="scarce">候选不足，宁缺毋滥</p>}
        <div class="cards">{t.videos.map((v:any)=><article class="card"><a href={v.url} target="_blank" rel="noopener"><img src={v.thumbnail} alt="" loading="lazy"/><h2>{v.title}</h2></a><p>{v.channel_title} · {v.published_at?.slice(0,10)} · {fmt(v.duration_seconds)}</p>{v.content_type && <p class="type">{v.content_type === 'tutorial' ? '教程上手' : v.content_type === 'explainer' ? '底层逻辑讲解' : '名家讲座演讲'}</p>}{v.view_count != null && <p>播放 {v.view_count.toLocaleString()}</p>}<p class="sources">{v.sources.map(sourceLabel).join(' · ')}</p><a class="watch" href={v.url} target="_blank" rel="noopener">在 YouTube 观看 ↗</a><details><summary>推荐依据</summary><ul>{v.reasons.map((r:string)=><li>{r}</li>)}</ul></details></article>)}</div>
        <details class="baseline"><summary>对比：普通 YouTube 搜索前 6（A 组）</summary><p>A 组为 YouTube 搜索 API 按默认相关度返回的前 6 条，原样展示未修改。</p>{(data.baseline?.[t.id] || []).map((v:any)=><p class="baseline-item"><b>#{v.rank}</b> <a href={v.url} target="_blank" rel="noopener">{v.title}</a> · {v.channel_title} · {v.published_at?.slice(0,10)} · {v.duration_seconds ? fmt(v.duration_seconds) : '时长未知'} · {v.also_in_fewgood_topN ? '也在 fewgood Top6' : '不在 fewgood Top6'}</p>)}</details>
      </section>)}
    </>}
  </section>
</body></html>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach(button => button.onclick=()=>{document.querySelectorAll('[data-tab]').forEach(x=>x.classList.toggle('active',x===button));document.querySelectorAll('.panel').forEach(x=>x.classList.toggle('show',x.id===button.dataset.tab))});
</script>
<style>
 :global(body){margin:0;background:#fff;color:#111;font-family:Arial,sans-serif}.fewgood{max-width:1240px;margin:auto;padding:24px;overflow-wrap:anywhere}.brand{font-size:34px;font-weight:700;margin:0}.tagline{color:#666;margin-top:0}h1{margin:8px 0 4px}h1 small{font-size:14px;font-weight:400;color:#666}.refresh,.stats,.sources,.disclosure{color:#606060;font-size:14px}.type{display:inline-block;background:#eef3ff;color:#234;font-weight:600;border-radius:999px;padding:2px 8px}.disclosure{padding:10px;background:#f6f6f6;border-radius:8px}.tabs{display:flex;gap:8px;overflow:auto;padding:10px 0}.tabs button{white-space:nowrap;border:0;border-radius:18px;padding:9px 14px;cursor:pointer}.tabs .active{background:#111;color:white}.panel{display:none}.panel.show{display:block}.cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.card{min-width:0}.card img{width:100%;aspect-ratio:16/9;object-fit:cover;background:#eee;border-radius:10px}.card a{color:inherit;text-decoration:none}.card h2{font-size:16px;line-height:1.35;margin:7px 0}.card p{font-size:13px;margin:5px 0}.watch{font-size:13px;text-decoration:underline!important}.scarce{color:#9a6700}.baseline,.creators{margin-top:24px;padding:12px;background:#f6f6f6;border-radius:8px}.baseline-item{overflow-wrap:anywhere}.empty{padding:72px 0;color:#606060}@media(max-width:700px){.cards{grid-template-columns:1fr}.fewgood{padding:16px;max-width:100%;box-sizing:border-box;min-width:0}}
</style>
