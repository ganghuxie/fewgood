---
const aiModules = import.meta.glob('../../data/fewgood-mvp.json', { eager: true });
const podcastModules = import.meta.glob('../../data/fewgood-podcast.json', { eager: true });
const unwrap = (m:any) => { const x=Object.values(m)[0] as any; return x?.default || x || null; };
const themes=[{id:'ai',name:'AI 前沿',data:unwrap(aiModules)},{id:'podcast',name:'播客',data:unwrap(podcastModules)}];
const fmt=(n:number)=>n>=3600?`${Math.floor(n/3600)}:${String(Math.floor(n%3600/60)).padStart(2,'0')}:${String(n%60).padStart(2,'0')}`:`${Math.floor(n/60)}:${String(n%60).padStart(2,'0')}`;
const beijing=(d:any)=>d?.data_refreshed_at?new Intl.DateTimeFormat('zh-CN',{dateStyle:'medium',timeStyle:'short',timeZone:'Asia/Shanghai'}).format(new Date(d.data_refreshed_at)):'';
const sourceLabel=(s:string)=>s.startsWith('podcast_uploads:')?'频道上传':s.startsWith('channel_uploads:')?'频道上传':s.startsWith('search:')?`搜索「${s.slice(7)}」`:s;
const typeLabel=(v:any, theme:string)=>theme==='podcast'?(v.content_type_label || ({interview:'深度访谈',deep_dive:'专题解读',talk:'名家长谈'} as any)[v.content_type]):v.content_type==='tutorial'?'教程上手':v.content_type==='explainer'?'底层逻辑讲解':'名家讲座演讲';
---
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="robots" content="noindex,nofollow"/><link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml"/><title>fewgood.</title></head><body><section class="fewgood">
<p class="brand">fewgood.</p><p class="tagline">a few good videos</p><div class="themes" role="tablist">{themes.map((theme,i)=><button class:list={{active:i===0}} data-theme={theme.id}>{theme.name}</button>)}</div>
{themes.map((theme,themeIndex)=><section class:list={{theme:true,show:themeIndex===0}} data-theme-panel={theme.id}><h1>{theme.name} <small>{theme.data?.round ? `第 ${theme.data.round} 轮 · 博主优先` : '博主优先'}</small></h1>
{!theme.data || !theme.data.topics?.length ? <p class="empty">暂无实验数据；播客数据将在离线采集后显示。</p> : <><p class="refresh">数据最近刷新：{beijing(theme.data)}（北京时间）</p><p class="stats">usage：search.list 调用 {theme.data.usage_summary?.search_calls ?? 0} 次，其他端点 {theme.data.usage_summary?.other_units ?? 0} 单位。</p><p class="disclosure">视频及其标题、频道、播放量等数据来自 YouTube（通过 YouTube Data API）；主题分组与「推荐依据」由 fewgood 按公开规则生成，不是 YouTube 提供的数据或评分。<a href="https://www.youtube.com/t/terms" target="_blank" rel="noopener">YouTube 服务条款</a></p><div class="tabs" role="tablist">{theme.data.topics.map((t:any,i:number)=><button class:list={{active:i===0}} data-tab={`${theme.id}-${t.id}`}>{t.name_zh}</button>)}</div>
{theme.data.topics.map((t:any,i:number)=><section class:list={{panel:true,show:i===0}} id={`${theme.id}-${t.id}`}><p>{t.definition}</p><p class="stats">类型配额：{Object.entries(t.stats.mix_target || {}).map(([k,v])=>`${typeLabel({content_type:k},theme.id)} ${v}`).join(' / ')} · 实际 {Object.entries(t.stats.mix_shown || {}).map(([k,v])=>`${typeLabel({content_type:k},theme.id)} ${v}`).join(' / ')} · 符合条件 {t.stats.eligible ?? 0} · 展示 {t.stats.shown ?? 0}</p>{t.videos.length<6&&<p class="scarce">候选不足，宁缺毋滥</p>}<div class="cards">{t.videos.map((v:any)=><article class="card"><a href={v.url} target="_blank" rel="noopener">{v.thumbnail&&<img src={v.thumbnail} alt="" loading="lazy"/>}<h2>{v.title}</h2></a><p>{v.channel_title} · {v.published_at?.slice(0,10)} · {fmt(v.duration_seconds)}</p>{v.content_type&&<p class="type">{typeLabel(v,theme.id)}</p>}{v.view_count!=null&&<p>播放 {v.view_count.toLocaleString()}</p>}<p class="sources">{(v.sources || []).map(sourceLabel).join(' · ')}</p><a class="watch" href={v.url} target="_blank" rel="noopener">在 YouTube 观看 ↗</a><details><summary>推荐依据</summary><ul>{v.reasons.map((r:string)=><li>{r}</li>)}</ul></details></article>)}</div>{theme.id==='ai'&&<details class="baseline"><summary>对比：普通 YouTube 搜索前 6（A 组）</summary>{(theme.data.baseline?.[t.id] || []).map((v:any)=><p><a href={v.url} target="_blank" rel="noopener">{v.title}</a> · {v.channel_title}</p>)}</details>}</section>)}</>}</section>)}
</section></body></html>
<script>document.querySelectorAll<HTMLButtonElement>('[data-theme]').forEach(button=>button.onclick=()=>{document.querySelectorAll('[data-theme]').forEach(x=>x.classList.toggle('active',x===button));document.querySelectorAll('[data-theme-panel]').forEach(x=>x.classList.toggle('show',x.getAttribute('data-theme-panel')===button.dataset.theme))});document.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach(button=>button.onclick=()=>{const prefix=button.dataset.tab?.split('-').slice(0,1)[0];document.querySelectorAll('[data-tab]').forEach(x=>{if(x.dataset.tab?.startsWith(prefix+'-'))x.classList.toggle('active',x===button)});document.querySelectorAll('.panel').forEach(x=>{if(x.id.startsWith(prefix+'-'))x.classList.toggle('show',x.id===button.dataset.tab)})});</script>
<style>:global(body){margin:0;background:#fff;color:#111;font-family:Arial,sans-serif}.fewgood{max-width:1240px;margin:auto;padding:24px;overflow-wrap:anywhere}.brand{font-size:34px;font-weight:700;margin:0}.tagline{color:#666;margin-top:0}h1{margin:8px 0 4px}h1 small{font-size:14px;font-weight:400;color:#666}.refresh,.stats,.sources,.disclosure{color:#606060;font-size:14px}.type{display:inline-block;background:#eef3ff;color:#234;font-weight:600;border-radius:999px;padding:2px 8px}.disclosure,.baseline{padding:10px;background:#f6f6f6;border-radius:8px}.baseline{margin-top:24px}.themes,.tabs{display:flex;gap:8px;overflow:auto;padding:10px 0}.themes button,.tabs button{white-space:nowrap;border:0;border-radius:18px;padding:9px 14px;cursor:pointer}.themes .active,.tabs .active{background:#111;color:#fff}.theme,.panel{display:none}.theme.show,.panel.show{display:block}.cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.card{min-width:0}.card img{width:100%;aspect-ratio:16/9;object-fit:cover;background:#eee;border-radius:10px}.card a{color:inherit;text-decoration:none}.card h2{font-size:16px;line-height:1.35;margin:7px 0}.card p{font-size:13px;margin:5px 0}.watch{font-size:13px;text-decoration:underline!important}.scarce{color:#9a6700}.empty{padding:72px 0;color:#606060}@media(max-width:700px){.cards{grid-template-columns:1fr}.fewgood{padding:16px;max-width:100%;box-sizing:border-box;min-width:0}}</style>
