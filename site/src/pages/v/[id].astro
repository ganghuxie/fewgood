---
import trending from '../../data/trending.json';
import ai from '../../data/ai.json';
import community from '../../data/videos.json';
import { pageUrl, videoUrl } from '../../lib/pagination.mjs';
const feeds = { trending, ai, community };
export function getStaticPaths() {
  const feeds = { trending, ai, community };
  const byId = new Map();
  for (const [section, feed] of Object.entries(feeds)) {
    for (const video of feed.videos) {
      const group = byId.get(video.id) || [];
      group.push({ section, video }); byId.set(video.id, group);
    }
  }
  return [...byId].map(([id, entries]) => ({ params: { id }, props: { entries } }));
}
const { entries } = Astro.props;
const base = import.meta.env.BASE_URL;
const counts = { ai: ai.videos.length, community: community.videos.length };
const label = { trending: '推荐', ai: 'AI', community: '社区好评' };
const duration = (n: number) => `${Math.floor(n / 60)}:${String(n % 60).padStart(2, '0')}`;
const views = (n: number) => new Intl.NumberFormat('en', { notation: 'compact', maximumFractionDigits: 1 }).format(n || 0);
const date = (v: string | number) => typeof v === 'number' ? new Date(v * 1000).toISOString().slice(0, 10) : v.slice(0, 10);
---
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content="Long Echo in-site video player"/><title>{entries[0].video.title} · Long Echo</title></head><body><main>
<header class="topbar"><a class="round" href={pageUrl('trending', 1, base)} aria-label="推荐">♨</a><div class="brand">Long Echo</div><i></i><nav aria-label="Sections"><a class="chip" data-tab="ai" href={pageUrl('ai', 1, base)}>AI <b>{counts.ai}</b></a><a class="chip" data-tab="community" href={pageUrl('community', 1, base)}>社区好评 <b>{counts.community}</b></a></nav></header>
{entries.map(({ section, video }) => <section class="detail" data-source={section}>
  <p class="kicker">{label[section]} · IN-SITE WATCHING</p><div class="player"><iframe src={`https://www.youtube-nocookie.com/embed/${video.id}`} title={video.title} allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe></div>
  <div class="info"><div><p class="channel">{video.channel}</p><h1>{video.title}</h1><p class="meta">{section === 'community' ? `${video.recommenders} people · ${video.months} months · ${date(video.first)} → ${date(video.last)}` : `${views(video.view_count)} views · ${date(video.published_at)}`} · {duration(video.duration_seconds)}</p></div><a class="youtube" href={`https://www.youtube.com/watch?v=${video.id}`} target="_blank" rel="noopener noreferrer">进入 YouTube 观看 ↗</a></div>
  <section class="related"><h2>同类视频</h2><div class="related-grid">{feeds[section].videos.filter(v => v.id !== video.id).slice(0, 6).map(v => <a class="related-card" href={videoUrl(section, v.id, base)}><img loading="lazy" src={`https://i.ytimg.com/vi/${v.id}/mqdefault.jpg`} alt=""/><span><b>{v.title}</b><small>{v.channel}</small></span></a>)}</div></section>
</section>)}
<footer>Long Echo · Privacy-enhanced YouTube embed</footer>
</main><script is:inline>{`const from = new URLSearchParams(location.search).get('from'); const available = [...document.querySelectorAll('[data-source]')]; const selected = available.some(n => n.dataset.source === from) ? from : available[0]?.dataset.source; available.forEach(n => n.hidden = n.dataset.source !== selected); document.querySelectorAll('[data-tab]').forEach(n => n.classList.toggle('active', n.dataset.tab === selected));`}</script><style is:global>
:root{font-family:ui-sans-serif,system-ui,sans-serif;color:#27232d;background:#faf9f7}*{box-sizing:border-box}body{margin:0}main{max-width:1120px;margin:auto;padding:16px 28px 52px}.topbar{height:58px;display:flex;align-items:center;gap:12px;border-bottom:1px solid #e7e2df}.round{width:38px;height:38px;border-radius:50%;display:grid;place-content:center;text-decoration:none;background:#f6e7ed;color:#d74778;font-size:17px}.brand{font-weight:800;letter-spacing:-.6px;font-size:16px}.topbar i{height:24px;border-left:1px solid #d9d1ce;margin-left:auto}.topbar nav{display:flex;gap:8px}.chip{padding:8px 12px;border-radius:18px;font-size:13px;text-decoration:none;color:#625c59;background:#f2efec}.chip.active{background:#312b38;color:#fff}.chip b{font-size:11px;margin-left:4px}.detail{padding-top:28px}.kicker{font-size:10px;letter-spacing:1.4px;color:#a36d7b;font-weight:700;margin:0 0 10px}.player{aspect-ratio:16/9;background:#18151a;border-radius:10px;overflow:hidden}.player iframe{border:0;width:100%;height:100%}.info{padding:18px 0 23px;display:flex;align-items:end;gap:20px;justify-content:space-between;border-bottom:1px solid #e7e2df}.channel{font-size:11px;color:#9e6579;text-transform:uppercase;letter-spacing:.5px;margin:0}h1{font-size:25px;line-height:1.28;letter-spacing:-.7px;margin:7px 0}.meta{font-size:13px;color:#817976;margin:0}.youtube{white-space:nowrap;padding:10px 13px;border-radius:7px;background:#312b38;color:#fff;font-size:13px;text-decoration:none}.related{padding-top:25px}.related h2{font-size:16px;margin:0 0 13px}.related-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.related-card{display:flex;gap:8px;text-decoration:none;font-size:12px;line-height:1.35}.related-card img{width:120px;height:68px;object-fit:cover;border-radius:5px;background:#eee}.related-card span{display:flex;flex-direction:column;gap:5px}.related-card b{font-weight:650}.related-card small{color:#8c827e}footer{margin-top:42px;text-align:center;color:#958d89;font-size:11px}@media(max-width:700px){main{padding:10px 14px 35px}.brand{display:none}.topbar i{margin-left:auto}.info{align-items:start;flex-direction:column}.related-grid{grid-template-columns:1fr}.related-card img{width:140px;height:79px}h1{font-size:21px}}
</style></body></html>
