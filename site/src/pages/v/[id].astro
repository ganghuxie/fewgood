---
import trending from '../../data/trending.json';
import ai from '../../data/ai.json';
import community from '../../data/videos.json';
import { optionalFeed } from '../../lib/feeds.mjs';
import { videoUrl } from '../../lib/pagination.mjs';
import Layout from '../../components/Layout.astro';
import { SITE_NAME } from '../../lib/brand.mjs';
const feeds = { trending, ai, podcast: optionalFeed('podcast'), music: optionalFeed('music'), community };
export function getStaticPaths() { const sources = { trending, ai, podcast: optionalFeed('podcast'), music: optionalFeed('music'), community }; const byId = new Map(); for (const [section, feed] of Object.entries(sources)) for (const video of feed.videos) byId.set(video.id, [...(byId.get(video.id) || []), { section, video }]); return [...byId].map(([id, entries]) => ({ params: { id }, props: { entries } })); }
const { entries } = Astro.props; const base = import.meta.env.BASE_URL;
const duration = n => `${Math.floor(n / 60)}:${String(n % 60).padStart(2, '0')}`;
const compact = n => new Intl.NumberFormat('zh-CN', { notation: 'compact', maximumFractionDigits: 1 }).format(n || 0);
---
<Layout title={`${entries[0].video.title} · ${SITE_NAME}`} active={entries[0].section} description="YouTuber 视频播放页">
{entries.map(({ section, video }) => <section class="detail" data-source={section}><div class="player"><iframe src={`https://www.youtube-nocookie.com/embed/${video.id}`} title={video.title} allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe></div><h1>{video.title}</h1><p class="meta"><a href={video.channel_id ? `${base.replace(/\/$/, '')}/channel/${video.channel_id}/` : undefined}>{video.channel}</a> <button class="follow-inline" data-follow-channel data-channel={video.channel_id} data-channel-name={video.channel}>关注</button> · {section === 'community' ? `${video.recommenders} 人推荐 · ${video.months} 个月` : `${compact(video.view_count)} 次观看`} · {duration(video.duration_seconds)}</p><div class="actions"><button data-library-toggle="favorites" data-id={video.id}>☆ 收藏</button><button data-library-toggle="watchLater" data-id={video.id}>◷ 稍后再看</button><a href={`https://www.youtube.com/watch?v=${video.id}`} target="_blank" rel="noopener noreferrer">进入 YouTube 观看 ↗</a></div><section class="related"><h2>同类视频</h2><div class="related-grid">{feeds[section].videos.filter(v => v.id !== video.id).slice(0, 6).map(v => <a href={videoUrl(section, v.id, base)}><img loading="lazy" src={`https://i.ytimg.com/vi/${v.id}/mqdefault.jpg`} alt=""/><span><b>{v.title}</b><small>{v.channel}</small></span></a>)}</div></section></section>)}
</Layout>
<script>
 import { KEYS, addHistory, has, toggle } from '../../scripts/library.js';
 const source = new URLSearchParams(location.search).get('from'); const sections = [...document.querySelectorAll('[data-source]')]; const selected = sections.some(el => el.dataset.source === source) ? source : sections[0]?.dataset.source; sections.forEach(el => el.hidden = el.dataset.source !== selected);
 const labels = { favorites: ['☆ 收藏', '★ 已收藏'], watchLater: ['◷ 稍后再看', '◷ 已在稍后再看'] };
 const paint = button => { const key = button.dataset.libraryToggle, id = button.dataset.id; button.textContent = labels[key][has(KEYS[key], id) ? 1 : 0]; };
 document.querySelectorAll('[data-library-toggle]').forEach(button => { paint(button); button.addEventListener('click', () => { toggle(KEYS[button.dataset.libraryToggle], button.dataset.id); paint(button); }); });
 document.querySelectorAll('[data-follow-channel]').forEach(button => { if (!button.dataset.channel) { button.hidden = true; return; } const paintFollow = () => button.textContent = has(KEYS.following, button.dataset.channel) ? '已关注' : '关注'; paintFollow(); button.addEventListener('click', () => { toggle(KEYS.following, button.dataset.channel); paintFollow(); }); });
 if (sections[0]) addHistory(document.querySelector('[data-library-toggle]')?.dataset.id);
</script>
<style>
.detail{max-width:1050px;margin:auto}.player{aspect-ratio:16/9;background:#000;border-radius:12px;overflow:hidden}.player iframe{border:0;width:100%;height:100%}h1{font-size:22px;margin:16px 0 7px}.meta{color:#606060;font-size:14px;margin:0}.follow-inline{border:0;border-radius:14px;padding:5px 10px;font-weight:500;cursor:pointer}.actions{display:flex;gap:10px;flex-wrap:wrap;margin:18px 0 30px}.actions button,.actions a{border:0;border-radius:18px;background:#f2f2f2;padding:9px 13px;font-weight:600;text-decoration:none;color:#0f0f0f;font-size:14px;cursor:pointer}.actions a{background:#0f0f0f;color:#fff}.related{border-top:1px solid #e5e5e5;padding-top:20px}.related h2{font-size:18px}.related-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.related-grid a{display:flex;gap:8px;text-decoration:none;color:inherit;font-size:13px}.related-grid img{width:120px;height:68px;object-fit:cover;border-radius:7px}.related-grid span{display:flex;flex-direction:column;gap:5px}.related-grid small{color:#606060}@media(max-width:700px){.related-grid{grid-template-columns:1fr}}
</style>
