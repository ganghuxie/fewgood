---
import picks from '../../data/picks.json';
import trending from '../../data/trending.json';
import ai from '../../data/ai.json';
import podcast from '../../data/podcast.json';
import music from '../../data/music.json';
import editorial from '../../data/editorial.json';
import community from '../../data/videos.json';
import catalog from '../../data/catalog.json';
import hnPool from '../../data/hn_pool.json';
import topicsData from '../../data/topics.json';
import zhData from '../../data/zh.json';
import channelsData from '../../data/channels.json';
import { videoUrl } from '../../lib/pagination.mjs';
import Layout from '../../components/Layout.astro';
import ChannelAvatar from '../../components/ChannelAvatar.astro';
import { SITE_NAME } from '../../lib/brand.mjs';
import { humanizeRecommendSpan } from '../../lib/format.mjs';
const feeds = { picks, trending, ai, podcast, music, editorial, community };
export function getStaticPaths() {
  const sources = { picks, trending, ai, podcast, music, community };
  const byId = new Map();
  const add = (video, section) => {
    if (!video?.id) return;
    const entries = byId.get(video.id) || [];
    if (!entries.some(entry => entry.section === section)) entries.push({ section, video });
    byId.set(video.id, entries);
  };
  for (const [section, feed] of Object.entries(sources)) for (const video of feed.videos) add(video, section);
  for (const video of catalog) if (!byId.has(video.id)) add(video, video.section || 'editorial');
  const poolById = new Map((hnPool.videos || []).map(video => [video.id, video]));
  for (const video of hnPool.videos || []) if (!byId.has(video.id)) add(video, 'topic');
  for (const topic of topicsData.topics || []) for (const id of topic.video_ids || []) {
    if (byId.has(id)) continue;
    add(poolById.get(id) || { id, title: id, channel: '', duration_seconds: 0 }, 'topic');
  }
  return [...byId].map(([id, entries]) => ({ params: { id }, props: { entries } }));
}
const { entries } = Astro.props; const base = import.meta.env.BASE_URL;
const duration = n => `${Math.floor(n / 60)}:${String(n % 60).padStart(2, '0')}`;
const snapshot = video => ({ id: video.id, title: video.title, thumbnail: video.thumb || `https://i.ytimg.com/vi/${video.id}/maxresdefault.jpg`, channelId: video.channel_id, channel: video.channel, avatar: video.channel_id ? (channelsData.channels || []).find(c => c.id === video.channel_id)?.thumbnail || '' : '', duration: video.duration_seconds, views: video.view_count, published_at: video.published_at, why_good: video.why_good, pick_source: video.pick_source, source: video.source, recommenders: video.recommenders, months: video.months, span_days: video.span_days, community_classic: video.community_classic });
const compact = n => new Intl.NumberFormat('zh-CN', { notation: 'compact', maximumFractionDigits: 1 }).format(n || 0);
const channelFor = video => (channelsData.channels || []).find(channel => channel.id === video.channel_id);
const subscriberLabelFor = video => { const count = channelFor(video)?.subscriber_count; return count !== null && count !== undefined && count !== '' && count !== 'hidden' && Number(count) > 0 ? `${compact(Number(count))}位订阅者` : ''; };
const channelUrl = video => video.channel_id ? `${base.replace(/\/$/, '')}/channel/${video.channel_id}/` : undefined;
const zhFor = (section, video) => (zhData.videos || {})[video.id] || null;
const isCommunity = (section, video) => section === 'community' || (section === 'picks' && video.source === 'community');
const titleFor = (section, video) => zhFor(section, video)?.title_zh || video.title;
const bannedWhyGood = /本周新片|近30天播放|近 30 天同类|播放第/;
const humanWhyGood = value => { const text = String(value || '').trim(); return text && !bannedWhyGood.test(text) ? text : ''; };
const beijingDate = value => { if (!value) return ''; const date = new Date(value); if (Number.isNaN(date.getTime())) return ''; const parts = new Intl.DateTimeFormat('en-US', { timeZone: 'Asia/Shanghai', year: 'numeric', month: '2-digit', day: '2-digit' }).formatToParts(date); const part = type => parts.find(item => item.type === type)?.value || ''; return `${part('year')}-${part('month')}-${part('day')}`; };
const metaLine = (section, video) => { const span = humanizeRecommendSpan(video.span_days); const body = isCommunity(section, video) ? `${video.recommenders} 人推荐${span ? ` · ${span}` : ''}` : `${compact(video.view_count)} 次观看`; return [beijingDate(video.published_at), body, duration(video.duration_seconds)].filter(Boolean).join(' · '); };
const timestamp = seconds => `${Math.floor(seconds / 60)}:${String(Math.floor(seconds % 60)).padStart(2, '0')}`;
const relatedFor = (section, video) => (feeds[section]?.videos || []).filter(v => v.id !== video.id).slice(0, 6).map(v => ({ id: v.id, title: v.title, channel: v.channel, thumb: `https://i.ytimg.com/vi/${v.id}/maxresdefault.jpg`, url: videoUrl(section, v.id, base) }));
const primary = entries[0];
const primaryZh = zhFor(primary.section, primary.video);
const displayTitle = primaryZh?.title_zh || primary.video.title;
const shareDescription = primaryZh?.blurb_zh || humanWhyGood(primary.video.why_good) || 'fewgood. 上的一条长视频';
const shareImage = `https://i.ytimg.com/vi/${primary.video.id}/maxresdefault.jpg`;
---
<Layout title={`${displayTitle} · ${SITE_NAME}`} active={primary.section} description={shareDescription} ogTitle={displayTitle} ogDescription={shareDescription} ogImage={shareImage}>
{entries.map(({ section, video }) => <section class="detail" data-source={section} data-video-json={JSON.stringify(snapshot(video))} data-next-json={JSON.stringify(relatedFor(section, video))}><div class="player"><iframe id={`player-${section}`} src={`https://www.youtube-nocookie.com/embed/${video.id}?rel=0&playsinline=1&enablejsapi=1`} title={video.title} allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe></div><h1>{titleFor(section, video)}</h1>{section === 'picks' && video.community_classic && <p class="community-classic-row"><span class="community-classic-badge">社区经典</span></p>}{zhFor(section, video)?.title_zh && <p class="original-title">{video.title}</p>}<div class="owner-row"><div class="owner"><a class="owner-avatar" href={channelUrl(video)}>{channelFor(video) ? <ChannelAvatar channel={channelFor(video)} name={video.channel} /> : <ChannelAvatar name={video.channel} />}</a><div class="owner-info"><a class="owner-name" href={channelUrl(video)}>{video.channel}</a>{subscriberLabelFor(video) && <span class="subscriber-count">{subscriberLabelFor(video)}</span>}</div></div><button class="subscribe-btn" data-follow-channel data-channel={video.channel_id} data-channel-name={video.channel}>关注</button></div><p class="meta">{metaLine(section, video)} · <a class="yt-open" href={`https://www.youtube.com/watch?v=${video.id}`} target="_blank" rel="noopener noreferrer">在 YouTube 打开</a></p>{video.why_good && <p class="why-good-detail">{video.pick_source ? `${video.pick_source} · ` : ''}{video.why_good}</p>}<div class="actions"><button data-library-toggle="favorites" data-id={video.id}>☆ 收藏</button><button data-library-toggle="watchLater" data-id={video.id}>◷ 稍后再看</button><button class="share-btn" type="button" data-share>分享</button></div>{zhFor(section, video) && <div class="zh-detail">{zhFor(section, video).highlights?.length > 0 && <section><h2>看点</h2><ul>{zhFor(section, video).highlights.map(item => <li>{typeof item.start === 'number' ? <button class="seek" data-seek={item.start} data-video-id={video.id}>{timestamp(item.start)} · {item.text}</button> : item.text}</li>)}</ul></section>}{zhFor(section, video).comments_zh?.length > 0 && <section><h2>社区观点</h2>{zhFor(section, video).comments_zh.map(comment => <article class="comment"><p>{comment.text_zh}</p><small>{comment.original} · 👍 {comment.likes}</small></article>)}</section>}</div>}<section class="related"><h2>{section === 'picks' ? '其他精选' : '同类视频'}</h2><div class="related-grid">{(feeds[section]?.videos || []).filter(v => v.id !== video.id).slice(0, 6).map(v => <a href={videoUrl(section, v.id, base)}><img loading="lazy" src={`https://i.ytimg.com/vi/${v.id}/maxresdefault.jpg`} onerror={`this.onerror=null;this.src='https://i.ytimg.com/vi/${v.id}/mqdefault.jpg'`} alt=""/><span><b>{v.title}</b><small>{v.channel}</small></span></a>)}</div></section></section>)}
</Layout>
<script>
 import { KEYS, addHistory, has, toggleChannel, toggleFavorite, toggleVideo } from '../../scripts/library.js';
 import { showPrompt } from '../../scripts/prompts.js';
 import { track } from '../../scripts/analytics.js';
 const source = new URLSearchParams(location.search).get('from'); const fromTopicId = source?.startsWith('topic:') ? source.slice('topic:'.length) : null; const sections = [...document.querySelectorAll('[data-source]')]; const selected = sections.some(el => el.dataset.source === source) ? source : sections[0]?.dataset.source; sections.forEach(el => el.hidden = el.dataset.source !== selected);
 const labels = { favorites: ['☆ 收藏', '★ 已收藏'], watchLater: ['◷ 稍后再看', '◷ 已在稍后再看'] };
 const snapshotFor = button => JSON.parse(button.closest('[data-video-json]').dataset.videoJson);
 const paint = button => { const key = button.dataset.libraryToggle, id = button.dataset.id; button.textContent = labels[key][has(KEYS[key], id) ? 1 : 0]; };
 document.querySelectorAll('[data-library-toggle]').forEach(button => { paint(button); button.addEventListener('click', () => { const key = button.dataset.libraryToggle; const snapshot = snapshotFor(button); if (key === 'favorites') toggleFavorite(snapshot, fromTopicId ? { from_topic_id: fromTopicId } : {}); else toggleVideo(KEYS[key], snapshot); paint(button); }); });
 document.querySelectorAll('[data-share]').forEach(button => button.addEventListener('click', () => showPrompt('生成分享链接需要登录（10 秒，不用验证邮箱）。', { ttl: 8000 })));
 document.querySelectorAll('[data-follow-channel]').forEach(button => { if (!button.dataset.channel) { button.hidden = true; return; } const paintFollow = () => { const following = has(KEYS.following, button.dataset.channel); button.textContent = following ? '已关注' : '关注'; button.classList.toggle('is-following', following); }; paintFollow(); button.addEventListener('click', () => { const snap = snapshotFor(button); toggleChannel({ id: snap.channelId, title: snap.channel, thumbnail: snap.avatar }); paintFollow(); }); });
 const activeDetail = () => sections.find(el => el.dataset.source === selected) || sections[0];
 const esc = value => String(value ?? '').replace(/[&<>"']/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]));
 const players = new Map();
 const replacePlayer = detail => { const player = detail?.querySelector('.player'); if (!player || player.dataset.ended === '1') return; player.dataset.ended = '1'; const next = document.createElement('div'); next.className = 'next-videos'; const heading = document.createElement('h3'); heading.textContent = '接下来看这几条'; next.append(heading); const grid = document.createElement('div'); grid.className = 'next-grid'; const items = JSON.parse(detail.dataset.nextJson || '[]'); items.forEach(v => { const link = document.createElement('a'); link.href = v.url; link.innerHTML = `<img loading="lazy" src="${esc(v.thumb)}" alt=""><span><b>${esc(v.title)}</b><small>${esc(v.channel)}</small></span>`; grid.append(link); }); next.append(grid); player.replaceWith(next); players.delete(detail); track('player_ended', { video_id: detail?.dataset.source }); };
 window.__fewgoodPlayerEnded = () => replacePlayer(activeDetail());
 const loadPlayerApi = callback => { if (window.YT && window.YT.Player) { callback(); return; } if (window.__fewgoodApiReady) { window.__fewgoodApiReady.push(callback); return; } window.__fewgoodApiReady = [callback]; window.onYouTubeIframeAPIReady = () => { const queue = window.__fewgoodApiReady || []; window.__fewgoodApiReady = []; queue.forEach(fn => fn()); }; const tag = document.createElement('script'); tag.src = 'https://www.youtube.com/iframe_api'; document.head.append(tag); };
 const ensurePlayer = detail => { const frame = detail?.querySelector('.player iframe'); if (!frame || !frame.id || frame.dataset.attached === '1') return; frame.dataset.attached = '1'; loadPlayerApi(() => { if (!window.YT || !window.YT.Player) return; players.set(detail, new YT.Player(frame.id, { events: { onStateChange: event => { if (event.data === 0) replacePlayer(detail); } } })); }); };
 document.querySelectorAll('[data-seek]').forEach(button => button.addEventListener('click', () => { const detail = button.closest('.detail'); const seconds = Math.floor(Number(button.dataset.seek)); const player = players.get(detail); if (player && player.seekTo) { player.seekTo(seconds, true); player.playVideo(); } else { const frame = detail?.querySelector('.player iframe'); if (frame) frame.src = `https://www.youtube-nocookie.com/embed/${button.dataset.videoId}?start=${seconds}&autoplay=1&rel=0&playsinline=1&enablejsapi=1`; } track('zh_highlight_click', { video_id: button.dataset.videoId, t: seconds }); track('play_embed', { video_id: button.dataset.videoId }); }));
 ensurePlayer(activeDetail());
 if (sections[0]) addHistory(snapshotFor(sections[0].querySelector('[data-library-toggle]')));
</script>
<style>
.detail{max-width:1050px;margin:auto}.player{aspect-ratio:16/9;background:#000;border-radius:12px;overflow:hidden}.player iframe{border:0;width:100%;height:100%}h1{font-size:22px;margin:16px 0 4px}.community-classic-row{margin:0 0 6px}.original-title{margin:0 0 8px;color:#606060;font-size:14px;line-height:1.4}.owner-row{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin:0 0 8px}.owner{display:flex;align-items:center;gap:12px;min-width:0}.owner-avatar,.owner-name{color:#0f0f0f;text-decoration:none}.owner-avatar .channel-avatar{width:40px;height:40px;display:block}.owner-info{display:flex;flex-direction:column;gap:2px}.owner-name{font-size:16px;font-weight:500}.subscriber-count{font-size:13px;color:#606060}.subscribe-btn{height:36px;padding:0 16px;border:0;border-radius:18px;background:#0f0f0f;color:#fff;font-weight:500;cursor:pointer;white-space:nowrap}.subscribe-btn.is-following{background:#f2f2f2;color:#0f0f0f}.meta{color:#606060;font-size:14px;margin:0}.yt-open{color:#606060;text-decoration:none}.yt-open:hover{color:#065fd4}.why-good-detail{margin:8px 0 0;color:#065fd4;font-size:14px}.actions{display:flex;gap:10px;flex-wrap:wrap;margin:18px 0 30px}.actions button{display:inline-flex;align-items:center;justify-content:center;height:36px;border:0;border-radius:18px;background:#f2f2f2;padding:0 14px;line-height:1;font-weight:600;text-decoration:none;color:#0f0f0f;font-size:14px;cursor:pointer}.zh-detail{border-top:1px solid #e5e5e5;padding-top:18px;margin-bottom:28px}.zh-detail h2{font-size:18px;margin:0 0 10px}.zh-detail ul{padding-left:20px;margin:0 0 20px}.zh-detail li{margin:8px 0}.seek{border:0;background:none;padding:0;color:#065fd4;cursor:pointer;font:inherit;text-align:left}.comment{border-bottom:1px solid #eee;padding:10px 0}.comment p{margin:0 0 5px}.comment small{color:#606060}.next-videos{border-top:1px solid #e5e5e5;padding-top:20px;margin-bottom:24px}.next-videos h3{font-size:18px;margin:0 0 14px}.next-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.next-grid a{display:flex;gap:8px;text-decoration:none;color:inherit;font-size:13px}.next-grid img{width:120px;height:68px;object-fit:cover;border-radius:7px}.next-grid span{display:flex;flex-direction:column;gap:5px}.next-grid small{color:#606060}.related{border-top:1px solid #e5e5e5;padding-top:20px}.related h2{font-size:18px}.related-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.related-grid a{display:flex;gap:8px;text-decoration:none;color:inherit;font-size:13px}.related-grid img{width:120px;height:68px;object-fit:cover;border-radius:7px}.related-grid span{display:flex;flex-direction:column;gap:5px}.related-grid small{color:#606060}@media(max-width:700px){.related-grid,.next-grid{grid-template-columns:1fr}}
</style>
