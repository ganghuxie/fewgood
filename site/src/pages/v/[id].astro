---
import trending from '../../data/trending.json';
import ai from '../../data/ai.json';
import community from '../../data/videos.json';
import zhData from '../../data/zh.json';
import channelsData from '../../data/channels.json';
import { optionalFeed } from '../../lib/feeds.mjs';
import { videoUrl } from '../../lib/pagination.mjs';
import Layout from '../../components/Layout.astro';
import ChannelAvatar from '../../components/ChannelAvatar.astro';
import { SITE_NAME } from '../../lib/brand.mjs';
const feeds = { trending, ai, podcast: optionalFeed('podcast'), music: optionalFeed('music'), community };
export function getStaticPaths() { const sources = { trending, ai, podcast: optionalFeed('podcast'), music: optionalFeed('music'), community }; const byId = new Map(); for (const [section, feed] of Object.entries(sources)) for (const video of feed.videos) byId.set(video.id, [...(byId.get(video.id) || []), { section, video }]); return [...byId].map(([id, entries]) => ({ params: { id }, props: { entries } })); }
const { entries } = Astro.props; const base = import.meta.env.BASE_URL;
const duration = n => `${Math.floor(n / 60)}:${String(n % 60).padStart(2, '0')}`;
const snapshot = video => ({ id: video.id, title: video.title, thumbnail: video.thumb || `https://i.ytimg.com/vi/${video.id}/hqdefault.jpg`, channelId: video.channel_id, channel: video.channel, avatar: video.channel_id ? (channelsData.channels || []).find(c => c.id === video.channel_id)?.thumbnail || '' : '', duration: video.duration_seconds, views: video.view_count, published_at: video.published_at });
const compact = n => new Intl.NumberFormat('zh-CN', { notation: 'compact', maximumFractionDigits: 1 }).format(n || 0);
const channelFor = video => (channelsData.channels || []).find(channel => channel.id === video.channel_id);
const subscriberLabelFor = video => { const count = channelFor(video)?.subscriber_count; return count !== null && count !== undefined && count !== '' && count !== 'hidden' && Number(count) > 0 ? `${compact(Number(count))}位订阅者` : ''; };
const channelUrl = video => video.channel_id ? `${base.replace(/\/$/, '')}/channel/${video.channel_id}/` : undefined;
const zhFor = (section, id) => section === 'community' ? (zhData.videos || {})[id] : null;
const timestamp = seconds => `${Math.floor(seconds / 60)}:${String(Math.floor(seconds % 60)).padStart(2, '0')}`;
---
<Layout title={`${entries[0].video.title} · ${SITE_NAME}`} active={entries[0].section} description="YouTuber 视频播放页">
{entries.map(({ section, video }) => <section class="detail" data-source={section} data-video-json={JSON.stringify(snapshot(video))}><div class="player"><iframe src={`https://www.youtube-nocookie.com/embed/${video.id}`} title={video.title} allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe></div><h1>{video.title}</h1><div class="owner-row"><div class="owner"><a class="owner-avatar" href={channelUrl(video)}>{channelFor(video) ? <ChannelAvatar channel={channelFor(video)} name={video.channel} /> : <ChannelAvatar name={video.channel} />}</a><div class="owner-info"><a class="owner-name" href={channelUrl(video)}>{video.channel}</a>{subscriberLabelFor(video) && <span class="subscriber-count">{subscriberLabelFor(video)}</span>}</div></div><button class="subscribe-btn" data-follow-channel data-channel={video.channel_id} data-channel-name={video.channel}>加入</button></div><p class="meta">{section === 'community' ? `${video.recommenders} 人推荐 · ${video.months} 个月` : `${compact(video.view_count)} 次观看`} · {duration(video.duration_seconds)}</p><div class="actions"><button data-library-toggle="favorites" data-id={video.id}>☆ 收藏</button><button data-library-toggle="watchLater" data-id={video.id}>◷ 稍后再看</button><a href={`https://www.youtube.com/watch?v=${video.id}`} target="_blank" rel="noopener noreferrer">进入 YouTube 观看 ↗</a></div>{zhFor(section, video.id) && <div class="zh-detail">{zhFor(section, video.id).highlights?.length > 0 && <section><h2>看点</h2><ul>{zhFor(section, video.id).highlights.map(item => <li>{typeof item.start === 'number' ? <button class="seek" data-seek={item.start} data-video-id={video.id}>{timestamp(item.start)} · {item.text}</button> : item.text}</li>)}</ul></section>}{zhFor(section, video.id).comments_zh?.length > 0 && <section><h2>精选评论</h2>{zhFor(section, video.id).comments_zh.map(comment => <article class="comment"><p>{comment.text_zh}</p><small>{comment.original} · 👍 {comment.likes}</small></article>)}</section>}</div>}<section class="related"><h2>同类视频</h2><div class="related-grid">{feeds[section].videos.filter(v => v.id !== video.id).slice(0, 6).map(v => <a href={videoUrl(section, v.id, base)}><img loading="lazy" src={`https://i.ytimg.com/vi/${v.id}/mqdefault.jpg`} alt=""/><span><b>{v.title}</b><small>{v.channel}</small></span></a>)}</div></section></section>)}
</Layout>
<script>
 import { KEYS, addHistory, has, toggleChannel, toggleVideo } from '../../scripts/library.js';
 const source = new URLSearchParams(location.search).get('from'); const sections = [...document.querySelectorAll('[data-source]')]; const selected = sections.some(el => el.dataset.source === source) ? source : sections[0]?.dataset.source; sections.forEach(el => el.hidden = el.dataset.source !== selected);
 const labels = { favorites: ['☆ 收藏', '★ 已收藏'], watchLater: ['◷ 稍后再看', '◷ 已在稍后再看'] };
 const snapshotFor = button => JSON.parse(button.closest('[data-video-json]').dataset.videoJson);
 const paint = button => { const key = button.dataset.libraryToggle, id = button.dataset.id; button.textContent = labels[key][has(KEYS[key], id) ? 1 : 0]; };
 document.querySelectorAll('[data-library-toggle]').forEach(button => { paint(button); button.addEventListener('click', () => { toggleVideo(KEYS[button.dataset.libraryToggle], snapshotFor(button)); paint(button); }); });
 document.querySelectorAll('[data-follow-channel]').forEach(button => { if (!button.dataset.channel) { button.hidden = true; return; } const paintFollow = () => { const following = has(KEYS.following, button.dataset.channel); button.textContent = following ? '已加入' : '加入'; button.classList.toggle('is-following', following); }; paintFollow(); button.addEventListener('click', () => { const snap = snapshotFor(button); toggleChannel({ id: snap.channelId, title: snap.channel, thumbnail: snap.avatar }); paintFollow(); }); });
 document.querySelectorAll('[data-seek]').forEach(button => button.addEventListener('click', () => { const detail = button.closest('.detail'); const frame = detail?.querySelector('iframe'); if (frame) frame.src = `https://www.youtube-nocookie.com/embed/${button.dataset.videoId}?start=${Math.floor(Number(button.dataset.seek))}&autoplay=1`; }));
 if (sections[0]) addHistory(snapshotFor(sections[0].querySelector('[data-library-toggle]')));
</script>
<style>
.detail{max-width:1050px;margin:auto}.player{aspect-ratio:16/9;background:#000;border-radius:12px;overflow:hidden}.player iframe{border:0;width:100%;height:100%}h1{font-size:22px;margin:16px 0 7px}.owner-row{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin:0 0 8px}.owner{display:flex;align-items:center;gap:12px;min-width:0}.owner-avatar,.owner-name{color:#0f0f0f;text-decoration:none}.owner-avatar .channel-avatar{width:40px;height:40px;display:block}.owner-info{display:flex;flex-direction:column;gap:2px}.owner-name{font-size:16px;font-weight:500}.subscriber-count{font-size:13px;color:#606060}.subscribe-btn{height:36px;padding:0 16px;border:0;border-radius:18px;background:#0f0f0f;color:#fff;font-weight:500;cursor:pointer;white-space:nowrap}.subscribe-btn.is-following{background:#f2f2f2;color:#0f0f0f}.meta{color:#606060;font-size:14px;margin:0}.actions{display:flex;gap:10px;flex-wrap:wrap;margin:18px 0 30px}.actions button,.actions a{border:0;border-radius:18px;background:#f2f2f2;padding:9px 13px;font-weight:600;text-decoration:none;color:#0f0f0f;font-size:14px;cursor:pointer}.actions a{background:#0f0f0f;color:#fff}.zh-detail{border-top:1px solid #e5e5e5;padding-top:18px;margin-bottom:28px}.zh-detail h2{font-size:18px;margin:0 0 10px}.zh-detail ul{padding-left:20px;margin:0 0 20px}.zh-detail li{margin:8px 0}.seek{border:0;background:none;padding:0;color:#065fd4;cursor:pointer;font:inherit;text-align:left}.comment{border-bottom:1px solid #eee;padding:10px 0}.comment p{margin:0 0 5px}.comment small{color:#606060}.related{border-top:1px solid #e5e5e5;padding-top:20px}.related h2{font-size:18px}.related-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.related-grid a{display:flex;gap:8px;text-decoration:none;color:inherit;font-size:13px}.related-grid img{width:120px;height:68px;object-fit:cover;border-radius:7px}.related-grid span{display:flex;flex-direction:column;gap:5px}.related-grid small{color:#606060}@media(max-width:700px){.related-grid{grid-template-columns:1fr}}
</style>
