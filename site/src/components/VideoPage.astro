---
import { pageUrl, videoUrl, PAGE_SIZE } from '../lib/pagination.mjs';
import Layout from './Layout.astro';
import ChannelAvatar from './ChannelAvatar.astro';
import channelData from '../data/channels.json';
import zhData from '../data/zh.json';
import { SITE_NAME, SECTION_LABELS, MODE_LABELS, COMMUNITY_SUBSOURCES } from '../lib/brand.mjs';
const { videos, total, page, section, sort, feed, allVideos = videos } = Astro.props;
const channels = Object.fromEntries((channelData.channels || []).map(channel => [channel.id, channel]));
const base = import.meta.env.BASE_URL;
const community = section === 'community';
const label = SECTION_LABELS[section] || SECTION_LABELS.community;
const duration = n => `${Math.floor(n / 60)}:${String(n % 60).padStart(2, '0')}`;
const compact = n => new Intl.NumberFormat('zh-CN', { notation: 'compact', maximumFractionDigits: 1 }).format(n || 0);
const ago = value => { const days = Math.max(0, Math.floor((Date.now() - new Date(value).getTime()) / 86400000)); return days < 1 ? '今天' : days < 30 ? `${days}天前` : days < 365 ? `${Math.floor(days / 30)}个月前` : `${Math.floor(days / 365)}年前`; };
const zhFor = id => community ? (zhData.videos || {})[id] : null;
const feedData = allVideos.map(v => ({ ...v, channel_thumbnail: channels[v.channel_id]?.thumbnail || null, zh: zhFor(v.id) || null }));
---
<Layout title={`${label} · ${SITE_NAME}`} active={section}>
  <section class="mode-switch" data-alpha-myspace hidden aria-label="内容模式"><button type="button" data-mode="explore" aria-pressed="true">{MODE_LABELS.explore}</button><button type="button" data-mode="myspace" aria-pressed="false">{MODE_LABELS.myspace}</button></section>
  <div data-explore-view>
  <section class="page-heading"><div><h1>{label}</h1><p>{community ? '来自 Hacker News 社区长期推荐的视频' : section === 'ai' ? '值得一看的 AI 视频' : section === 'podcast' ? '正在被观看的播客' : section === 'music' ? '正在被观看的音乐' : '发现正在被观看的好视频'}</p></div><span>{total} 个视频</span></section>
  {community && <section class="sort-row"><span>{feed.summary.criteria.recommendation.min_recommenders}+ 人 · {feed.summary.criteria.recommendation.min_months}+ 个月 · 上传 12 年内（经典演讲豁免）</span><nav><a href={pageUrl('community', 1, base, 'people')} aria-current={sort === 'people' ? 'page' : undefined}>{COMMUNITY_SUBSOURCES.people}</a><a href={pageUrl('community', 1, base, 'newest')} aria-current={sort === 'newest' ? 'page' : undefined}>{COMMUNITY_SUBSOURCES.newest}</a></nav></section>}
  <section class="video-grid" data-feed-grid data-section={section} data-sort={sort} data-page-size={PAGE_SIZE}>{videos.map(v => <a class="video-card" href={videoUrl(section, v.id, base)}><div class="thumbnail"><img loading="lazy" src={`https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`} alt=""/><span class="duration">{duration(v.duration_seconds)}</span></div><div class="video-info"><ChannelAvatar channel={channels[v.channel_id]} name={v.channel} /><div><h2 class="video-title">{v.title}</h2>{zhFor(v.id)?.title_zh && <p class="zh-title">{zhFor(v.id).title_zh}</p>}<p class="video-meta">{v.channel}</p><p class="video-meta">{community ? `${v.recommenders} 人推荐 · ${v.months} 个月` : `${compact(v.view_count)} 次观看 · ${ago(v.published_at)}`}</p>{zhFor(v.id)?.blurb_zh && <p class="zh-blurb">{zhFor(v.id).blurb_zh}</p>}</div></div></a>)}</section>
  <div class="infinite-sentinel" data-infinite-sentinel aria-hidden="true"></div><div class="infinite-spinner" data-infinite-spinner hidden aria-live="polite">加载中…</div></div>
  <section data-myspace-view hidden></section>
</Layout>
<script type="application/json" id="feed-data" set:html={JSON.stringify(feedData).replace(/</g, '\\u003c')}></script>
<script>import '../scripts/myspace.js';</script>
<script>
  const grid = document.querySelector('[data-feed-grid]');
  const sentinel = document.querySelector('[data-infinite-sentinel]');
  const spinner = document.querySelector('[data-infinite-spinner]');
  const data = JSON.parse(document.querySelector('#feed-data').textContent);
  const base = document.querySelector('main')?.dataset.base || '';
  const pageSize = Number(grid.dataset.pageSize);
  let cursor = grid.children.length;
  let loading = false;
  const esc = value => String(value ?? '').replace(/[&<>"']/g, ch => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));
  const avatar = (video) => video.channel_thumbnail
    ? `<img class="channel-avatar" src="${esc(video.channel_thumbnail)}" alt="">`
    : (() => { const name = video.channel || '频道'; const letter = [...name.trim()][0] || '频'; let hash = 0; for (const ch of name) hash = (hash * 31 + ch.codePointAt(0)) >>> 0; const color = ['#d14b4b','#b06b2f','#8a6d1d','#4f8a3d','#357a8a','#5367a6','#7a5795'][hash % 7]; return `<span class="channel-avatar channel-avatar-letter" style="background-color:${color}" aria-hidden="true">${esc(letter)}</span>`; })();
  const ago = value => { const days = Math.max(0, Math.floor((Date.now() - new Date(value).getTime()) / 86400000)); return days < 1 ? '今天' : days < 30 ? `${days}天前` : days < 365 ? `${Math.floor(days / 30)}个月前` : `${Math.floor(days / 365)}年前`; };
  const compact = value => new Intl.NumberFormat('zh-CN', { notation: 'compact', maximumFractionDigits: 1 }).format(value || 0);
  const card = video => { const zh = video.zh || {}; const community = grid.dataset.section === 'community'; const link = document.createElement('a'); link.className = 'video-card'; link.href = `${base}/v/${video.id}/?from=${grid.dataset.section}`;
    link.innerHTML = `<div class="thumbnail"><img loading="lazy" src="https://i.ytimg.com/vi/${video.id}/hqdefault.jpg" alt=""><span class="duration">${Math.floor(video.duration_seconds / 60)}:${String(video.duration_seconds % 60).padStart(2, '0')}</span></div><div class="video-info">${avatar(video)}<div><h2 class="video-title">${esc(video.title)}</h2>${zh.title_zh ? `<p class="zh-title">${esc(zh.title_zh)}</p>` : ''}<p class="video-meta">${esc(video.channel)}</p><p class="video-meta">${community ? `${video.recommenders} 人推荐 · ${video.months} 个月` : `${compact(video.view_count)} 次观看 · ${ago(video.published_at)}`}</p>${zh.blurb_zh ? `<p class="zh-blurb">${esc(zh.blurb_zh)}</p>` : ''}</div></div>`; return link; };
  const load = async () => { if (loading || cursor >= data.length) return; loading = true; spinner.hidden = false; await new Promise(requestAnimationFrame); data.slice(cursor, cursor + pageSize).forEach(video => grid.append(card(video))); cursor += pageSize; loading = false; spinner.hidden = true; if (cursor >= data.length) observer.disconnect(); };
  const observer = new IntersectionObserver(entries => { if (entries[0].isIntersecting) load(); }, { rootMargin: '500px' });
  if (cursor < data.length) observer.observe(sentinel); else sentinel.remove();
</script>
<style>
.mode-switch{display:flex;gap:3px;padding:3px;border-radius:10px;background:#f2f2f2}.mode-switch button{border:0;border-radius:7px;padding:7px 12px;background:transparent;font:600 14px inherit;cursor:pointer;color:#606060;white-space:nowrap}.mode-switch button[aria-pressed="true"]{background:#fff;color:#0f0f0f;box-shadow:0 1px 3px #0000001c}.page-heading{display:flex;justify-content:space-between;align-items:end;margin:6px 0 26px}.page-heading h1{font-size:28px;margin:0 0 6px}.page-heading p,.page-heading span{margin:0;color:#606060;font-size:14px}.sort-row{padding:12px 0;margin:-8px 0 22px;border-block:1px solid #e5e5e5;display:flex;justify-content:space-between;font-size:13px;color:#606060}.sort-row nav{display:flex;gap:16px}.sort-row a{text-decoration:none}.sort-row a[aria-current="page"]{color:#0f0f0f;font-weight:700}@media(max-width:600px){.sort-row{display:block}.sort-row nav{margin-top:10px}}
:global(.site-header .mode-switch){margin:0 24px 8px;width:max-content}:global(.site-header.alpha-video-header){max-width:100%;overflow-x:hidden}:global(.site-header.alpha-video-header .mode-switch){max-width:calc(100% - 48px);overflow-x:auto}:global(.site-header.alpha-video-header .chipbar){max-width:100%;overflow-x:auto;overscroll-behavior-inline:contain}:global(.site-header.alpha-video-header .chipbar nav){min-width:max-content}:global([data-myspace-view]){min-width:0;max-width:100%;overflow-x:hidden}:global(.myspace-heading){display:flex;justify-content:space-between;gap:16px;align-items:center;flex-wrap:wrap;min-width:0;max-width:100%;margin:4px 0 18px}:global(.myspace-heading>div){min-width:0}:global(.myspace-heading h1),:global(.myspace-column h2),:global(.myspace-empty h2){margin:0 0 6px}:global(.myspace-heading h1){font-size:28px}:global(.myspace-heading p),:global(.myspace-loading),:global(.myspace-empty p){margin:0;color:#606060;font-size:14px}:global(.myspace-manage){flex:none;border:1px solid #ddd;border-radius:999px;background:#fff;padding:8px 12px;color:#0f0f0f;cursor:pointer;font:600 14px inherit;white-space:nowrap}:global(.myspace-manage:hover){background:#f2f2f2}:global(.myspace-columns){display:grid;gap:34px}:global(.myspace-empty){border:1px solid #e5e5e5;border-radius:14px;padding:20px;max-width:900px}:global(.myspace-empty .topic-chip-groups){margin-bottom:16px}:global(.myspace-column h2){font-size:20px}:global(.myspace-column){min-width:0;scroll-margin-top:18px}:global(.myspace-editor){width:min(680px,calc(100vw - 28px));max-height:calc(100vh - 28px);border:0;border-radius:14px;padding:0;box-shadow:0 12px 40px #0004}:global(.myspace-editor::backdrop){background:#0008}:global(.myspace-editor-inner){padding:18px;overflow:auto;max-height:calc(100vh - 64px)}:global(.myspace-editor-title){display:flex;align-items:center;justify-content:space-between;margin:0 0 12px}:global(.myspace-editor-title h2){margin:0;font-size:18px}:global(.myspace-editor-close){border:1px solid #ddd;border-radius:7px;background:#fff;padding:5px 9px;font:14px inherit;cursor:pointer;font-size:18px;line-height:1}:global(.myspace-editor-close:hover){background:#f2f2f2}:global(.myspace-editor-note){margin:0 0 9px;color:#606060;font-size:13px}@media(max-width:600px){:global(.site-header.alpha-video-header){padding-bottom:0}:global(.site-header.alpha-video-header .header-row){margin-bottom:48px}:global(.site-header.alpha-video-header .mode-switch){margin:0 8px 6px;max-width:calc(100% - 16px)}:global(.site-header.alpha-video-header .chipbar){padding:0 8px}:global(.site-header.alpha-video-header .chipbar nav){gap:8px}:global(.site-header.alpha-video-header .chipbar a),:global(.site-header.alpha-video-header .chipbar button){padding:0 11px}:global(.myspace-heading){align-items:flex-start}:global(.myspace-heading h1){font-size:24px}:global(.myspace-manage){padding:7px 10px;font-size:13px}}
:global(.topic-area){border-bottom:1px solid #e5e5e5;padding:0 0 28px;margin:0 0 30px}:global(.topic-heading){display:flex;justify-content:space-between;gap:12px;align-items:end}:global(.topic-heading h2){font-size:20px;margin:0 0 6px}:global(.topic-heading p),:global(.topic-heading span),:global(.topic-card p),:global(.topic-message){margin:0;color:#606060;font-size:13px;line-height:1.45}:global(.topic-chip-groups){display:grid;gap:14px;margin:18px 0}:global(.topic-chip-group h3){font-size:14px;margin:0 0 7px}:global(.topic-chips){display:flex;flex-wrap:wrap;gap:8px}:global(.topic-chip){border:1px solid #ddd;border-radius:999px;background:#fff;padding:7px 11px;color:#0f0f0f;font:14px inherit;cursor:pointer}:global(.topic-chip:hover){background:#f2f2f2}:global(.topic-chip.selected){background:#0f0f0f;border-color:#0f0f0f;color:#fff}:global(.topic-chip:disabled){opacity:.45;cursor:not-allowed}:global(.topic-create-link){border:0;background:none;color:#606060;padding:0;font:13px inherit;text-decoration:underline;cursor:pointer}:global(.topic-create){display:flex;align-items:center;gap:8px;margin:12px 0}:global(.topic-create input){min-width:0;width:240px;height:36px;border:1px solid #ccc;border-radius:8px;padding:0 10px;font:14px inherit}:global(.topic-create button),:global(.topic-login),:global(.topic-actions button),:global(.topic-actions a){border:1px solid #ddd;border-radius:8px;background:#fff;padding:8px 10px;color:#0f0f0f;text-decoration:none;font:13px inherit;cursor:pointer}:global(.topic-create button),:global(.topic-login){background:#0f0f0f;color:#fff;border-color:#0f0f0f}:global(.topic-list){display:grid;gap:8px;margin-top:14px}:global(.topic-card){display:flex;justify-content:space-between;gap:12px;align-items:center;border:1px solid #e5e5e5;border-radius:10px;padding:12px}:global(.topic-card h2){font-size:16px;margin:0 0 4px}:global(.topic-card a){color:#0f0f0f}:global(.topic-actions){display:flex;flex-wrap:wrap;justify-content:flex-end;gap:6px}:global(.topic-message){min-height:18px;margin-top:8px}@media(max-width:600px){:global(.topic-heading){align-items:flex-start;flex-direction:column}:global(.topic-card){align-items:flex-start;flex-direction:column}:global(.topic-actions){justify-content:flex-start}:global(.topic-create){flex-wrap:wrap}:global(.topic-create input){width:100%}}
.zh-title,.zh-blurb{margin:3px 0;color:#606060;font-size:13px;line-height:1.35}.zh-blurb{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.infinite-sentinel{height:1px}.infinite-spinner{text-align:center;color:#606060;padding:22px}
</style>
