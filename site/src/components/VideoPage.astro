---
import data from '../data/videos.json';
import { pageUrl, pageNumbers } from '../lib/pagination.mjs';
const { videos, total, page, pages, sort } = Astro.props;
const start = total ? (page - 1) * 50 + 1 : 0;
const end = Math.min(page * 50, total);
const date = (ts: number) => new Date(ts*1000).toISOString().slice(0,10);
const duration = (seconds: number) => `${Math.floor(seconds/60)}:${String(seconds%60).padStart(2,'0')}`;
const criteria = data.summary.criteria.recommendation;
---
<!doctype html>
<html lang="en">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content="YouTube videos repeatedly linked by independent Hacker News users over time."/><title>Long Echo · HN × YouTube</title></head>
<body>
<main>
<header><p class="eyebrow">HN × YOUTUBE / PHASE 01</p><h1>Long Echo<span>Videos that keep coming back.</span></h1><p class="intro">Discover videos shared by independent people across months and years. A community memory, beyond view counts.</p></header>
<section class="bar"><div><strong>{total}</strong> selected <span>· {criteria.min_recommenders}+ people · {criteria.min_months}+ months · {criteria.min_span_days}+ days</span></div><nav aria-label="Sort"><span>Sort: </span><a href="/" aria-current={sort === 'people' ? 'page' : undefined}>Most recommenders</a> · <a href="/newest/" aria-current={sort === 'newest' ? 'page' : undefined}>Newest selected</a></nav></section>
<p class="range">Showing {start}–{end} of {total}</p>
<p class="note">HN links are recommendation signals, not verified endorsements. Sentiment screening is planned for phase 2. Metadata is cached; availability may change.</p>
{videos.length === 0 && <section class="empty"><h2>No videos meet all gates yet.</h2><p>Run the crawl and metadata pipeline to populate this collection. Strict thresholds remain unchanged.</p><p>{data.summary.recommendation_candidates} candidates pass the recommendation thresholds.</p></section>}
<section id="videos" class="grid">
{videos.map(v => <article data-people={v.recommenders} data-selected={v.selected_at} data-id={v.id}>
<a class="cover" href={`https://www.youtube.com/watch?v=${v.id}`} target="_blank" rel="noopener noreferrer"><img loading="lazy" src={`https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`} alt=""/><span>{duration(v.duration_seconds)}</span></a>
<div class="content"><p class="channel">{v.channel}</p><h2><a href={`https://www.youtube.com/watch?v=${v.id}`}>{v.title}</a></h2><p class="metric">{v.recommenders} people <span>· {v.months} months</span></p><p class="dates">{date(v.first)} → {date(v.last)}</p><div class="quotes">{v.quotes.map(q => <blockquote><p>{q.text}</p><cite><a href={q.url}>{q.author} ↗ HN</a></cite></blockquote>)}</div></div>
</article>)}
</section>
{pages > 1 && <nav class="pagination" aria-label="Pagination">
{page > 1 && <a rel="prev" href={pageUrl(sort, page - 1)}>← Previous</a>}
{pageNumbers(page, pages).map(n => n === null ? <span>…</span> : <a href={pageUrl(sort, n)} aria-current={n === page ? 'page' : undefined}>{n}</a>)}
{page < pages && <a rel="next" href={pageUrl(sort, page + 1)}>Next →</a>}
</nav>}
<footer>Long Echo / Hacker News archive · No ranking by YouTube views or likes.</footer>
</main>

<style is:global>
.pagination{display:flex;flex-wrap:wrap;gap:12px;justify-content:center;margin-top:32px}.pagination a{padding:8px 12px;border:1px solid #cad1c8;border-radius:5px}[aria-current="page"]{font-weight:700;text-decoration:underline}:root{font-family:system-ui,sans-serif;color:#202d29;background:#f4f3ed}*{box-sizing:border-box}body{margin:0}main{max-width:1240px;margin:auto;padding:48px 28px}header{padding:24px 0 46px;max-width:780px}.eyebrow{font-size:12px;letter-spacing:3px;color:#446c5c;font-weight:700}h1{font-size:64px;letter-spacing:-3px;margin:24px 0}h1 span{display:block;font-size:32px;letter-spacing:-1px;font-weight:400;margin-top:12px}.intro{font-size:18px;line-height:1.7;color:#606b65}.bar{border-block:1px solid #cad1c8;display:flex;gap:20px;justify-content:space-between;align-items:center;padding:22px 0}.bar strong{font-size:28px}.bar span,.note,.dates{color:#68736c;font-size:13px}select{padding:10px;border:1px solid #b9c5bb;background:transparent;border-radius:5px;color:inherit}.note{line-height:1.6;margin:20px 0 30px}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}article{background:#fff;border:1px solid #dee2d9;border-radius:10px;overflow:hidden}.cover{display:block;aspect-ratio:16/9;position:relative;background:#dce3db}.cover img{width:100%;height:100%;object-fit:cover}.cover span{position:absolute;right:12px;bottom:12px;color:white;background:#18231edb;padding:4px 7px;border-radius:4px;font-size:12px}.content{padding:22px}.channel{color:#657c6d;font-size:12px;text-transform:uppercase;letter-spacing:1px}h2{font-size:20px;line-height:1.4}a{color:inherit;text-decoration:none}a:hover{text-decoration:underline}.metric{font-weight:700;color:#2e634b}.metric span{font-weight:400}.quotes{border-top:1px solid #e5e9e1;margin-top:22px}blockquote{margin:16px 0;font-size:13px;line-height:1.65;overflow-wrap:anywhere}blockquote p{margin-bottom:6px}cite{font-style:normal;font-size:11px;color:#687c6c}.empty{padding:70px 24px;text-align:center;border:1px dashed #b9c5bb;border-radius:10px}footer{margin-top:60px;font-size:12px;color:#68736c}@media(max-width:950px){.grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:620px){main{padding:24px 18px}.grid{grid-template-columns:1fr}h1{font-size:48px}h1 span{font-size:25px}.bar{align-items:flex-start;flex-direction:column}.bar span{display:block;margin-top:8px}}
</style>
</body></html>
