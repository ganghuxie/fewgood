---
import { pageUrl, pageNumbers, videoUrl } from '../lib/pagination.mjs';
import Layout from './Layout.astro';
import { SITE_NAME } from '../lib/brand.mjs';
const { videos, total, page, pages, section, sort, feed } = Astro.props;
const base = import.meta.env.BASE_URL;
const community = section === 'community';
const label = section === 'trending' ? '全部' : section === 'ai' ? 'AI前沿' : section === 'podcast' ? '播客' : section === 'music' ? '音乐' : '社区好评';
const duration = n => `${Math.floor(n / 60)}:${String(n % 60).padStart(2, '0')}`;
const compact = n => new Intl.NumberFormat('zh-CN', { notation: 'compact', maximumFractionDigits: 1 }).format(n || 0);
const ago = value => { const days = Math.max(0, Math.floor((Date.now() - new Date(value).getTime()) / 86400000)); return days < 1 ? '今天' : days < 30 ? `${days}天前` : days < 365 ? `${Math.floor(days / 30)}个月前` : `${Math.floor(days / 365)}年前`; };
---
<Layout title={`${label} · ${SITE_NAME}`} active={section}>
  <section class="page-heading"><div><h1>{label}</h1><p>{community ? '来自社区长期推荐的视频' : section === 'ai' ? '值得一看的 AI 视频' : section === 'podcast' ? '正在被观看的播客' : section === 'music' ? '正在被观看的音乐' : '发现正在被观看的好视频'}</p></div><span>{total} 个视频</span></section>
  {community && <section class="sort-row"><span>{feed.summary.criteria.recommendation.min_recommenders}+ 人 · {feed.summary.criteria.recommendation.min_months}+ 个月</span><nav><a href={pageUrl('community', 1, base, 'people')} aria-current={sort === 'people' ? 'page' : undefined}>最多推荐</a><a href={pageUrl('community', 1, base, 'newest')} aria-current={sort === 'newest' ? 'page' : undefined}>最新入选</a></nav></section>}
  <section class="video-grid">{videos.map(v => <a class="video-card" href={videoUrl(section, v.id, base)}><div class="thumbnail"><img loading="lazy" src={`https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`} alt=""/><span class="duration">{duration(v.duration_seconds)}</span></div><div class="video-info"><span class="channel-avatar" aria-hidden="true"></span><div><h2 class="video-title">{v.title}</h2><p class="video-meta">{v.channel}</p><p class="video-meta">{community ? `${v.recommenders} 人推荐 · ${v.months} 个月` : `${compact(v.view_count)} 次观看 · ${ago(v.published_at)}`}</p></div></div></a>)}</section>
  {pages > 1 && <nav class="pagination" aria-label="分页">{page > 1 && <a rel="prev" href={pageUrl(section, page - 1, base, sort)}>上一页</a>}{pageNumbers(page, pages).map(n => n === null ? <span>…</span> : <a href={pageUrl(section, n, base, sort)} aria-current={n === page ? 'page' : undefined}>{n}</a>)}{page < pages && <a rel="next" href={pageUrl(section, page + 1, base, sort)}>下一页</a>}</nav>}
</Layout>
<style>
.page-heading{display:flex;justify-content:space-between;align-items:end;margin:6px 0 26px}.page-heading h1{font-size:28px;margin:0 0 6px}.page-heading p,.page-heading span{margin:0;color:#606060;font-size:14px}.sort-row{padding:12px 0;margin:-8px 0 22px;border-block:1px solid #e5e5e5;display:flex;justify-content:space-between;font-size:13px;color:#606060}.sort-row nav{display:flex;gap:16px}.sort-row a{text-decoration:none}.sort-row a[aria-current="page"]{color:#0f0f0f;font-weight:700}@media(max-width:600px){.sort-row{display:block}.sort-row nav{margin-top:10px}}
</style>
