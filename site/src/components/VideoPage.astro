---
import { pageUrl, videoUrl, PAGE_SIZE } from '../lib/pagination.mjs';
import { humanizeRecommendSpan, thumbFor } from '../lib/format.mjs';
import Layout from './Layout.astro';
import ChannelAvatar from './ChannelAvatar.astro';
import channelData from '../data/channels.json';
import zhData from '../data/zh.json';
import topicData from '../data/topics.json';
import topicLookup from '../data/topic_lookup.json';
import { SITE_NAME, SECTION_LABELS, MODE_LABELS, COMMUNITY_SUBSOURCES } from '../lib/brand.mjs';
import { topicSubscribeLabel, topicSubscribeTitle } from '../lib/topic-labels.mjs';
const { videos, total, page, section, sort, feed, allVideos = videos } = Astro.props;
const channels = Object.fromEntries((channelData.channels || []).map(channel => [channel.id, channel]));
const base = import.meta.env.BASE_URL;
const community = section === 'community';
const picks = section === 'picks';
const label = SECTION_LABELS[section] || SECTION_LABELS.community;
const duration = n => `${Math.floor(n / 60)}:${String(n % 60).padStart(2, '0')}`;
const compact = n => new Intl.NumberFormat('zh-CN', { notation: 'compact', maximumFractionDigits: 1 }).format(n || 0);
const ago = value => { const days = Math.max(0, Math.floor((Date.now() - new Date(value).getTime()) / 86400000)); return days < 1 ? '今天' : days < 30 ? `${days}天前` : days < 365 ? `${Math.floor(days / 30)}个月前` : `${Math.floor(days / 365)}年前`; };
const zhFor = (video) => (zhData.videos || {})[video.id] || null;
const isCommunityVideo = video => community || (picks && video.source === 'community');
const recommendSpan = video => humanizeRecommendSpan(video.span_days);
const lastUpdated = value => { if (!value) return ''; const nowParts = new Date(Date.now()).toLocaleString('en-CA', { timeZone: 'Asia/Shanghai', year: 'numeric', month: '2-digit', day: '2-digit' }); const parts = new Date(value).toLocaleString('en-CA', { timeZone: 'Asia/Shanghai', year: 'numeric', month: '2-digit', day: '2-digit' }); const hm = new Date(value).toLocaleTimeString('zh-CN', { timeZone: 'Asia/Shanghai', hour: '2-digit', minute: '2-digit', hour12: false }); if (parts === nowParts) return `最后更新：今天 ${hm}`; const [year, month, day] = parts.split('-'); return `最后更新：${Number(month)}月${Number(day)}日 ${hm}`; };
const subtitle = picks ? '每天从社区与 AI 前沿里挑几条值得看的好视频' : community ? '来自 Hacker News 社区长期推荐的视频' : section === 'ai' ? '值得一看的 AI 视频' : section === 'podcast' ? '正在被观看的播客' : section === 'music' ? '正在被观看的音乐' : '发现正在被观看的好视频';
const topicById = Object.fromEntries((topicData.topics || []).map(topic => [topic.id, topic]));
const aiTopicName = topicById.ai?.name_zh || null;
const inAiSection = v => section === 'ai' || (picks && v.source === 'ai');
const enrich = v => { const knownTopicId = v.topic_id || topicLookup[v.id] || null; const topicId = knownTopicId || (inAiSection(v) && aiTopicName ? 'ai' : null); return { ...v, channel_thumbnail: channels[v.channel_id]?.thumbnail || null, zh: zhFor(v), topic_id: topicId, topic_name: topicId ? topicById[topicId]?.name_zh || null : null }; };
const feedData = allVideos.map(enrich);
const pageVideos = videos.map(enrich);
---
<Layout title={`${label} · ${SITE_NAME}`} active={section}>
  <section class="mode-switch" data-alpha-myspace hidden aria-label="内容模式"><button type="button" data-mode="myspace" aria-pressed="false">{MODE_LABELS.myspace}</button><button type="button" data-mode="explore" aria-pressed="true">{MODE_LABELS.explore}</button></section>
  <div data-explore-view>
  <section class="page-heading"><div><h1>{label}</h1>{feed?.generated_at && <p class="page-meta">{lastUpdated(feed.generated_at)}</p>}<p>{subtitle}</p></div><span>{total} 个视频</span></section>
  {community && <section class="sort-row"><span>来自 {feed.summary.criteria.recommendation.min_recommenders}+ 位 HN 用户的长期推荐，跨越 {feed.summary.criteria.recommendation.min_months} 个月</span><nav><a href={pageUrl('community', 1, base, 'people')} aria-current={sort === 'people' ? 'page' : undefined}>{COMMUNITY_SUBSOURCES.people}</a><a href={pageUrl('community', 1, base, 'newest')} aria-current={sort === 'newest' ? 'page' : undefined}>{COMMUNITY_SUBSOURCES.newest}</a></nav></section>}
  <section class="hot-topics" data-hot-topics hidden></section>
  <section class="video-grid" data-feed-grid data-section={section} data-sort={sort} data-page-size={PAGE_SIZE}>{pageVideos.map(v => <article class="video-card" data-video-id={v.id} data-topic-id={v.topic_id || ''} data-topic-name={v.topic_name || ''}><a class="card-link" href={videoUrl(section, v.id, base)}><div class="thumbnail"><img loading="lazy" src={thumbFor(v)} data-thumb-id={v.id} alt=""/>{v.community_classic && <span class="community-classic-badge">社区经典</span>}<span class="duration">{duration(v.duration_seconds)}</span></div><div class="video-info"><ChannelAvatar channel={channels[v.channel_id]} name={v.channel} /><div class="video-copy"><h2 class="video-title">{zhFor(v)?.title_zh || v.title}</h2>{zhFor(v)?.title_zh && <p class="zh-title">{v.title}</p>}<p class="video-meta">{v.channel}</p><p class="video-meta">{isCommunityVideo(v) ? `${v.recommenders} 人推荐${recommendSpan(v) ? ` · ${recommendSpan(v)}` : ''}` : `${compact(v.view_count)}次观看 · ${ago(v.published_at)}`}</p>{v.why_good && <p class="why-good">{v.pick_source ? `${v.pick_source} · ` : ''}{v.why_good}</p>}{zhFor(v)?.blurb_zh && <p class="zh-blurb">{zhFor(v).blurb_zh}</p>}</div></div></a>{v.topic_id && v.topic_name && <button class="topic-chip" type="button" data-topic-subscribe={v.topic_id} data-topic-name={v.topic_name} title={topicSubscribeTitle(v.topic_name)} aria-label={topicSubscribeTitle(v.topic_name)}>{topicSubscribeLabel(v.topic_name)}</button>}</article>)}</section>
  <div class="infinite-sentinel" data-infinite-sentinel aria-hidden="true"></div><div class="infinite-spinner" data-infinite-spinner hidden aria-live="polite">加载中…</div></div>
  <section data-myspace-view hidden></section>
</Layout>
<script type="application/json" id="feed-data" set:html={JSON.stringify(feedData).replace(/</g, '\\u003c')}></script>
<script>import '../scripts/myspace.js';</script>
<script>
  import { humanizeRecommendSpan, thumbFallbackAttr, thumbFor } from '../lib/format.mjs';
  import { paintTopicChip } from '../lib/topic-labels.mjs';
  const grid = document.querySelector('[data-feed-grid]');
  const sentinel = document.querySelector('[data-infinite-sentinel]');
  const spinner = document.querySelector('[data-infinite-spinner]');
  const data = JSON.parse(document.querySelector('#feed-data').textContent);
  const base = document.querySelector('main')?.dataset.base || '';
  const pageSize = Number(grid.dataset.pageSize);
  let cursor = grid.children.length;
  let loading = false;
  const esc = value => String(value ?? '').replace(/[&<>"']/g, ch => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));
  const avatar = (video) => video.channel_thumbnail
    ? `<img class="channel-avatar" src="${esc(video.channel_thumbnail)}" alt="">`
    : (() => { const name = video.channel || '频道'; const letter = [...name.trim()][0] || '频'; let hash = 0; for (const ch of name) hash = (hash * 31 + ch.codePointAt(0)) >>> 0; const color = ['#d14b4b','#b06b2f','#8a6d1d','#4f8a3d','#357a8a','#5367a6','#7a5795'][hash % 7]; return `<span class="channel-avatar channel-avatar-letter" style="background-color:${color}" aria-hidden="true">${esc(letter)}</span>`; })();
  const ago = value => { const days = Math.max(0, Math.floor((Date.now() - new Date(value).getTime()) / 86400000)); return days < 1 ? '今天' : days < 30 ? `${days}天前` : days < 365 ? `${Math.floor(days / 30)}个月前` : `${Math.floor(days / 365)}年前`; };
  const compact = value => new Intl.NumberFormat('zh-CN', { notation: 'compact', maximumFractionDigits: 1 }).format(value || 0);
  const card = video => { const zh = video.zh || {}; const community = grid.dataset.section === 'community' || (grid.dataset.section === 'picks' && video.source === 'community'); const article = document.createElement('article'); article.className = 'video-card'; article.dataset.videoId = video.id; if (video.topic_id) { article.dataset.topicId = video.topic_id; article.dataset.topicName = video.topic_name || ''; }
    const link = document.createElement('a'); link.className = 'card-link'; link.href = `${base}/v/${video.id}/`;
    const span = humanizeRecommendSpan(video.span_days);
    link.innerHTML = `<div class="thumbnail"><img loading="lazy" src="${esc(thumbFor(video))}" ${thumbFallbackAttr(video.id)} alt="">${video.community_classic ? '<span class="community-classic-badge">社区经典</span>' : ''}<span class="duration">${Math.floor(video.duration_seconds / 60)}:${String(video.duration_seconds % 60).padStart(2, '0')}</span></div><div class="video-info">${avatar(video)}<div class="video-copy"><h2 class="video-title">${esc(zh.title_zh || video.title)}</h2>${zh.title_zh ? `<p class="zh-title">${esc(video.title)}</p>` : ''}<p class="video-meta">${esc(video.channel)}</p><p class="video-meta">${community ? `${video.recommenders} 人推荐${span ? ` · ${span}` : ''}` : `${compact(video.view_count)}次观看 · ${ago(video.published_at)}`}</p>${video.why_good ? `<p class="why-good">${video.pick_source ? `${esc(video.pick_source)} · ` : ''}${esc(video.why_good)}</p>` : ''}${zh.blurb_zh ? `<p class="zh-blurb">${esc(zh.blurb_zh)}</p>` : ''}</div></div>`;
    article.append(link);
    if (video.topic_id && video.topic_name) { const chip = document.createElement('button'); chip.type = 'button'; chip.className = 'topic-chip'; chip.dataset.topicSubscribe = video.topic_id; chip.dataset.topicName = video.topic_name; paintTopicChip(chip, false, video.topic_name); article.append(chip); }
    return article; };
  const load = async () => { if (loading || cursor >= data.length) return; loading = true; spinner.hidden = false; await new Promise(requestAnimationFrame); data.slice(cursor, cursor + pageSize).forEach(video => grid.append(card(video))); cursor += pageSize; loading = false; spinner.hidden = true; if (cursor >= data.length) observer.disconnect(); };
  const observer = new IntersectionObserver(entries => { if (entries[0].isIntersecting) load(); }, { rootMargin: '500px' });
  if (cursor < data.length) observer.observe(sentinel); else sentinel.remove();
</script>
<style>
.mode-switch{display:flex;gap:3px;padding:3px;border-radius:10px;background:#f2f2f2}.mode-switch button{border:0;border-radius:7px;padding:7px 12px;background:transparent;font:600 14px inherit;cursor:pointer;color:#606060;white-space:nowrap}.mode-switch button[aria-pressed="true"]{background:#fff;color:#0f0f0f;box-shadow:0 1px 3px #0000001c}.page-heading{display:flex;justify-content:space-between;align-items:end;margin:6px 0 26px}.page-heading h1{font-size:28px;margin:0 0 6px}.page-heading p,.page-heading span{margin:0;color:#606060;font-size:14px}.sort-row{padding:12px 0;margin:-8px 0 22px;border-block:1px solid #e5e5e5;display:flex;justify-content:space-between;font-size:13px;color:#606060}.sort-row nav{display:flex;gap:16px}.sort-row a{text-decoration:none}.sort-row a[aria-current="page"]{color:#0f0f0f;font-weight:700}@media(max-width:600px){.sort-row{display:block}.sort-row nav{margin-top:10px}}
:global(.site-header .mode-switch){margin:0 24px 8px;width:max-content}:global(.myspace-heading){display:flex;justify-content:space-between;gap:16px;align-items:center;margin:4px 0 18px}:global(.myspace-heading h1),:global(.myspace-column h2){margin:0 0 6px}:global(.myspace-heading h1){font-size:28px}:global(.myspace-heading p),:global(.myspace-heading span),:global(.myspace-loading){margin:0;color:#606060;font-size:14px}:global(.myspace-manage){display:inline-grid;place-items:center;width:36px;height:36px;border:1px solid #ddd;border-radius:50%;background:#fff;color:#0f0f0f;cursor:pointer;font-size:18px}:global(.myspace-manage:hover){background:#f2f2f2}:global(.myspace-columns){display:grid;gap:34px}:global(.myspace-column h2){font-size:20px}:global(.myspace-column){min-width:0;scroll-margin-top:18px}:global(.myspace-editor){width:min(560px,calc(100vw - 28px));border:0;border-radius:14px;padding:0;box-shadow:0 12px 40px #0004}:global(.myspace-editor::backdrop){background:#0008}:global(.myspace-editor-inner){padding:18px}:global(.myspace-editor-title){display:flex;align-items:center;justify-content:space-between;margin:0 0 12px}:global(.myspace-editor-title h2){margin:0;font-size:18px}:global(.myspace-editor-close),:global(.myspace-row button),:global(.myspace-add select){border:1px solid #ddd;border-radius:7px;background:#fff;padding:7px 9px;font:14px inherit;cursor:pointer}:global(.myspace-editor-close){font-size:18px;line-height:1;padding:5px 9px}:global(.myspace-row){display:grid;grid-template-columns:auto minmax(0,1fr) auto auto auto;align-items:center;gap:7px;padding:9px 0;border-top:1px solid #eee}:global(.myspace-row label){display:grid;place-items:center}:global(.myspace-row-name){overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:14px}:global(.myspace-row button:hover),:global(.myspace-add select:hover),:global(.myspace-editor-close:hover){background:#f2f2f2}:global(.myspace-row button:disabled){opacity:.4;cursor:default}:global(.myspace-add){display:flex;gap:8px;margin-top:14px;padding-top:14px;border-top:1px solid #eee}:global(.myspace-add select){min-width:0;flex:1;height:36px}:global(.myspace-editor-note){margin:0 0 9px;color:#606060;font-size:13px}@media(max-width:600px){:global(.site-header.alpha-video-header){padding-bottom:0}:global(.site-header.alpha-video-header .header-row){margin-bottom:48px}:global(.site-header.alpha-video-header .mode-switch){margin:0 8px 6px}:global(.site-header.alpha-video-header .chipbar){padding:0 8px}:global(.site-header.alpha-video-header .chipbar nav){gap:8px}:global(.site-header.alpha-video-header .chipbar a),:global(.site-header.alpha-video-header .chipbar button){padding:0 11px}:global(.myspace-heading h1){font-size:24px}:global(.myspace-row){grid-template-columns:auto minmax(0,1fr) auto auto auto;gap:5px}:global(.myspace-row button){padding:6px 7px}}
.zh-title,.zh-blurb,.why-good{margin:3px 0 0;color:#606060;font-size:13px;line-height:18px}.zh-title{display:-webkit-box;-webkit-line-clamp:1;-webkit-box-orient:vertical;overflow:hidden;overflow-wrap:anywhere}.zh-blurb{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.why-good{color:#065fd4;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;overflow-wrap:anywhere}.video-copy{min-width:0;overflow:hidden}.page-heading .page-meta{margin:0 0 4px;font-size:13px}.infinite-sentinel{height:1px}.infinite-spinner{text-align:center;color:#606060;padding:22px}
</style>
