---
import { pageUrl, pageNumbers, videoUrl } from '../lib/pagination.mjs';
const { videos, total, page, pages, section, sort, feed, tabCounts } = Astro.props;
const base = import.meta.env.BASE_URL;
const start = total ? (page - 1) * 20 + 1 : 0;
const end = Math.min(page * 20, total);
const community = section === 'community';
const duration = (n: number) => `${Math.floor(n / 60)}:${String(n % 60).padStart(2, '0')}`;
const views = (n: number) => new Intl.NumberFormat('en', { notation: 'compact', maximumFractionDigits: 1 }).format(n || 0);
const date = (v: string | number) => typeof v === 'number' ? new Date(v * 1000).toISOString().slice(0, 10) : v.slice(0, 10);
const label = section === 'trending' ? '推荐' : section === 'ai' ? 'AI' : '社区好评';
---
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content="Long Echo video discovery"/><title>{label} · Long Echo</title></head><body><main>
<header class="topbar"><a class:list={['round', { active: section === 'trending' }]} href={pageUrl('trending', 1, base)} aria-label="推荐">♨</a><div class="brand">Long Echo</div><i></i><nav aria-label="Sections"><a class:list={['chip', { active: section === 'ai' }]} href={pageUrl('ai', 1, base)}>AI <b>{tabCounts.ai}</b></a><a class:list={['chip', { active: community }]} href={pageUrl('community', 1, base)}>社区好评 <b>{tabCounts.community}</b></a></nav></header>
<section class="context"><div><p class="kicker">{community ? 'HACKER NEWS · LONG-TERM SIGNALS' : section === 'ai' ? 'CURATED AI CHANNELS · LAST 7 DAYS' : 'YOUTUBE · MOST VIEWED · LAST 30 DAYS'}</p><h1>{label}</h1></div><p class="count">{total}<span> videos</span></p></section>
{community ? <section class="subnav"><span>{feed.summary.criteria.recommendation.min_recommenders}+ people · {feed.summary.criteria.recommendation.min_months}+ months · {feed.summary.criteria.recommendation.min_span_days}+ days</span><nav><a href={pageUrl('community', 1, base, 'people')} aria-current={sort === 'people' ? 'page' : undefined}>最多推荐</a><a href={pageUrl('community', 1, base, 'newest')} aria-current={sort === 'newest' ? 'page' : undefined}>最新入选</a></nav></section> : <p class="feednote">按观看次数排序 · 小于 60 秒的 Shorts 已排除 · 更新于 {date(feed.generated_at)}</p>}
<p class="range">显示 {start}–{end} / {total}</p><section class="grid">{videos.map(v => <article><a class="card-target" href={videoUrl(section, v.id, base)} aria-label={`观看 ${v.title}`}></a><a class="cover" href={videoUrl(section, v.id, base)}><img loading="lazy" src={`https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`} alt=""/><span>{duration(v.duration_seconds)}</span></a><div class="content"><p class="channel">{v.channel}</p><h2><a href={videoUrl(section, v.id, base)}>{v.title}</a></h2>{community ? <><p class="metric">{v.recommenders} people <span>· {v.months} months</span></p><p class="dates">{date(v.first)} → {date(v.last)}</p></> : <><p class="metric">{views(v.view_count)} views</p><p class="dates">{date(v.published_at)}</p></>}{community && v.quotes?.length > 0 && <div class="quotes">{v.quotes.slice(0, 2).map(q => <blockquote><p>{q.text}</p><cite><a href={q.url} target="_blank" rel="noopener noreferrer">{q.author} ↗ HN</a></cite></blockquote>)}</div>}</div></article>)}</section>
{pages > 1 && <nav class="pagination" aria-label="Pagination">{page > 1 && <a rel="prev" href={pageUrl(section, page - 1, base, sort)}>上一页</a>}{pageNumbers(page, pages).map(n => n === null ? <span>…</span> : <a href={pageUrl(section, n, base, sort)} aria-current={n === page ? 'page' : undefined}>{n}</a>)}{page < pages && <a rel="next" href={pageUrl(section, page + 1, base, sort)}>下一页</a>}</nav>}<footer>Long Echo · {community ? '社区信号不等于背书。' : 'YouTube discovery, refreshed manually.'}</footer>
</main><style is:global>
:root{font-family:ui-sans-serif,system-ui,sans-serif;color:#27232d;background:#faf9f7}*{box-sizing:border-box}body{margin:0}main{max-width:1280px;margin:auto;padding:16px 28px 52px}.topbar{height:58px;display:flex;align-items:center;gap:12px;border-bottom:1px solid #e7e2df}.round{width:38px;height:38px;border-radius:50%;display:grid;place-content:center;text-decoration:none;background:#f6e7ed;color:#d74778;font-size:17px}.round.active{box-shadow:inset 0 0 0 2px #e77299}.brand{font-weight:800;letter-spacing:-.6px;font-size:16px}.topbar i{height:24px;border-left:1px solid #d9d1ce;margin-left:auto}.topbar nav{display:flex;gap:8px}.chip{padding:8px 12px;border-radius:18px;font-size:13px;text-decoration:none;color:#625c59;background:#f2efec}.chip.active{background:#312b38;color:#fff}.chip b{font-size:11px;margin-left:4px}.context{display:flex;justify-content:space-between;align-items:end;padding:34px 0 18px}.kicker{font-size:10px;letter-spacing:1.4px;color:#a36d7b;font-weight:700;margin:0}h1{font-size:31px;margin:7px 0 0;letter-spacing:-1px}.count{font-size:30px;font-weight:800;margin:0}.count span{font-size:12px;color:#948b86;font-weight:500}.subnav{border-block:1px solid #e7e2df;padding:11px 0;display:flex;justify-content:space-between;font-size:12px;color:#776f6b}.subnav nav{display:flex;gap:15px}.subnav a[aria-current="page"]{font-weight:800;color:#d74778}.feednote,.range{font-size:12px;color:#817976}.feednote{margin:0;padding:12px 0;border-top:1px solid #e7e2df}.range{margin:17px 0}.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}article{position:relative;background:white;border:1px solid #ebe6e3;border-radius:10px;overflow:hidden}.card-target{position:absolute;inset:0;z-index:1}.cover{display:block;position:relative;z-index:2;aspect-ratio:16/9;background:#eee}.cover img{width:100%;height:100%;object-fit:cover}.cover span{position:absolute;right:7px;bottom:7px;background:#19161ad9;color:#fff;padding:2px 5px;border-radius:3px;font-size:11px}.content{padding:13px}.content h2{position:relative;z-index:2}.channel{font-size:11px;color:#9e6579;margin:0;text-transform:uppercase;letter-spacing:.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}h2{font-size:15px;line-height:1.38;margin:8px 0;min-height:62px}a{color:inherit;text-decoration:none}a:hover{text-decoration:underline}.metric{font-size:13px;font-weight:750;color:#b83d67;margin:0}.metric span,.dates{color:#837a77;font-weight:400}.dates{font-size:11px;margin:6px 0 0}.quotes{position:relative;z-index:2;border-top:1px solid #eee7e5;margin-top:12px}blockquote{font-size:11px;line-height:1.5;margin:10px 0}blockquote p{margin:0 0 4px}cite{font-style:normal;color:#9e6579;font-size:10px}.pagination{display:flex;justify-content:center;gap:7px;flex-wrap:wrap;margin-top:30px}.pagination a,.pagination span{padding:7px 10px;border-radius:6px;font-size:13px}.pagination a{border:1px solid #ded7d4}.pagination [aria-current="page"]{background:#312b38;color:#fff;border-color:#312b38}footer{margin-top:48px;font-size:11px;color:#958d89;text-align:center}@media(max-width:950px){.grid{grid-template-columns:repeat(3,1fr)}}@media(max-width:670px){main{padding:10px 14px 36px}.grid{grid-template-columns:repeat(2,1fr);gap:10px}.brand{display:none}.topbar i{margin-left:auto}.context{padding:24px 0 14px}h1{font-size:27px}.subnav{gap:8px;align-items:start;flex-direction:column}h2{font-size:14px;min-height:58px}.content{padding:10px}}@media(max-width:390px){.grid{grid-template-columns:1fr}}
</style></body></html>
