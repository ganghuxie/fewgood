---
import Header from './Header.astro';
import { SITE_NAME, TAGLINE } from '../lib/brand.mjs';
const { title = SITE_NAME, active = 'trending', description = `${SITE_NAME} 视频发现` } = Astro.props;
---
<!doctype html>
<html lang="zh-CN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><title>{title}</title></head>
<body><Header active={active}/><main><slot/></main><footer class="site-footer">{SITE_NAME} · {TAGLINE}</footer>
<style is:global>
:root{font-family:Roboto,Arial,system-ui,sans-serif;color:#0f0f0f;background:#fff}*{box-sizing:border-box}body{margin:0}.site-header{position:sticky;top:0;z-index:20;background:#fff;border-bottom:1px solid #e5e5e5}.site-header a{color:#0f0f0f;text-decoration:none}.header-row{height:64px;max-width:1440px;margin:auto;padding:0 24px;display:flex;align-items:center;gap:24px}.logo{display:flex;align-items:center;gap:7px;font-weight:800;font-size:21px;letter-spacing:-1px;white-space:nowrap}.logo-mark{width:32px;height:22px;background:#e52d27;border-radius:7px;display:grid;place-items:center}.logo-mark i{width:0;height:0;border-top:6px solid transparent;border-bottom:6px solid transparent;border-left:10px solid #fff;margin-left:2px}.search{display:flex;max-width:640px;flex:1;margin:auto}.search input{min-width:0;width:100%;height:40px;border:1px solid #ccc;border-radius:20px 0 0 20px;padding:0 16px;font-size:16px;box-shadow:inset 0 1px 2px #eee}.search button{width:64px;border:1px solid #ccc;border-left:0;border-radius:0 20px 20px 0;background:#f8f8f8;color:#0f0f0f;font-size:24px;cursor:pointer}.libraries{display:flex;gap:14px;align-items:center}.libraries a{position:relative;display:flex;flex-direction:column;align-items:center;gap:2px;font-size:13px;white-space:nowrap}.library-icon{width:24px;height:24px;display:block;fill:none;stroke:#0f0f0f;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.libraries b{position:absolute;top:-4px;right:-6px;min-width:17px;padding:1px 4px;border-radius:9px;background:#cc0000;color:#fff;font-size:10px;text-align:center}.chipbar{height:48px;border-top:1px solid #f2f2f2;display:flex;align-items:center;gap:18px;padding:0 24px;overflow:auto}.chipbar nav{display:flex;gap:12px}.chipbar a{padding:8px 13px;background:#f2f2f2;color:#0f0f0f;border-radius:8px;font-size:14px;white-space:nowrap}.chipbar a.active{background:#0f0f0f;color:#fff}.chipbar a:not(.active):hover{background:#e5e5e5}.chipbar small{color:#606060;white-space:nowrap}.site-footer{border-top:1px solid #e5e5e5;text-align:center;padding:28px 16px;color:#606060;font-size:13px;margin-top:48px}main{max-width:1440px;margin:auto;padding:24px}.video-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:28px 16px}.video-card{text-decoration:none;display:block;color:inherit}.thumbnail{position:relative;aspect-ratio:16/9;background:#eee;border-radius:12px;overflow:hidden}.thumbnail img{display:block;width:100%;height:100%;object-fit:cover}.duration{position:absolute;right:5px;bottom:5px;background:#0f0f0ee6;color:#fff;padding:3px 4px;border-radius:4px;font-size:12px;font-weight:600}.video-info{display:grid;grid-template-columns:1fr;gap:5px;padding:9px 3px}.video-title{font-size:16px;line-height:1.35;font-weight:600;margin:0;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.video-meta{font-size:13px;color:#606060;margin:0}.pagination{display:flex;justify-content:center;gap:7px;flex-wrap:wrap;margin-top:36px}.pagination a,.pagination span{padding:7px 10px;border-radius:6px;font-size:13px}.pagination a{border:1px solid #ddd;text-decoration:none}.pagination [aria-current="page"]{background:#0f0f0f;color:#fff;border-color:#0f0f0f}@media(max-width:1000px){.video-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.libraries span{display:none}}@media(max-width:680px){.header-row{padding:0 14px;gap:12px}.logo{font-size:18px}.search{order:3;position:absolute;left:14px;right:14px;top:70px;max-width:none}.site-header{padding-bottom:48px}.chipbar{padding:0 14px}.video-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:20px 10px}main{padding:16px 14px}.libraries{gap:9px}.video-title{font-size:14px}}@media(max-width:410px){.video-grid{grid-template-columns:1fr}}
</style></body></html>
