---
import Header from './Header.astro';
import Sidebar from './Sidebar.astro';
import { SITE_NAME, TAGLINE } from '../lib/brand.mjs';
const { title = SITE_NAME, active = 'trending', description = `${SITE_NAME} 视频发现` } = Astro.props;
const cfBeaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN?.trim();
---
<!doctype html>
<html lang="zh-CN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml"/><link rel="alternate icon" href={`${import.meta.env.BASE_URL}favicon.ico`} sizes="any"/><link rel="icon" type="image/png" sizes="16x16" href={`${import.meta.env.BASE_URL}favicon-16.png`}/><link rel="icon" type="image/png" sizes="32x32" href={`${import.meta.env.BASE_URL}favicon-32.png`}/><link rel="apple-touch-icon" sizes="180x180" href={`${import.meta.env.BASE_URL}apple-touch-icon-180.png`}/><link rel="manifest" href={`${import.meta.env.BASE_URL}site.webmanifest`}/><meta property="og:image" content={`${import.meta.env.SITE}${import.meta.env.BASE_URL}og-image-1200x630.png`}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet"/><title>{title}</title></head>
<body><Header active={active}/><Sidebar/><div class="sidebar-backdrop"></div><main data-base={import.meta.env.BASE_URL.replace(/\/$/, "")}><slot/></main><footer class="site-footer">{SITE_NAME} · {TAGLINE}</footer>
<script>import '../scripts/analytics.js';</script>
{cfBeaconToken && <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: cfBeaconToken })}></script>}
<style is:global>
:root{font-family:Roboto,Arial,sans-serif;color:#0f0f0f;background:#fff}*{box-sizing:border-box}body{margin:0}.site-header{position:sticky;top:0;z-index:20;background:#fff;border-bottom:1px solid #e5e5e5}.site-header a{color:#0f0f0f;text-decoration:none}.header-row{height:56px;padding:0 24px;display:flex;align-items:center;gap:18px}.menu-toggle{width:40px;height:40px;border:0;background:none;border-radius:50%;display:grid;place-items:center;cursor:pointer;flex:none}.menu-toggle:hover{background:#f2f2f2}.menu-toggle svg{width:24px;height:24px;fill:none;stroke:#0f0f0f;stroke-width:2;stroke-linecap:round}.logo{display:flex;align-items:center;gap:7px;font-weight:700;font-size:21px;letter-spacing:-1px;white-space:nowrap}.logo-mark{width:28px;height:28px;display:block;object-fit:contain;flex:none}.search{display:flex;min-width:0;max-width:640px;flex:1;margin:auto}.search input{min-width:0;width:100%;height:40px;border:1px solid #ccc;border-radius:20px 0 0 20px;padding:0 16px;font-size:16px;box-shadow:inset 0 1px 2px #eee}.search button{width:64px;border:1px solid #ccc;border-left:0;border-radius:0 20px 20px 0;background:#f8f8f8;color:#0f0f0f;font-size:24px;cursor:pointer}.libraries{display:flex;gap:14px;align-items:center}.libraries .lib-trigger{position:relative;display:flex;flex-direction:column;align-items:center;gap:2px;font-size:13px;white-space:nowrap}.library-icon{width:24px;height:24px;display:block;fill:none;stroke:#0f0f0f;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.libraries .lib-trigger b{position:absolute;top:-4px;right:-6px;min-width:17px;padding:1px 4px;border-radius:9px;background:#cc0000;color:#fff;font-size:10px;text-align:center}.chipbar{height:48px;border-top:1px solid #f2f2f2;display:flex;align-items:center;padding:0 24px;overflow:auto}.chipbar nav{display:flex;gap:12px}.chipbar a,.chipbar button{height:32px;padding:0 13px;display:grid;place-items:center;border:0;background:#f2f2f2;color:#0f0f0f;border-radius:8px;font:500 14px inherit;white-space:nowrap;cursor:pointer}.chipbar a.active,.chipbar button.active{background:#0f0f0f;color:#fff}.chipbar a:not(.active):hover,.chipbar button:not(.active):hover{background:#e5e5e5}.site-footer{border-top:1px solid #e5e5e5;text-align:center;padding:28px 16px;color:#606060;font-size:13px;margin-top:48px}main{padding:24px}.video-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px 16px}.video-card{text-decoration:none;display:block;color:inherit}.thumbnail{position:relative;aspect-ratio:16/9;background:#eee;border-radius:12px;overflow:hidden}.thumbnail img{display:block;width:100%;height:100%;object-fit:cover}.duration{position:absolute;right:5px;bottom:5px;background:#0f0f0ee6;color:#fff;padding:3px 4px;border-radius:4px;font-size:12px;font-weight:600}.video-info{display:grid;grid-template-columns:36px 1fr;gap:9px;padding:9px 3px}.channel-avatar{width:36px;height:36px;border-radius:50%;object-fit:cover;grid-row:span 2}.channel-avatar-letter{display:grid;place-items:center;color:#fff;font-size:17px;font-weight:700}.video-title{font-size:16px;line-height:22px;font-weight:500;margin:0;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.video-meta{font-size:14px;color:#606060;margin:0}.pagination{display:flex;justify-content:center;gap:7px;flex-wrap:wrap;margin-top:36px}.pagination a,.pagination span{padding:7px 10px;border-radius:6px;font-size:13px}.pagination a{border:1px solid #ddd;text-decoration:none}.pagination [aria-current="page"]{background:#0f0f0f;color:#fff;border-color:#0f0f0f}@media(min-width:1600px){.video-grid{grid-template-columns:repeat(5,minmax(0,1fr))}}@media(min-width:1300px) and (max-width:1599px){.video-grid{grid-template-columns:repeat(4,minmax(0,1fr))}}@media(max-width:899px){.video-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.libraries span{display:none}}@media(max-width:599px){.header-row{padding:0 14px;gap:12px}.logo{font-size:18px}.search{order:3;position:absolute;left:8px;right:8px;top:62px;max-width:none}.site-header{padding-bottom:48px}.chipbar{padding:0 14px}.video-grid{grid-template-columns:1fr;gap:20px}main{padding:16px 14px}.libraries{gap:9px}.video-title{font-size:16px}}
</style></body></html>
