---
import Layout from './Layout.astro';

const { title, description = '官方发布者 RSS 音频播客、近期精选与单集历史。' } = Astro.props;
const policy = '音频来自发布者官方来源，本站不提供下载。';
---
<Layout
  title={title}
  active="audio-podcast"
  description={description}
  ogTitle={title}
  ogDescription={description}
>
  <div class="audio-preview">
    <slot />

    <p class="audio-preview-policy">{policy}</p>
  </div>
</Layout>

<style is:global>
.audio-preview{--paper:#faf8f3;--surface:#fffefb;--ink:#17221f;--muted:#656b65;--line:#dedfd6;--accent:#23744e;max-width:1160px;margin:0 auto;padding:48px 48px 28px;background:var(--paper);color:var(--ink);border-radius:4px;font-family:Arial,"PingFang SC","Microsoft YaHei",sans-serif;line-height:1.65;overflow-wrap:anywhere}
.audio-preview *{box-sizing:border-box}.audio-preview a{color:inherit;text-underline-offset:4px}.audio-preview a:focus-visible,.audio-preview button:focus-visible,.audio-preview summary:focus-visible{outline:3px solid #49c987;outline-offset:5px}.audio-preview a:hover{color:var(--accent)}
.audio-preview h1,.audio-preview h2,.audio-preview h3,.audio-preview p{margin-top:0}.audio-preview h1{font-size:42px;letter-spacing:-.035em;line-height:1.35;margin-bottom:16px;font-weight:650}.audio-preview h2{font-size:24px;line-height:1.4;margin-bottom:0}.audio-preview h3{font-size:18px;line-height:1.6;margin-bottom:0;font-weight:600}
.audio-preview-kicker{font-size:11px;letter-spacing:.16em;color:var(--accent);font-weight:700;margin-bottom:18px}.audio-preview-lede{color:var(--muted);font-size:16px}.audio-index-head{padding:8px 0 12px}.audio-local-nav{display:flex;gap:26px;margin-top:28px;font-size:13px}.audio-local-nav a{text-decoration:none}.audio-local-nav a:first-child{border-bottom:2px solid #49c987;padding-bottom:5px}
.audio-preview-section{margin-top:44px}.audio-preview-section-head{display:flex;align-items:baseline;justify-content:space-between;gap:20px;margin-bottom:24px}.audio-preview-section-head p{font-size:12px;color:var(--muted);margin-bottom:0}.audio-heading-number{font:400 13px Arial,sans-serif;color:var(--muted);margin-left:12px;vertical-align:middle}
.audio-recent-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:34px}.audio-recent-card{min-width:0;padding:22px 0;border-top:1px solid var(--line)}.audio-recent-top{display:flex;align-items:center;gap:10px;color:var(--muted);font-size:12px;margin-bottom:12px}.audio-recent-top a{text-decoration:none}.audio-cover{width:40px;height:40px;object-fit:cover;border-radius:7px;background:var(--surface);flex:none}.audio-recent-card h3{margin-bottom:16px}.audio-recent-card h3 a{text-decoration:none}.audio-recent-meta,.audio-episode-meta{display:flex;flex-wrap:wrap;align-items:center;gap:8px 16px;color:var(--muted);font-size:12px;margin-bottom:0}.audio-recent-arrow{margin-left:auto;color:var(--accent)!important;text-decoration:none;font-size:20px;padding:0 8px}
.audio-directory{padding:30px;background:var(--surface);border:1px solid var(--line);border-radius:12px}.audio-show-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 28px}.audio-show-card{display:flex;align-items:flex-start;gap:16px;padding:24px 0;border-top:1px solid var(--line);text-decoration:none;min-width:0}.audio-cover-directory{width:64px;height:64px;border-radius:10px}.audio-show-publisher{font-size:12px;color:var(--muted);margin-bottom:7px}.audio-show-count,.audio-show-recent{font-size:11px;color:var(--muted);margin-bottom:0}.audio-method{margin-top:30px;color:var(--muted);font-size:12px}.audio-method summary{cursor:pointer}.audio-method p{margin:12px 0 0;max-width:760px}.audio-preview-policy{border-top:1px solid var(--line);margin:28px 0 0;padding-top:18px;font-size:11px;color:var(--muted)}
.audio-back{display:inline-block;font-size:13px;margin-bottom:28px;text-decoration:none;color:var(--accent)!important}.audio-show-head{display:flex;gap:24px;align-items:flex-start;padding-bottom:28px;border-bottom:1px solid var(--line)}.audio-cover-large{width:96px;height:96px;border-radius:14px}.audio-show-head h1{font-size:34px}.audio-show-head .audio-preview-kicker{margin-bottom:8px}.audio-show-byline{font-size:13px;color:var(--muted);margin-bottom:12px}.audio-show-description{font-size:13px;color:var(--muted);max-width:650px;margin-bottom:0}.audio-episode-list{list-style:none;padding:0;margin:0}.audio-episode{border-top:1px solid var(--line)}.audio-episode-row{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:24px 0;text-decoration:none}.audio-episode-row h3{margin-bottom:8px}.audio-episode-row>span{color:var(--accent)}
.audio-pagination{display:flex;justify-content:center;gap:8px;flex-wrap:wrap;margin-top:30px}.audio-pagination a,.audio-pagination span{min-width:36px;min-height:38px;padding:6px 10px;text-align:center;border:1px solid var(--line);border-radius:5px;font-size:13px;text-decoration:none}.audio-pagination [aria-current]{background:var(--ink);color:var(--paper)}.audio-page-note{font-size:12px;color:var(--muted);text-align:center;margin:16px 0 0}
.audio-detail{max-width:780px;margin:0 auto}.audio-detail h1{font-size:34px;line-height:1.5}.audio-player{margin:30px 0;padding:24px;background:var(--surface);border:1px solid var(--line);border-radius:12px}.audio-player audio{width:100%;display:block;margin-top:14px}.audio-player [hidden]{display:none}.audio-play-button{min-height:44px;border:0;border-radius:24px;background:var(--ink);color:var(--paper);padding:10px 22px;font-size:14px;cursor:pointer}.audio-play-button:disabled{opacity:.7}.audio-player-note,.audio-source-note{font-size:12px;color:var(--muted);margin:14px 0 0}.audio-playback-error,.audio-episode-note{padding:14px;border:1px solid var(--line);border-radius:8px;font-size:13px;margin:14px 0;background:var(--surface)}.audio-notes{margin-top:36px}.audio-notes h2{margin-bottom:24px}.audio-episode-description{font-size:16px;line-height:1.95;overflow-wrap:anywhere}.audio-episode-description img{max-width:100%;height:auto}.audio-episode-description pre{white-space:pre-wrap}.audio-episode-description a,.audio-notes>p>a{color:var(--accent)}.audio-empty{padding:28px;border:1px dashed var(--line);color:var(--muted)}
@media(max-width:760px){.audio-preview{padding:28px 22px}.audio-preview h1{font-size:32px}.audio-preview-section-head{display:block}.audio-preview-section-head p{margin-top:7px}.audio-recent-grid,.audio-show-grid{grid-template-columns:1fr}.audio-directory{padding:22px}.audio-detail h1{font-size:27px}.audio-show-head{gap:16px}.audio-cover-large{width:64px;height:64px}.audio-show-head h1{font-size:27px}.audio-player{padding:18px}.audio-preview-section{margin-top:34px}}
@media(max-width:420px){.audio-preview{padding:26px 16px}.audio-directory{padding:18px 14px}.audio-local-nav{gap:18px}.audio-preview h3{font-size:17px}}
/* Clear the shell's absolutely positioned mobile search on audio pages only. */
@media(max-width:599px){body:has(.audio-preview) .site-header{padding-bottom:0}body:has(.audio-preview) .site-header .chipbar{margin-top:48px}}
/* Audio pages retain a warm, light reading surface. */

.audio-show-head{background:#fff;padding:24px;border:0;border-radius:10px}.audio-show-byline{margin-bottom:0}.audio-tabs{display:flex;gap:28px;border-bottom:1px solid var(--line);margin-top:24px}.audio-tabs button{border:0;background:none;padding:14px 0;color:var(--muted);font:inherit;cursor:pointer}.audio-tabs [aria-selected="true"]{color:var(--ink);font-weight:700;border-bottom:3px solid #49C987}.audio-tab-panel[hidden]{display:none}.audio-row-cover{width:64px;height:64px;border-radius:8px;object-fit:cover;flex:none}.audio-row-copy{flex:1;min-width:0}.audio-excerpt{font-size:13px;color:var(--muted);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;margin-bottom:10px}.audio-player{padding:0;background:none;border:0;border-radius:0;margin:24px 0}.audio-playback-error{border:0;padding:0;background:none}.audio-playback-error a{font-size:12px;margin-left:12px}.audio-show-details{padding:24px 0;max-width:720px;white-space:pre-line;font-size:15px}.audio-episode-row{align-items:flex-start;gap:16px}.audio-detail{max-width:780px}.audio-preview{max-width:1040px;padding-top:32px}.audio-show-head h1{margin-bottom:8px}
@media(max-width:420px){.audio-show-head{padding:18px 14px}.audio-row-cover{width:52px;height:52px}.audio-episode-row{gap:12px}.audio-preview{padding:24px 16px}.audio-show-head h1{font-size:26px}}
</style>
<script is:inline>
  // Scope the horizontal scroll to audio pages; never move the page vertically.
  const revealAudioChip = () => {
    if (!document.querySelector('.audio-preview')) return;
    const bar = document.querySelector('.site-header .chipbar');
    const active = bar?.querySelector('a.active');
    if (!bar || !active) return;
    const box = bar.getBoundingClientRect();
    const chip = active.getBoundingClientRect();
    if (chip.left < box.left || chip.right > box.right) bar.scrollLeft += chip.left - box.left - (box.width - chip.width) / 2;
  };
  requestAnimationFrame(revealAudioChip);
</script>
