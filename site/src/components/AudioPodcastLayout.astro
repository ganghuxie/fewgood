---
import Layout from './Layout.astro';

const { title, description = '官方发布者 RSS 音频播客、近期精选与单集历史。', updatedAt = '' } = Astro.props;
const policy = '音频来自发布者官方来源，本站不提供下载。';
---
<Layout
  title={title}
  active="audio-podcast"
  description={description}
  updatedAt={updatedAt}
  ogTitle={title}
  ogDescription={description}
>
  <div class="audio-preview">
    <slot />

    <p class="audio-preview-policy">{policy}</p>
  </div>
</Layout>

<style is:global>
.audio-preview{--paper:#fff;--surface:#fff;--ink:#0f0f0f;--muted:#606060;--line:#e5e5e5;--accent:#23744e;width:100%;max-width:none;margin:0;padding:0 0 28px;background:#fff;color:var(--ink);border-radius:0;line-height:1.65;overflow-wrap:anywhere}
.audio-preview *{box-sizing:border-box}.audio-preview a{color:inherit;text-underline-offset:4px}.audio-preview a:focus-visible,.audio-preview button:focus-visible,.audio-preview summary:focus-visible{outline:3px solid #49c987;outline-offset:5px}.audio-preview a:hover{color:var(--accent)}
.audio-preview [hidden]{display:none !important}
.audio-preview h1,.audio-preview h2,.audio-preview h3,.audio-preview p{margin-top:0}.audio-preview h1{font-size:28px;letter-spacing:0;line-height:1.35;margin-bottom:6px;font-weight:700}.audio-preview h2{font-size:24px;line-height:1.4;margin-bottom:0}.audio-preview h3{font-size:18px;line-height:1.6;margin-bottom:0;font-weight:600}
.audio-preview-kicker{font-size:11px;letter-spacing:.16em;color:var(--accent);font-weight:700;margin-bottom:18px}
.audio-preview-section{margin-top:44px}.audio-preview-section-head{display:flex;align-items:baseline;justify-content:space-between;gap:20px;margin-bottom:24px}.audio-preview-section-head p{font-size:12px;color:var(--muted);margin-bottom:0}
.audio-cover{object-fit:cover;background:var(--surface);flex:none}.audio-episode-meta{display:flex;flex-wrap:wrap;align-items:center;gap:8px 16px;color:var(--muted);font-size:12px;margin-bottom:0}
.audio-back{display:inline-flex;align-items:center;min-height:40px;padding:7px 11px;border:1px solid var(--line);border-radius:7px;background:#fff;font-size:14px;font-weight:600;margin-bottom:24px;text-decoration:none;color:var(--accent)!important}.audio-back:hover{background:#f5faf7}.audio-show-head{display:flex;gap:24px;align-items:flex-start;padding-bottom:28px;border-bottom:1px solid var(--line)}.audio-cover-large{width:96px;height:96px;border-radius:14px}.audio-show-head h1{font-size:34px}.audio-show-head .audio-preview-kicker{margin-bottom:8px}.audio-show-byline{font-size:13px;color:var(--muted);margin-bottom:12px}.audio-show-description{font-size:13px;color:var(--muted);max-width:650px;margin-bottom:0}.audio-episode-list{list-style:none;padding:0;margin:0}.audio-episode{border-top:1px solid var(--line)}.audio-episode-row{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:24px 0;text-decoration:none}.audio-episode-row h3{margin-bottom:8px}.audio-episode-row>span{color:var(--accent)}
.audio-pagination{display:flex;justify-content:center;gap:8px;flex-wrap:wrap;margin-top:30px}.audio-pagination a,.audio-pagination span{min-width:36px;min-height:38px;padding:6px 10px;text-align:center;border:1px solid var(--line);border-radius:5px;font-size:13px;text-decoration:none}.audio-pagination [aria-current]{background:var(--ink);color:var(--paper)}.audio-page-note{font-size:12px;color:var(--muted);text-align:center;margin:16px 0 0}
.audio-detail{max-width:780px;margin:0 auto}.audio-detail h1{font-size:34px;line-height:1.5}.audio-player{margin:30px 0;padding:24px;background:var(--surface);border:1px solid var(--line);border-radius:12px}.audio-player audio{width:100%;display:block;margin-top:14px}.audio-player [hidden]{display:none}.audio-play-button{min-height:44px;border:0;border-radius:24px;background:var(--ink);color:var(--paper);padding:10px 22px;font-size:14px;cursor:pointer}.audio-play-button:disabled{opacity:.7}.audio-player-note,.audio-source-note{font-size:12px;color:var(--muted);margin:14px 0 0}.audio-playback-error,.audio-episode-note{padding:14px;border:1px solid var(--line);border-radius:8px;font-size:13px;margin:14px 0;background:var(--surface)}.audio-notes{margin-top:36px}.audio-notes h2{margin-bottom:24px}.audio-episode-description{font-size:16px;line-height:1.95;overflow-wrap:anywhere}.audio-episode-description img{max-width:100%;height:auto}.audio-episode-description pre{white-space:pre-wrap}.audio-episode-description a,.audio-notes>p>a{color:var(--accent)}.audio-empty{padding:28px;border:1px dashed var(--line);color:var(--muted)}
@media(max-width:760px){.audio-detail h1{font-size:27px}.audio-show-head{gap:16px}.audio-cover-large{width:64px;height:64px}.audio-show-head h1{font-size:27px}.audio-player{padding:18px}}
@media(max-width:420px){.audio-preview h3{font-size:17px}}
/* Clear the shell's absolutely positioned mobile search on audio pages only. */
@media(max-width:599px){body:has(.audio-preview) .site-header{padding-bottom:0}body:has(.audio-preview) .site-header .chipbar{margin-top:48px}}
/* Preserve the existing show and episode structure on the shared white shell. */

.audio-show-head{background:#fff;padding:24px;border:0;border-radius:10px}.audio-show-byline{margin-bottom:0}.audio-tabs{display:flex;gap:28px;border-bottom:1px solid var(--line);margin-top:24px}.audio-tabs button{border:0;background:none;padding:14px 0;color:var(--muted);font:inherit;cursor:pointer}.audio-tabs [aria-selected="true"]{color:var(--ink);font-weight:700;border-bottom:3px solid #49C987}.audio-tab-panel[hidden]{display:none}.audio-row-cover{width:64px;height:64px;border-radius:8px;object-fit:cover;flex:none}.audio-row-copy{flex:1;min-width:0}.audio-excerpt{font-size:13px;color:var(--muted);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;margin-bottom:10px}.audio-player{padding:0;background:none;border:0;border-radius:0;margin:24px 0}.audio-playback-error{border:0;padding:0;background:none}.audio-playback-error a{font-size:12px;margin-left:12px}.audio-show-details{padding:24px 0;max-width:720px;white-space:pre-line;font-size:15px}.audio-episode-row{align-items:flex-start;gap:16px}.audio-detail{max-width:780px}.audio-show-head h1{margin-bottom:8px}
@media(max-width:420px){.audio-show-head{padding:18px 14px}.audio-row-cover{width:52px;height:52px}.audio-episode-row{gap:12px}.audio-show-head h1{font-size:26px}}
/* Audio index: a plain white page surface with square, video-style cards. */
.audio-preview{width:100%;max-width:none;margin:0;padding:0 0 28px;background:#fff;border-radius:0}
.audio-index-head{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:20px;margin:6px 0 26px;padding:0}.audio-index-head>div{min-width:0}
.audio-index-head h1{font-size:28px;line-height:1.35;font-weight:700;letter-spacing:0;margin:0 0 6px}
.audio-index-head p,.audio-index-head>span{color:var(--muted);font-size:14px;margin:0}
.audio-index-tabs{display:flex;gap:8px;border-bottom:1px solid var(--line);margin:0 0 28px}.audio-index-tabs button{min-height:40px;padding:8px 4px;border:0;border-bottom:3px solid transparent;background:none;color:var(--muted);font:600 15px inherit;cursor:pointer}.audio-index-tabs button+button{margin-left:20px}.audio-index-tabs [aria-selected="true"]{color:var(--ink);border-bottom-color:var(--accent)}
.audio-index-section{margin-top:16px}
.audio-index-section .audio-preview-section-head{display:flex;align-items:baseline;justify-content:space-between;gap:20px;margin-bottom:16px}
.audio-index-section .audio-preview-section-head h2{font-size:20px;line-height:1.4;font-weight:700;margin:0}
.audio-index-section .audio-preview-section-head p{color:var(--muted);font-size:13px;margin:0}
.audio-recent-grid,.audio-show-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:20px;align-items:start}
@media(max-width:599px){.audio-recent-grid,.audio-show-grid{gap:16px}.audio-index-head{align-items:flex-start}.audio-index-section .audio-preview-section-head{display:block}.audio-index-section .audio-preview-section-head p{margin-top:6px}.audio-index-section{margin-top:30px}}
.audio-recent-card,.audio-show-card{min-width:0}
.audio-show-card{display:block;padding:0;border-top:0;color:inherit;text-decoration:none}
.audio-card-link,.audio-show-card{display:block;min-width:0;color:var(--ink);text-decoration:none}
.audio-preview .audio-card-link:hover,.audio-preview .audio-show-card:hover{color:var(--ink)}
.audio-card-media{position:relative;aspect-ratio:1;background:#eee;border-radius:12px;overflow:hidden}
.audio-card-cover{display:block;width:100%;height:100%;object-fit:cover}
.audio-card-duration{position:absolute;right:5px;bottom:5px;background:#0f0f0ee6;color:#fff;padding:3px 4px;border-radius:4px;font-size:12px;font-weight:600;line-height:1.3}
.audio-card-copy{min-width:0;padding:9px 3px 0}
.audio-card-title{font-size:16px;line-height:22px;min-height:44px;font-weight:500;margin:0;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;overflow-wrap:anywhere}
.audio-newness-dot{display:inline-block;width:7px;height:7px;margin:0 0 2px 6px;border-radius:50%;background:var(--accent);vertical-align:middle}
.audio-card-show,.audio-card-meta{color:var(--muted);margin:0;min-width:0;overflow-wrap:anywhere}
.audio-card-show{font-size:14px;line-height:20px;margin-top:4px}
.audio-card-meta{font-size:13px;line-height:19px;margin-top:2px;display:flex;flex-wrap:wrap;gap:0 8px}
.audio-directory{margin-top:36px;padding:0;background:transparent;border:0;border-radius:0}
.audio-show-publisher{font-size:14px;line-height:20px;margin-top:4px;margin-bottom:0}
.audio-show-count,.audio-show-recent{font-size:13px;line-height:19px;margin-top:2px;margin-bottom:0}.audio-show-status,.audio-source-status{color:#8a5a2b}.audio-source-status{margin:4px 0 16px;font-size:13px;line-height:1.55}
.audio-coverage{display:grid;grid-template-columns:auto minmax(140px,280px);align-items:center;gap:8px 14px;margin:0 0 10px;max-width:430px}.audio-coverage-label{display:flex;align-items:baseline;gap:8px;font-size:12px;color:var(--muted);white-space:nowrap}.audio-coverage-label strong{font-size:13px;color:var(--ink)}.audio-coverage-track{grid-column:1 / -1;height:4px;border-radius:4px;background:#e9eee9;overflow:hidden}.audio-coverage-track span{display:block;height:100%;border-radius:inherit;background:#49C987}.audio-category-filters{display:flex;gap:16px;overflow-x:auto;padding:0 0 8px;margin:0 0 8px}.audio-category-filters button{min-height:28px;flex:none;padding:3px 0;border:0;border-bottom:2px solid transparent;background:transparent;color:#8a8a8a;font:12px inherit;cursor:pointer}.audio-category-filters button.active{border-bottom-color:var(--accent);color:var(--ink);font-weight:600}.audio-picks-status{margin:0 0 18px;padding:10px 12px;border:1px solid var(--line);border-radius:8px;color:var(--muted);font-size:13px;line-height:1.55}.audio-filter-empty{margin:16px 0 0;color:var(--muted);font-size:13px}.audio-missing-show{margin-top:28px;padding:16px;border:1px dashed var(--line);border-radius:8px;color:var(--muted)}.audio-missing-show h3{color:var(--ink);font-size:16px}.audio-missing-show p{font-size:13px;margin:5px 0 0}
.audio-method{margin-top:32px;padding-top:16px;border-top:1px solid var(--line);color:var(--muted);font-size:12px}
.audio-method summary{cursor:pointer}
.audio-method p{max-width:760px;margin:10px 0 0}
.audio-preview-policy{border-top:1px solid var(--line);margin:28px 0 0;padding-top:18px;font-size:11px;color:var(--muted)}
</style>
<style is:global>
.audio-index-section .audio-card-media{width:100%;aspect-ratio:1/1}
.audio-index-section .audio-card-copy{padding:6px 2px 0}
.audio-index-section .audio-card-title{font-size:14px;line-height:20px}
.audio-index-section .audio-card-show{font-size:12px;line-height:16px;margin-top:2px}
.audio-index-section .audio-card-meta{font-size:12px;line-height:16px;margin-top:1px}
.audio-method .audio-picks-status{margin:0;padding:0;border:0;color:var(--muted);font-size:12px;line-height:1.55}
</style>
<style is:global>
.audio-show-details{max-width:min(100%,960px);font-size:16px;line-height:1.9}
</style>
<script is:inline>
  // Scope the horizontal scroll to audio pages; never move the page vertically.
  const revealAudioChip = () => {
    if (!document.querySelector('.audio-preview')) return;
    const bar = document.querySelector('.site-header .chipbar');
    const active = bar?.querySelector('a.active');
    if (!bar || !active) return;
    const box = bar.getBoundingClientRect();
    const chip = active.getBoundingClientRect();
    if (chip.left < box.left || chip.right > box.right) bar.scrollLeft += chip.left - box.left - (box.width - chip.width) / 2;
  };
  const revealAfterLayout = () => requestAnimationFrame(() => requestAnimationFrame(revealAudioChip));
  revealAfterLayout();
  window.addEventListener('load', revealAfterLayout, { once: true });
  document.fonts?.ready.then(revealAfterLayout);
</script>
