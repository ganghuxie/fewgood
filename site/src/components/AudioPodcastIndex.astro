---
import AudioPodcastLayout from './AudioPodcastLayout.astro';
import { EPISODE_COUNT_LABEL, episodePath, showPath, sortRecentSelection } from '../lib/audio-podcast.mjs';
const { data } = Astro.props;
const base = import.meta.env.BASE_URL;
const shows = data.shows || [];
const recent = sortRecentSelection(data.recent_selection?.items || []);
const bySlug = Object.fromEntries(shows.map(show => [show.slug, show]));
---
<AudioPodcastLayout title="音频播客 · fewgood.">
  <header class="audio-index-head"><div><h1>音频播客</h1><p>官方发布者 RSS · 近期更新与节目目录</p></div><span>{shows.length} 档</span></header>
  {data.available === false && <p class="audio-empty" role="status">{data.unavailable_message}</p>}
  <section class="audio-preview-section audio-index-section" aria-labelledby="recent-heading">
    <div class="audio-preview-section-head"><h2 id="recent-heading">近期精选</h2><p>近 30 天 · 每档最多 2 集</p></div>
    {recent.length ? <div class="audio-recent-grid">{recent.map(({show_slug, episode, show_name}) => {
      const show = bySlug[show_slug];
      return show && <article class="audio-recent-card">
        <a class="audio-card-link" href={episodePath(show, episode, base)}>
          <div class="audio-card-media">
            {(episode.cover_url || show.feed?.cover_url) && <img onerror="this.hidden=true" class="audio-card-cover" src={episode.cover_url || show.feed.cover_url} alt={`${show_name} 官方封面`} loading="lazy" />}
            {episode.duration_display && <span class="audio-card-duration">{episode.duration_display}</span>}
          </div>
          <div class="audio-card-copy">
            <h3 class="audio-card-title">{episode.title}</h3>
            <p class="audio-card-show">{show_name}</p>
            <p class="audio-card-meta"><time datetime={episode.published_at_utc}>{episode.published_display}</time></p>
          </div>
        </a>
      </article>;
    })}</div> : <p class="audio-empty">最近 30 天内没有符合条件的更新。可以从下方节目目录浏览。</p>}
  </section>
  <section class="audio-preview-section audio-index-section audio-directory" aria-labelledby="shows-heading">
    <div class="audio-preview-section-head"><h2 id="shows-heading">节目目录</h2><p>{shows.length} 档 · 官方发布者 RSS</p></div>
    <div class="audio-show-grid">{shows.map(show => <a class="audio-show-card" href={showPath(show.slug, 1, base)}>
      <div class="audio-card-media">
        {show.feed?.cover_url && <img onerror="this.hidden=true" class="audio-card-cover" src={show.feed.cover_url} alt={`${show.display_name} 官方封面`} loading="lazy" />}
      </div>
      <div class="audio-card-copy"><h3 class="audio-card-title">{show.display_name}</h3><p class="audio-card-show audio-show-publisher">{show.publisher}</p><p class="audio-card-meta audio-show-count">{EPISODE_COUNT_LABEL} {show.episodes.length} 集</p>{!recent.some(item => item.show_slug === show.slug) && <p class="audio-card-meta audio-show-recent">近 30 天无入选</p>}</div>
    </a>)}</div>
  </section>
  <details class="audio-method"><summary>关于收录与来源</summary><p>元数据和单集说明来自发布者官方 RSS。近期精选仅展示最近 30 天内的更新，每档最多 2 集，按发布时间排序，不会用旧单集回填。目录数量指「当前公开RSS收录」，并非节目全部历史。音频使用官方 HTTPS enclosure，版权归原发布者所有。</p></details>
</AudioPodcastLayout>
