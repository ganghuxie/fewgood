---
import { SITE_NAME, SECTION_LABELS } from '../lib/brand.mjs';
import AuthMenu from './AuthMenu.astro';
const { active = 'trending', updatedAt = '' } = Astro.props;
const updatedDate = typeof updatedAt === 'number' && updatedAt < 1e12 ? updatedAt * 1000 : updatedAt;
const updated = updatedAt ? new Date(updatedDate).toLocaleTimeString('zh-CN', { timeZone: 'Asia/Shanghai', hour: '2-digit', minute: '2-digit', hour12: false }) : '';
const base = import.meta.env.BASE_URL;
const link = path => `${base.replace(/\/$/, '')}${path}`;
---
<header class="site-header">
  <div class="header-row">
    <button class="menu-toggle" type="button" aria-label="导览" aria-controls="site-sidebar" aria-expanded="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button>
    <a class="logo" href={link('/')} aria-label={`${SITE_NAME} 首页`} title="a few good videos · 无广告 · 只看好视频"><img class="logo-mark" src={`${base}logo-mark.svg`} alt=""/><span>{SITE_NAME}</span></a>
    <section class="mode-switch" data-header-mode-switch aria-label="内容模式"><button type="button" data-mode="myspace" aria-pressed="false">我的空间</button><button type="button" data-mode="explore" aria-pressed="true">探索世界</button></section>
    <form class="search" action={link('/search/')} role="search"><input name="q" type="search" placeholder="搜索精选池" aria-label="搜索精选池"/><button aria-label="搜索">⌕</button></form>
    <div class="library-cluster">
      <nav class="libraries" aria-label="个人视频库">
        <div class="lib-item" data-lib-kind="watchLater"><a class="lib-trigger" href={link('/watch-later/')} data-lib-trigger aria-label="稍后观看" title="稍后观看"><svg class="library-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 6v6l3.5 2"/><path d="M5.2 8.5A8 8 0 1 1 4 13"/><path d="M4 5v4h4"/></svg><b data-library-count="watchLater" hidden></b></a></div>
      </nav>
      <div class="lib-panel" data-panel hidden>
        <div class="lib-panel-scroll" data-panel-list></div>
        <a class="lib-panel-footer" data-panel-footer href={link('/watch-later/')}>查看全部</a>
      </div>
    </div>
    <AuthMenu />
  </div>
  <div class="chipbar"><nav aria-label="视频分类"><a class:list={{ active: active === 'picks' }} href={link('/')}>{SECTION_LABELS.picks}</a><a class:list={{ active: active === 'trending' }} href={link('/trending/')}>{SECTION_LABELS.trending}</a><a class:list={{ active: active === 'ai' }} href={link('/ai/')}>{SECTION_LABELS.ai}</a><a class:list={{ active: active === 'podcast' }} href={link('/podcast/')}>{SECTION_LABELS.podcast}</a><a class:list={{ active: active === 'audio-podcast' }} href={link('/audio-podcast/')}>音频播客</a><a class:list={{ active: active === 'music' }} href={link('/music/')}>{SECTION_LABELS.music}</a><a class:list={{ active: active === 'community' }} href={link('/community/')}>{SECTION_LABELS.community}</a></nav>{updated && <span class="chipbar-status">更新于 {updated}</span>}<button class="myspace-new" type="button" data-myspace-new>+ 新建栏目</button></div>
</header>
<style>
.library-cluster{position:relative;display:flex;align-items:center}
.lib-item[data-lib-kind="watchLater"]{display:block}
.libraries{display:flex;gap:8px;align-items:center}
.header-row{contain:layout}
.mode-switch{display:flex;gap:2px;padding:2px;border-radius:8px;background:#f2f2f2;flex:none}.mode-switch button{height:30px;border:0;border-radius:6px;padding:0 11px;background:transparent;font:600 13px inherit;cursor:pointer;color:#606060;white-space:nowrap}.mode-switch button[aria-pressed="true"]{background:#fff;color:#0f0f0f;box-shadow:0 1px 3px #0000001c}.chipbar-status{margin-left:auto;color:#8a8a8a;font-size:12px;white-space:nowrap}.myspace-new{display:none;margin-left:12px;border:0;background:none;color:#0f0f0f;font:500 13px inherit;white-space:nowrap;cursor:pointer}.myspace-new.visible{display:block}
:global(.site-header .mode-switch){margin-left:4px;width:max-content}
:global(.site-header .search){min-width:180px;max-width:640px;flex:1}
.lib-item{position:relative}
.lib-item[data-lib-kind="watchLater"]{min-width:30px}
.lib-trigger{position:relative;display:flex;flex-direction:column;align-items:center;gap:2px;font-size:13px;white-space:nowrap;padding:4px 8px;border-radius:10px;color:#0f0f0f;text-decoration:none}
.lib-trigger:hover{background:#f2f2f2}
:global(.lib-trigger b){position:absolute;top:-2px;right:0;min-width:17px;padding:1px 4px;border-radius:9px;background:#cc0000;color:#fff;font-size:10px;text-align:center}
:global(.lib-panel){position:fixed;top:64px;right:0;left:auto;z-index:40;width:400px;max-width:min(400px,calc(100vw - 16px));background:#fff;border:1px solid #e5e5e5;border-radius:12px;box-shadow:0 8px 28px #00000026;overflow:hidden}
:global(.lib-panel-scroll){max-height:70vh;overflow-y:auto;overflow-x:hidden;padding:8px 0}
:global(.lib-panel-footer){display:block;text-align:center;padding:12px;border-top:1px solid #eee;color:#0f0f0f;text-decoration:none;font-size:14px;font-weight:500;background:#fafafa}
:global(.lib-panel-footer:hover){background:#f2f2f2}
:global(.lib-empty){padding:28px 16px;text-align:center;color:#606060;font-size:14px}
:global(.lib-group){padding:8px 14px 4px;color:#606060;font-size:13px;font-weight:500}
:global(.lib-row){display:grid;grid-template-columns:140px minmax(0,1fr);gap:10px;padding:8px 14px;text-decoration:none;color:#0f0f0f}
:global(.lib-row:hover){background:#f2f2f2}
:global(.lib-thumb){position:relative;width:140px;height:79px;border-radius:8px;overflow:hidden;background:#eee}
:global(.lib-thumb img){width:100%;height:100%;object-fit:cover;display:block}
:global(.lib-thumb .dur){position:absolute;right:4px;bottom:4px;background:#0f0f0ee6;color:#fff;font-size:11px;padding:1px 4px;border-radius:3px;font-weight:600}
:global(.lib-thumb .bar){position:absolute;left:0;right:0;bottom:0;height:3px;background:#0004}
:global(.lib-thumb .bar i){display:block;height:100%;background:#f00;width:35%}
:global(.lib-row b){font-size:13px;line-height:18px;font-weight:500;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;margin:0 0 6px;color:#0f0f0f;background:none;position:static;min-width:0;padding:0;border-radius:0;text-align:left}
:global(.lib-row small){display:block;color:#606060;font-size:12px;line-height:16px}
@media(max-width:767px){:global(.lib-panel){display:none!important}:global(.site-header){padding-bottom:0}:global(.site-header .header-row){display:grid;grid-template-columns:auto minmax(0,1fr) auto auto;grid-template-areas:"menu logo library auth";height:52px;padding:8px;gap:6px;align-items:center;min-width:0}:global(.site-header .menu-toggle){grid-area:menu;width:36px}:global(.site-header .logo){grid-area:logo;min-width:0}:global(.site-header .logo > span:last-child){display:none}:global(.site-header .mode-switch){display:none}:global(.site-header .search){grid-column:1 / -1;width:calc(100% - 28px);max-width:none;margin:0 14px 8px;position:static!important}:global(.site-header .search input){height:36px}:global(.site-header .library-cluster){grid-area:library;margin:0;flex:none}:global(.site-header .libraries){gap:0}:global(.site-header .libraries .lib-trigger){padding:4px 3px}:global(.site-header .auth-menu){grid-area:auth}:global(.site-header .auth-login){height:34px;padding:0 7px;gap:4px;font-size:13px;white-space:nowrap}:global(.site-header .auth-login svg){width:18px;height:18px}}
</style>
<script>
  import { KEYS, list, updateBadges, markWatchLaterSeen } from '../scripts/library.js';
  import { track } from '../scripts/analytics.js';
  import { CARD_THUMB_SIZES, thumbFallbackAttr, thumbFor, thumbSrcset } from '../lib/format.mjs';
  updateBadges();
  window.addEventListener('storage', updateBadges);
  document.addEventListener('youtuber:library-change', updateBadges);

  const toggles = document.querySelectorAll('.menu-toggle');
  const backdrop = document.querySelector('.sidebar-backdrop');
  const paint = open => { document.body.classList.toggle('sidebar-open', open); document.body.classList.toggle('sidebar-collapsed', !open); toggles.forEach(button => button.setAttribute('aria-expanded', String(open))); };
  paint(false);
  toggles.forEach(button => button.addEventListener('click', () => paint(button.hasAttribute('data-sidebar-close') ? false : !document.body.classList.contains('sidebar-open'))));
  backdrop?.addEventListener('click', () => paint(false));
  document.addEventListener('keydown', event => { if (event.key === 'Escape') paint(false); });

  const base = (document.querySelector('main')?.dataset.base || '').replace(/\/$/, '');
  const esc = value => String(value || '').replace(/[&<>"]/g, char => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;' }[char]));
  const duration = n => `${Math.floor((n || 0) / 60)}:${String((n || 0) % 60).padStart(2, '0')}`;
  const startOfToday = () => { const d = new Date(); d.setHours(0, 0, 0, 0); return d.getTime(); };
  const metaTime = (item, kind) => {
    const ts = kind === 'history' ? item.watchedAt : item.saved_at;
    if (!ts) return '';
    const date = new Date(Number(ts));
    const sameDay = date.getTime() >= startOfToday();
    const hh = String(date.getHours()).padStart(2, '0');
    const mm = String(date.getMinutes()).padStart(2, '0');
    if (sameDay) return `今天 ${hh}:${mm}`;
    return `${date.getMonth() + 1}-${String(date.getDate()).padStart(2, '0')} ${hh}:${mm}`;
  };
  const emptyText = { watchLater: '稍后观看是空的' };
  const rowHtml = (item, kind) => {
    const bar = kind === 'history' ? '<span class="bar" aria-hidden="true"><i></i></span>' : '';
    return `<a class="lib-row" href="${base}/v/${esc(item.id)}/" data-id="${esc(item.id)}"><div class="lib-thumb"><img loading="lazy" src="${esc(thumbFor(item))}" srcset="${esc(thumbSrcset(item))}" sizes="${CARD_THUMB_SIZES}" ${thumbFallbackAttr(item.id)} alt=""><span class="dur">${duration(item.duration)}</span>${bar}</div><div><b>${esc(item.title || item.id)}</b><small>${esc(metaTime(item, kind))}</small><small>${esc(item.channel || '')}</small></div></a>`;
  };
  const renderPanel = (kind) => {
    const items = list(KEYS[kind]);
    const box = panel.querySelector('[data-panel-list]');
    if (!items.length) { box.innerHTML = `<p class="lib-empty">${emptyText[kind]}</p>`; return; }
    box.innerHTML = items.slice(0, 30).map(i => rowHtml(i, kind)).join('');
    if (kind === 'watchLater') {
      box.querySelectorAll('.lib-row[data-id]').forEach(node => {
        const mark = () => { if (markWatchLaterSeen(node.dataset.id)) updateBadges(); };
        node.addEventListener('mouseenter', mark, { once: true });
        node.addEventListener('focus', mark, { once: true });
        node.addEventListener('click', mark, { once: true });
      });
    }
  };

  const libraries = document.querySelector('.library-cluster');
  const panel = libraries?.querySelector('[data-panel]');
  const footer = panel?.querySelector('[data-panel-footer]');
  const mobile = () => matchMedia('(max-width: 767px)').matches;
  const paths = { watchLater: '/watch-later/' };
  let activeKind = 'watchLater'; let openTimer; let closeTimer;
  const setKind = kind => { activeKind = kind; footer.href = `${base}${paths[kind]}`; renderPanel(kind); };
  const open = kind => { clearTimeout(closeTimer); setKind(kind); panel.hidden = false; };
  const close = () => { clearTimeout(openTimer); panel.hidden = true; };
  const scheduleOpen = kind => { clearTimeout(closeTimer); clearTimeout(openTimer); openTimer = setTimeout(() => open(kind), 120); };
  const scheduleClose = () => { clearTimeout(openTimer); closeTimer = setTimeout(close, 220); };
  const libraryTrigger = libraries?.querySelector('[data-lib-trigger]');
  if (!mobile()) {
    libraries?.addEventListener('mouseenter', () => scheduleOpen('watchLater'));
  }
  panel?.addEventListener('mouseenter', () => clearTimeout(closeTimer));
  panel?.addEventListener('mouseleave', scheduleClose);
  libraries?.addEventListener('mouseleave', scheduleClose);
  document.addEventListener('click', event => { if (!panel?.hidden && libraries && !libraries.contains(event.target)) close(); });
</script>
