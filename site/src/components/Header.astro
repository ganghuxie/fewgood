---
import { SITE_NAME, SECTION_LABELS } from '../lib/brand.mjs';
import AuthMenu from './AuthMenu.astro';
const { active = 'trending', updatedAt = '' } = Astro.props;
const updatedDate = typeof updatedAt === 'number' && updatedAt < 1e12 ? updatedAt * 1000 : updatedAt;
const updated = updatedAt ? new Date(updatedDate).toLocaleTimeString('zh-CN', { timeZone: 'Asia/Shanghai', hour: '2-digit', minute: '2-digit', hour12: false }) : '';
const base = import.meta.env.BASE_URL;
const link = path => `${base.replace(/\/$/, '')}${path}`;
---
<header class="site-header" data-updated-at={updated || undefined}>
  <div class="header-row">
    <button class="menu-toggle" type="button" aria-label="导览" aria-controls="site-sidebar" aria-expanded="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button>
    <a class="logo" href={link('/')} aria-label={`${SITE_NAME} 首页`} title="a few good videos · 无广告 · 只看好视频"><img class="logo-mark" src={`${base}logo-mark.svg`} alt=""/><span>{SITE_NAME}</span></a>
    <section class="mode-switch" data-header-mode-switch aria-label="内容模式"><button type="button" data-mode="myspace" aria-pressed="false">我的空间</button><button type="button" data-mode="explore" aria-pressed="true">探索世界</button></section>
    <form class="search" action={link('/search/')} role="search"><input name="q" type="search" placeholder="搜索精选池" aria-label="搜索精选池"/><button aria-label="搜索">⌕</button></form>
    <div class="library-cluster">
      <nav class="libraries" aria-label="个人视频库">
        <div class="lib-item" data-lib-kind="watchLater"><a class="lib-trigger" href={link('/watch-later/')} data-lib-trigger aria-label="稍后观看" title="稍后观看"><svg class="library-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 6v6l3.5 2"/><path d="M5.2 8.5A8 8 0 1 1 4 13"/><path d="M4 5v4h4"/></svg><b data-library-count="watchLater" hidden></b></a></div>
      </nav>
      <div class="lib-panel" data-panel hidden>
        <div class="lib-panel-scroll" data-panel-list></div>
        <a class="lib-panel-footer" data-panel-footer href={link('/watch-later/')}>查看全部</a>
      </div>
    </div>
    <AuthMenu />
  </div>
  <div class="chipbar"><nav aria-label="视频分类"><a class:list={{ active: active === 'picks' }} href={link('/')}>{SECTION_LABELS.picks}</a><a class:list={{ active: active === 'trending' }} href={link('/trending/')}>{SECTION_LABELS.trending}</a><a class:list={{ active: active === 'ai' }} href={link('/ai/')}>{SECTION_LABELS.ai}</a><a class:list={{ active: active === 'podcast' }} href={link('/podcast/')}>{SECTION_LABELS.podcast}</a><a class:list={{ active: active === 'audio-podcast' }} href={link('/audio-podcast/')}>音频播客</a><a class:list={{ active: active === 'music' }} href={link('/music/')}>{SECTION_LABELS.music}</a><a class:list={{ active: active === 'community' }} href={link('/community/')}>{SECTION_LABELS.community}</a></nav><button class="myspace-new" type="button" data-myspace-new>+ 新建栏目</button></div>
</header>
<style>
.library-cluster{position:relative;display:flex;align-items:center}
.lib-item[data-lib-kind="watchLater"]{display:block}
.libraries{display:flex;gap:8px;align-items:center}
.header-row{contain:layout}
.mode-switch{display:flex;gap:2px;padding:2px;border-radius:8px;background:#f2f2f2;flex:none}.mode-switch button{height:36px;border:0;border-radius:6px;padding:0 14px;background:transparent;font:600 15px inherit;cursor:pointer;color:#606060;white-space:nowrap}.mode-switch button[aria-pressed="true"]{background:#fff;color:#0f0f0f;box-shadow:0 1px 3px #0000001c}.myspace-new{display:none;margin-left:12px;border:0;background:none;color:#0f0f0f;font:500 13px inherit;white-space:nowrap;cursor:pointer}.myspace-new.visible{display:block}
:global(.site-header .mode-switch){margin-left:0;width:max-content}
:global(.site-header .search){min-width:180px;max-width:640px;flex:1}
.lib-item{position:relative}
.lib-item[data-lib-kind="watchLater"]{min-width:30px}
.lib-trigger{position:relative;display:flex;flex-direction:column;align-items:center;gap:2px;font-size:13px;white-space:nowrap;padding:4px 8px;border-radius:10px;color:#0f0f0f;text-decoration:none}
.lib-trigger:hover{background:#f2f2f2}
:global(.lib-trigger b){position:absolute;top:-2px;right:0;min-width:17px;padding:1px 4px;border-radius:9px;background:#cc0000;color:#fff;font-size:10px;text-align:center}
:global(.lib-panel){position:fixed;top:var(--lib-panel-top,112px);right:0;left:auto;z-index:40;width:400px;max-width:min(400px,calc(100vw - 16px));background:#fff;border:1px solid #e5e5e5;border-radius:12px;box-shadow:0 8px 28px #00000026;overflow:hidden;pointer-events:auto}
:global(.lib-panel[hidden]){display:none!important;pointer-events:none!important}
:global(.lib-panel-scroll){max-height:70vh;overflow-y:auto;overflow-x:hidden;padding:8px 0}
:global(.lib-panel-footer){display:block;text-align:center;padding:12px;border-top:1px solid #eee;color:#0f0f0f;text-decoration:none;font-size:14px;font-weight:500;background:#fafafa}
:global(.lib-panel-footer:hover){background:#f2f2f2}
:global(.lib-empty){padding:28px 16px;text-align:center;color:#606060;font-size:14px}
:global(.lib-group){padding:8px 14px 4px;color:#606060;font-size:13px;font-weight:500}
:global(.lib-row){display:grid;grid-template-columns:140px minmax(0,1fr);gap:10px;padding:8px 14px;text-decoration:none;color:#0f0f0f}
:global(.lib-row:hover){background:#f2f2f2}
:global(.lib-thumb){position:relative;width:140px;height:79px;border-radius:8px;overflow:hidden;background:#eee}
:global(.lib-thumb img){width:100%;height:100%;object-fit:cover;display:block}
:global(.lib-thumb .dur){position:absolute;right:4px;bottom:4px;background:#0f0f0ee6;color:#fff;font-size:11px;padding:1px 4px;border-radius:3px;font-weight:600}
:global(.lib-thumb .bar){position:absolute;left:0;right:0;bottom:0;height:3px;background:#0004}
:global(.lib-thumb .bar i){display:block;height:100%;background:#f00;width:35%}
:global(.lib-row b){font-size:13px;line-height:18px;font-weight:500;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;margin:0 0 6px;color:#0f0f0f;background:none;position:static;min-width:0;padding:0;border-radius:0;text-align:left}
:global(.lib-row small){display:block;color:#606060;font-size:12px;line-height:16px}
@media(max-width:767px){:global(.lib-panel){display:none!important}:global(.site-header){padding-bottom:0}:global(.site-header .header-row){display:grid;grid-template-columns:auto auto minmax(72px,1fr) auto auto;grid-template-areas:"menu logo search library auth" "mode mode mode mode mode";height:auto;padding:8px;gap:6px;align-items:center;min-width:0}:global(.site-header .menu-toggle){grid-area:menu;width:36px}:global(.site-header .logo){grid-area:logo;min-width:0}:global(.site-header .logo > span:last-child){display:none}:global(.site-header .mode-switch){grid-area:mode;display:flex;margin:0;justify-self:start}:global(.site-header .search){grid-area:search;grid-column:auto;min-width:0;width:100%;max-width:none;margin:0;position:static!important}:global(.site-header .search input){height:34px;min-width:0;flex:1 1 auto;padding:0 9px;font-size:14px}:global(.site-header .search button){flex:0 0 34px;width:34px;min-width:34px;font-size:20px}:global(.site-header .library-cluster){grid-area:library;margin:0;flex:none}:global(.site-header .libraries){gap:0}:global(.site-header .libraries .lib-trigger){padding:4px 3px}:global(.site-header .auth-menu){grid-area:auth}:global(.site-header .auth-login){height:34px;padding:0 7px;gap:4px;font-size:13px;white-space:nowrap}:global(.site-header .auth-login svg){width:18px;height:18px}}
</style>
<style is:global>
html[data-theme="pale-green"]{color:#17221F;background:#D6F1E2}html[data-theme="pale-green"] body{background:#D6F1E2;color:#17221F}html[data-theme="pale-green"] main{background:transparent;color:#17221F}html[data-theme="pale-green"] .site-header,html[data-theme="pale-green"] .header-row,html[data-theme="pale-green"] .chipbar{background:#CDEDDB;color:#17221F;border-color:#A9D9BD}html[data-theme="pale-green"] .chipbar a,html[data-theme="pale-green"] .chipbar button,html[data-theme="pale-green"] .mode-switch{background:#C2E8D2;color:#17221F;border-color:#A9D9BD}html[data-theme="pale-green"] .chipbar a.active,html[data-theme="pale-green"] .chipbar button.active,html[data-theme="pale-green"] .mode-switch button[aria-pressed="true"],html[data-theme="pale-green"] .pagination [aria-current="page"],html[data-theme="pale-green"] .audio-pagination [aria-current]{background:#49C987;color:#17221F;border-color:#49C987}html[data-theme="pale-green"] .site-sidebar,html[data-theme="pale-green"] .lib-panel,html[data-theme="pale-green"] .auth-dialog,html[data-theme="pale-green"] .share-modal,html[data-theme="pale-green"] .audio-show-head,html[data-theme="pale-green"] .audio-back,html[data-theme="pale-green"] .audio-player,html[data-theme="pale-green"] .audio-playback-error,html[data-theme="pale-green"] .audio-picks-status,html[data-theme="pale-green"] .audio-empty,html[data-theme="pale-green"] .audio-missing-show,html[data-theme="pale-green"] .myspace-editor,html[data-theme="pale-green"] .myspace-editor-inner,html[data-theme="pale-green"] .auth-dropdown{background:#EAF8F0;color:#17221F;border-color:#A9D9BD}html[data-theme="pale-green"] .audio-preview{--paper:#EAF8F0;--surface:#EAF8F0;--ink:#17221F;--muted:#3E5D4D;--line:#A9D9BD;--accent:#23744E;background:#D6F1E2;color:#17221F}html[data-theme="pale-green"] .search input,html[data-theme="pale-green"] .search button,html[data-theme="pale-green"] .show-more,html[data-theme="pale-green"] .actions button,html[data-theme="pale-green"] .auth-login,html[data-theme="pale-green"] .auth-secondary,html[data-theme="pale-green"] .auth-dialog input,html[data-theme="pale-green"] .auth-google svg,html[data-theme="pale-green"] .myspace-manage,html[data-theme="pale-green"] .myspace-editor-close,html[data-theme="pale-green"] .myspace-row button,html[data-theme="pale-green"] .myspace-add select,html[data-theme="pale-green"] .share-scroll,html[data-theme="pale-green"] .share-qr,html[data-theme="pale-green"] .share-link,html[data-theme="pale-green"] .auth-dropdown button,html[data-theme="pale-green"] .lib-panel-footer{background:#EAF8F0;border-color:#A9D9BD;color:#17221F}html[data-theme="pale-green"] .site-header a,html[data-theme="pale-green"] .video-card .card-link,html[data-theme="pale-green"] .site-sidebar a,html[data-theme="pale-green"] .audio-card-link,html[data-theme="pale-green"] .audio-show-card,html[data-theme="pale-green"] .owner-name,html[data-theme="pale-green"] .owner-avatar,html[data-theme="pale-green"] .library-back{color:#17221F}html[data-theme="pale-green"] .site-footer,html[data-theme="pale-green"] .video-meta,html[data-theme="pale-green"] .search-note,html[data-theme="pale-green"] .search-summary,html[data-theme="pale-green"] .site-footer a,html[data-theme="pale-green"] .channel p,html[data-theme="pale-green"] .original-title,html[data-theme="pale-green"] .meta,html[data-theme="pale-green"] .yt-open,html[data-theme="pale-green"] .audio-card-show,html[data-theme="pale-green"] .audio-card-meta{color:#3E5D4D}html[data-theme="pale-green"] .site-footer{border-color:#A9D9BD}html[data-theme="pale-green"] .chipbar a:not(.active):hover,html[data-theme="pale-green"] .chipbar button:not(.active):hover,html[data-theme="pale-green"] .mode-switch button:not([aria-pressed="true"]):hover,html[data-theme="pale-green"] .site-sidebar .side-home:hover,html[data-theme="pale-green"] .site-sidebar .side-section:hover,html[data-theme="pale-green"] .site-sidebar .followed-item:hover,html[data-theme="pale-green"] .lib-row:hover,html[data-theme="pale-green"] .lib-trigger:hover,html[data-theme="pale-green"] .auth-login:hover,html[data-theme="pale-green"] .share-scroll:hover,html[data-theme="pale-green"] .myspace-manage:hover{background:#BEE6D0}html[data-theme="pale-green"] .site-sidebar .side-home.active,html[data-theme="pale-green"] .community-classic-badge,html[data-theme="pale-green"] .subscribe-btn.is-following,html[data-theme="pale-green"] .youtube{background:#C2E8D2;color:#17221F;border-color:#A9D9BD}html[data-theme="pale-green"] .subscribe-btn{background:#17221F;color:#EAF8F0}html[data-theme="pale-green"] .auth-primary,html[data-theme="pale-green"] .share-copy.is-copied{background:#49C987;color:#17221F}html[data-theme="pale-green"] .auth-forgot,html[data-theme="pale-green"] .seek,html[data-theme="pale-green"] .why-good,html[data-theme="pale-green"] .yt-open:hover{color:#23744E}html[data-theme="pale-green"] .auth-fields{border-color:#A9D9BD}html[data-theme="pale-green"] .auth-other-divider::before,html[data-theme="pale-green"] .auth-other-divider::after{background:#A9D9BD}html[data-theme="pale-green"] .new-dot{background:#23744E}html[data-theme="pale-green"] .thumbnail,html[data-theme="pale-green"] .sr-thumbnail,html[data-theme="pale-green"] .audio-card-media{background:#C2E8D2}
</style>
<script>
  import { KEYS, list, watchLaterItems, updateBadges, markWatchLaterSeen } from '../scripts/library.js';
  import { track } from '../scripts/analytics.js';
  import { CARD_THUMB_SIZES, thumbFallbackAttr, thumbFor, thumbSrcset } from '../lib/format.mjs';
  updateBadges();
  window.addEventListener('storage', updateBadges);
  document.addEventListener('youtuber:library-change', updateBadges);

  const toggles = document.querySelectorAll('.menu-toggle');
  const backdrop = document.querySelector('.sidebar-backdrop');
  const paint = open => { document.body.classList.toggle('sidebar-open', open); document.body.classList.toggle('sidebar-collapsed', !open); toggles.forEach(button => button.setAttribute('aria-expanded', String(open))); };
  paint(false);
  toggles.forEach(button => button.addEventListener('click', () => paint(button.hasAttribute('data-sidebar-close') ? false : !document.body.classList.contains('sidebar-open'))));
  backdrop?.addEventListener('click', () => paint(false));
  document.addEventListener('keydown', event => { if (event.key === 'Escape') paint(false); });

  const base = (document.querySelector('main')?.dataset.base || '').replace(/\/$/, '');
  const esc = value => String(value || '').replace(/[&<>"]/g, char => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;' }[char]));
  const duration = n => `${Math.floor((n || 0) / 60)}:${String((n || 0) % 60).padStart(2, '0')}`;
  const startOfToday = () => { const d = new Date(); d.setHours(0, 0, 0, 0); return d.getTime(); };
  const metaTime = (item, kind) => {
    const ts = kind === 'history' ? item.watchedAt : item.saved_at;
    if (!ts) return '';
    const date = new Date(Number(ts));
    const sameDay = date.getTime() >= startOfToday();
    const hh = String(date.getHours()).padStart(2, '0');
    const mm = String(date.getMinutes()).padStart(2, '0');
    if (sameDay) return `今天 ${hh}:${mm}`;
    return `${date.getMonth() + 1}-${String(date.getDate()).padStart(2, '0')} ${hh}:${mm}`;
  };
  const emptyText = { watchLater: '稍后观看是空的' };
  const renderable = item => item?.id !== undefined && item?.id !== null && String(item.id).trim() !== '';
  const rowHtml = (item, kind) => {
    const bar = kind === 'history' ? '<span class="bar" aria-hidden="true"><i></i></span>' : '';
    return `<a class="lib-row" href="${base}/v/${encodeURIComponent(item.id)}/" data-id="${esc(item.id)}"><div class="lib-thumb"><img loading="lazy" src="${esc(thumbFor(item))}" srcset="${esc(thumbSrcset(item))}" sizes="${CARD_THUMB_SIZES}" ${thumbFallbackAttr(item.id)} alt=""><span class="dur">${duration(item.duration)}</span>${bar}</div><div><b>${esc(item.title || item.id)}</b><small>${esc(metaTime(item, kind))}</small><small>${esc(item.channel || '')}</small></div></a>`;
  };
  const renderPanel = (kind) => {
    const items = (kind === 'watchLater' ? watchLaterItems() : list(KEYS[kind])).filter(renderable);
    const box = panel.querySelector('[data-panel-list]');
    if (!items.length) { box.innerHTML = `<p class="lib-empty">${emptyText[kind]}</p>`; return; }
    box.innerHTML = items.slice(0, 30).map(i => rowHtml(i, kind)).join('');
    if (kind === 'watchLater') {
      box.querySelectorAll('.lib-row[data-id]').forEach(node => {
        const mark = () => { if (markWatchLaterSeen(node.dataset.id)) updateBadges(); };
        node.addEventListener('mouseenter', mark, { once: true });
        node.addEventListener('focus', mark, { once: true });
        node.addEventListener('click', mark, { once: true });
      });
    }
  };

  const libraries = document.querySelector('.library-cluster');
  const panel = libraries?.querySelector('[data-panel]');
  const footer = panel?.querySelector('[data-panel-footer]');
  const chipbar = document.querySelector('.site-header .chipbar');
  const mobile = () => matchMedia('(max-width: 767px)').matches;
  const paths = { watchLater: '/watch-later/' };
  let activeKind = 'watchLater'; let openTimer; let closeTimer;
  const setKind = kind => { activeKind = kind; footer.href = `${base}${paths[kind]}`; renderPanel(kind); };
  const positionPanel = () => {
    if (!libraries || !panel) return;
    const anchor = Math.max(libraries.getBoundingClientRect().bottom, chipbar?.getBoundingClientRect().bottom || 0);
    panel.style.setProperty('--lib-panel-top', `${Math.max(0, Math.round(anchor + 8))}px`);
  };
  const open = kind => { clearTimeout(closeTimer); positionPanel(); setKind(kind); panel.hidden = false; };
  const close = () => { clearTimeout(openTimer); panel.hidden = true; };
  const scheduleOpen = kind => { clearTimeout(closeTimer); clearTimeout(openTimer); openTimer = setTimeout(() => open(kind), 120); };
  const scheduleClose = () => { clearTimeout(openTimer); closeTimer = setTimeout(close, 220); };
  const libraryTrigger = libraries?.querySelector('[data-lib-trigger]');
  if (!mobile()) {
    libraries?.addEventListener('mouseenter', () => scheduleOpen('watchLater'));
  }
  window.addEventListener('resize', positionPanel);
  window.addEventListener('scroll', () => { if (!panel?.hidden) positionPanel(); }, { passive: true });
  panel?.addEventListener('mouseenter', () => clearTimeout(closeTimer));
  panel?.addEventListener('mouseleave', scheduleClose);
  libraries?.addEventListener('mouseleave', scheduleClose);
  document.addEventListener('click', event => { if (!panel?.hidden && libraries && !libraries.contains(event.target)) close(); });

  const searchInput = document.querySelector('.site-header .search input');
  const compactSearch = matchMedia('(max-width: 767px)');
  const paintSearchPlaceholder = () => { if (searchInput) searchInput.placeholder = compactSearch.matches ? '搜索' : '搜索精选池'; };
  paintSearchPlaceholder();
  compactSearch.addEventListener('change', paintSearchPlaceholder);
</script>
