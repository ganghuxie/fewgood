---
import Layout from './Layout.astro';
import { SITE_NAME } from '../lib/brand.mjs';
const { kind, title, empty } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Layout title={`${title} · ${SITE_NAME}`}><section class="library-page" data-kind={kind} data-base={base}><div class="library-heading"><h1>{title}</h1>{kind === 'history' && <button class="clear" data-clear>清空历史</button>}</div><p class="empty" data-empty>{empty}</p><div class="video-grid library-list" data-list></div></section></Layout>
<script>
 import { KEYS, get, ids, set } from '../scripts/library.js';
 const root = document.querySelector('[data-kind]'), kind = root.dataset.kind, key = KEYS[kind], base = root.dataset.base;
 const list = root.querySelector('[data-list]'), empty = root.querySelector('[data-empty]');
 const duration = n => `${Math.floor((n || 0) / 60)}:${String((n || 0) % 60).padStart(2, '0')}`;
 const esc = value => String(value || '').replace(/[&<>"]/g, char => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;' }[char]));
 const avatar = (channel, name) => { const title = channel?.title || name || '频道'; const letter = [...title.trim()][0] || '频'; let hash = 0; for (const character of title) hash = (hash * 31 + character.codePointAt(0)) >>> 0; const color = ['#d14b4b', '#b06b2f', '#8a6d1d', '#4f8a3d', '#357a8a', '#5367a6', '#7a5795'][hash % 7]; return channel?.thumbnail ? `<img class="channel-avatar" src="${esc(channel.thumbnail)}" alt="">` : `<span class="channel-avatar channel-avatar-letter" style="background-color:${color}" aria-hidden="true">${esc(letter)}</span>`; };
 const render = (catalog, channelData) => { const map = new Map(catalog.map(video => [video.id, video])); const channels = Object.fromEntries((channelData.channels || []).map(channel => [channel.id, channel])); const videos = ids(key).map(id => map.get(id)).filter(Boolean); empty.hidden = videos.length > 0; list.innerHTML = videos.map(video => `<article class="video-card"><a href="${base}/v/${video.id}/?from=${video.section}"><div class="thumbnail"><img src="https://i.ytimg.com/vi/${video.id}/hqdefault.jpg" alt=""><span class="duration">${duration(video.duration_seconds)}</span></div></a><div class="video-info">${avatar(channels[video.channel_id], video.channel)}<div><a class="video-title" href="${base}/v/${video.id}/?from=${video.section}">${esc(video.title)}</a><p class="video-meta">${esc(video.channel)}</p></div></div><button aria-label="移除" data-remove="${video.id}">×</button></article>`).join(''); list.querySelectorAll('[data-remove]').forEach(button => button.onclick = () => { set(key, get(key).filter(item => (typeof item === 'string' ? item : item.id) !== button.dataset.remove)); render(catalog, channelData); }); };
 Promise.all([fetch(`${base}/catalog.json`).then(response => response.json()), fetch(`${base}/channels.json`).then(response => response.json())]).then(([catalog, channelData]) => render(catalog, channelData)).catch(() => { empty.textContent = '视频目录暂时无法加载。'; });
 root.querySelector('[data-clear]')?.addEventListener('click', () => { set(key, []); list.innerHTML = ''; empty.hidden = false; });
</script>
<style>
.library-heading{display:flex;align-items:center;justify-content:space-between;margin-bottom:20px}.library-heading h1{font-size:26px;margin:0}.clear{border:0;background:#f2f2f2;border-radius:18px;padding:9px 14px;cursor:pointer}.empty{color:#606060;padding:36px 0;text-align:center}.library-list article{position:relative}.library-list button{position:absolute;right:7px;top:calc(56.25% - 30px);border:0;background:#0f0f0fcc;color:#fff;width:26px;height:26px;border-radius:50%;font-size:20px;line-height:20px;cursor:pointer}
</style>
