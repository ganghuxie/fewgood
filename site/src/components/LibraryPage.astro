---
import Layout from './Layout.astro';
import { SITE_NAME } from '../lib/brand.mjs';
const { kind, title, empty } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Layout title={`${title} · ${SITE_NAME}`}><section class="library-page" data-kind={kind} data-base={base}><div class="library-heading"><h1>{title}</h1>{kind === 'history' && <button class="clear" data-clear>清空历史</button>}</div><p class="empty" data-empty>{empty}</p><div class="library-list" data-list></div></section></Layout>
<script>
 import { KEYS, get, ids, set } from '../scripts/library.js';
 const root = document.querySelector('[data-kind]'), kind = root.dataset.kind, key = KEYS[kind], base = root.dataset.base;
 const list = root.querySelector('[data-list]'), empty = root.querySelector('[data-empty]');
 const duration = n => `${Math.floor((n || 0) / 60)}:${String((n || 0) % 60).padStart(2, '0')}`;
 const esc = value => String(value || '').replace(/[&<>"]/g, char => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;' }[char]));
 const render = catalog => { const map = new Map(catalog.map(video => [video.id, video])); const videos = ids(key).map(id => map.get(id)).filter(Boolean); empty.hidden = videos.length > 0; list.innerHTML = videos.map(video => `<article><a href="${base}/v/${video.id}/?from=${video.section}"><img src="https://i.ytimg.com/vi/${video.id}/mqdefault.jpg" alt=""></a><div><a class="title" href="${base}/v/${video.id}/?from=${video.section}">${esc(video.title)}</a><p>${esc(video.channel)} · ${duration(video.duration_seconds)}</p></div><button data-remove="${video.id}">移除</button></article>`).join(''); list.querySelectorAll('[data-remove]').forEach(button => button.onclick = () => { set(key, get(key).filter(item => (typeof item === 'string' ? item : item.id) !== button.dataset.remove)); render(catalog); }); };
 fetch(`${base}/catalog.json`).then(response => response.json()).then(render).catch(() => { empty.textContent = '视频目录暂时无法加载。'; });
 root.querySelector('[data-clear]')?.addEventListener('click', () => { set(key, []); list.innerHTML = ''; empty.hidden = false; });
</script>
<style>
.library-page{max-width:900px;margin:auto}.library-heading{display:flex;align-items:center;justify-content:space-between;margin-bottom:20px}.library-heading h1{font-size:26px;margin:0}.clear{border:0;background:#f2f2f2;border-radius:18px;padding:9px 14px;cursor:pointer}.empty{color:#606060;padding:36px 0;text-align:center}.library-list{display:grid;gap:12px}.library-list article{display:grid;grid-template-columns:168px 1fr auto;gap:14px;align-items:center}.library-list img{display:block;width:168px;aspect-ratio:16/9;object-fit:cover;border-radius:8px}.library-list .title{font-weight:600;line-height:1.4;text-decoration:none}.library-list p{color:#606060;font-size:13px}.library-list button{border:0;background:#f2f2f2;padding:8px 11px;border-radius:16px;cursor:pointer}@media(max-width:600px){.library-list article{grid-template-columns:120px 1fr}.library-list img{width:120px}.library-list button{grid-column:2;justify-self:start}}
</style>
