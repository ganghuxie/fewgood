<div class="auth-menu" data-auth-menu hidden>
  <button class="auth-login" type="button" data-auth-open><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4.5 21a7.5 7.5 0 0 1 15 0"/></svg><span>登录/注册</span></button>
  <div class="auth-user" hidden>
    <button class="auth-avatar" type="button" aria-label="账户菜单" aria-expanded="false"></button>
    <div class="auth-dropdown" hidden><small data-auth-email></small><button type="button" data-auth-signout>退出登录</button></div>
  </div>
  <div class="auth-backdrop" data-auth-close hidden></div>
  <section class="auth-dialog" role="dialog" aria-modal="true" aria-labelledby="auth-title" hidden>
    <button class="auth-x" type="button" aria-label="关闭" data-auth-close>×</button>
    <h2 id="auth-title">登录 YouTuber</h2>
    <form class="auth-form" data-auth-form>
      <div class="auth-fields"><label><span>账号</span><input name="email" type="email" autocomplete="email" placeholder="请输入邮箱" required></label><label><span>密码</span><input name="password" type="password" autocomplete="current-password" minlength="6" placeholder="请输入密码" required><button class="auth-forgot" type="button" data-auth-forgot>忘记密码？</button></label></div>
      <p class="auth-message" aria-live="polite"></p>
      <div class="auth-actions"><button class="auth-secondary" type="submit" data-auth-action="signup">注册</button><button class="auth-primary" type="submit" data-auth-action="login">登录</button></div>
    </form>
    <form class="auth-recovery" data-auth-recovery-form hidden><label><span>新密码</span><input name="new-password" type="password" autocomplete="new-password" minlength="6" placeholder="请输入新密码" required></label><label><span>确认密码</span><input name="confirm-password" type="password" autocomplete="new-password" minlength="6" placeholder="请再次输入新密码" required></label><button class="auth-primary" type="submit">保存新密码</button></form>
    {import.meta.env.PUBLIC_AUTH_OAUTH === 'true' && <div class="auth-other"><div class="auth-other-divider">其他方式登录</div><button class="auth-google" type="button" data-auth-oauth="google" aria-label="使用 Google 登录"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M21.35 12.23c0-.72-.06-1.42-.18-2.09H12v3.96h5.24a4.48 4.48 0 0 1-1.94 2.94v2.45h3.14c1.84-1.7 2.91-4.2 2.91-7.26Z"/><path fill="#34A853" d="M12 21.5c2.63 0 4.84-.87 6.46-2.36l-3.14-2.45c-.87.58-1.98.92-3.32.92-2.55 0-4.71-1.72-5.49-4.03H3.27v2.53A9.75 9.75 0 0 0 12 21.5Z"/><path fill="#FBBC05" d="M6.51 13.58A5.86 5.86 0 0 1 6.2 12c0-.55.11-1.08.31-1.58V7.89H3.27A9.75 9.75 0 0 0 2.25 12c0 1.57.38 3.05 1.02 4.11l3.24-2.53Z"/><path fill="#EA4335" d="M12 6.39c1.43 0 2.71.49 3.72 1.45l2.79-2.79C16.84 3.46 14.63 2.5 12 2.5a9.75 9.75 0 0 0-8.73 5.39l3.24 2.53C6.29 8.11 8.45 6.39 12 6.39Z"/></svg><span>Google</span></button></div>}
  </section>
</div>
<style>
.auth-menu{display:flex;align-items:center}:global(.auth-menu[hidden]),:global(.auth-menu [hidden]){display:none !important}.auth-login{height:36px;padding:0 13px;border:1px solid #ccc;border-radius:18px;background:#fff;color:#065fd4;display:flex;align-items:center;gap:7px;font:500 14px inherit;cursor:pointer}.auth-login:hover{background:#f2f7ff}.auth-login svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.8}.auth-user{position:relative}.auth-avatar{width:32px;height:32px;border:0;border-radius:50%;background:#6b59c7;color:#fff;font-weight:600;cursor:pointer}.auth-dropdown{position:absolute;right:0;top:42px;width:210px;padding:10px 0;background:#fff;border:1px solid #ddd;border-radius:10px;box-shadow:0 8px 24px #0002;z-index:60}.auth-dropdown small{display:block;padding:4px 14px 10px;color:#606060;overflow:hidden;text-overflow:ellipsis}.auth-dropdown button{width:100%;border:0;background:#fff;padding:10px 14px;text-align:left;font:inherit;cursor:pointer}.auth-dropdown button:hover{background:#f2f2f2}.auth-backdrop{position:fixed;inset:0;background:#0008;z-index:70}.auth-dialog{position:fixed;z-index:71;top:50%;left:50%;width:min(400px,calc(100vw - 32px));transform:translate(-50%,-50%);padding:28px;background:#fff;border-radius:12px;box-shadow:0 16px 48px #0004}.auth-dialog h2{margin:0 0 20px;font-size:21px}.auth-x{position:absolute;right:12px;top:9px;border:0;background:none;font-size:27px;color:#606060;cursor:pointer}.auth-fields{border:1px solid #d9d9d9;border-radius:6px;padding:0 14px}.auth-dialog label{position:relative;display:block;margin:0;padding:13px 0;font-size:13px;color:#606060}.auth-fields label+label{border-top:1px solid #e5e5e5}.auth-dialog label>span{display:block;margin-bottom:5px}.auth-dialog input{display:block;width:100%;height:36px;border:1px solid #bbb;border-radius:4px;padding:0 10px;font:16px inherit;box-sizing:border-box}.auth-forgot{position:absolute;right:0;bottom:17px;border:0;background:none;color:#065fd4;font:13px inherit;cursor:pointer}.auth-actions{display:flex;gap:10px}.auth-primary,.auth-secondary{flex:1;height:40px;border-radius:20px;font:500 15px inherit;cursor:pointer}.auth-primary{border:0;background:#065fd4;color:#fff}.auth-secondary{border:1px solid #bbb;background:#fff;color:#333}.auth-recovery label{margin-bottom:8px}.auth-recovery .auth-primary{margin-top:8px}.auth-other{margin-top:22px;text-align:center}.auth-other-divider{display:flex;align-items:center;gap:10px;color:#999;font-size:12px}.auth-other-divider::before,.auth-other-divider::after{content:"";height:1px;flex:1;background:#e5e5e5}.auth-google{display:inline-flex;flex-direction:column;align-items:center;gap:5px;margin-top:12px;border:0;background:none;color:#606060;font:12px inherit;cursor:pointer}.auth-google svg{width:34px;height:34px;padding:7px;border:1px solid #ddd;border-radius:50%;box-sizing:border-box;background:#fff}.auth-message{min-height:18px;margin:10px 0;color:#d93025;font-size:13px}.auth-message.success{color:#188038}
</style>
<script>
  import { emailRedirectTo, getSupabase, supabaseEnabled } from '../scripts/supabase.js';
  import { startSync } from '../scripts/sync.js';
  import { identify, reset, track } from '../scripts/analytics.js';
  const root = document.querySelector('[data-auth-menu]');
  if (supabaseEnabled && root) {
    root.hidden = false;
    const db = getSupabase(), login = root.querySelector('[data-auth-open]'), user = root.querySelector('.auth-user'), dialog = root.querySelector('.auth-dialog'), backdrop = root.querySelector('.auth-backdrop'), message = root.querySelector('.auth-message'), form = root.querySelector('[data-auth-form]'), recoveryForm = root.querySelector('[data-auth-recovery-form]'), title = root.querySelector('#auth-title');
    let pendingOAuthMethod = null;
    let recoveryMode = false;
    const show = (open, recovery = false) => { recoveryMode = open && recovery; dialog.hidden = !open; backdrop.hidden = !open; form.hidden = recoveryMode; recoveryForm.hidden = !recoveryMode; title.textContent = recoveryMode ? '设置新密码' : '登录 YouTuber'; if (open) (recoveryMode ? recoveryForm : form).querySelector('input')?.focus(); };
    const setMessage = (text, success = false) => { message.textContent = text; message.className = `auth-message${success ? ' success' : ''}`; };
    const friendlyError = error => { const original = error?.message || ''; const text = original.toLowerCase(); if (text.includes('invalid login credentials')) return '邮箱或密码不对；如果之前用 Google 登录过，请用 Google 登录或点“忘记密码”设置密码'; if (text.includes('user already registered')) return '这个邮箱已注册，请直接登录或点“忘记密码”'; if (text.includes('password') && (text.includes('6') || text.includes('short') || text.includes('weak'))) return '密码至少 6 位'; if (text.includes('email') && (text.includes('invalid') || text.includes('valid'))) return '邮箱格式不正确'; if (text.includes('rate limit') || text.includes('too many')) return '发信太频繁，请稍后再试'; return original; };
    const paint = session => { const email = session?.user?.email; login.hidden = !!email; user.hidden = !email; if (email) { user.querySelector('.auth-avatar').textContent = email[0].toUpperCase(); user.querySelector('[data-auth-email]').textContent = email; } };
    login.addEventListener('click', () => show(true)); root.querySelectorAll('[data-auth-close]').forEach(button => button.addEventListener('click', () => show(false)));
    document.addEventListener('keydown', event => { if (event.key === 'Escape') show(false); });
    form.addEventListener('submit', async event => { event.preventDefault(); const values = new FormData(event.currentTarget), email = values.get('email'), password = values.get('password'), mode = event.submitter?.dataset.authAction || 'login'; setMessage(''); const result = mode === 'login' ? await db.auth.signInWithPassword({ email, password }) : await db.auth.signUp({ email, password, options: { emailRedirectTo: emailRedirectTo() } }); if (result.error) { setMessage(friendlyError(result.error)); return; } if (mode === 'signup' && result.data?.user?.identities && result.data.user.identities.length === 0) { setMessage('这个邮箱已注册，请直接登录或点“忘记密码”'); return; } track(mode === 'login' ? 'login' : 'signup', { method: 'password' }); if (result.data?.session) { setMessage(mode === 'login' ? '登录成功' : '注册成功', true); show(false); } else if (mode === 'signup') setMessage('注册成功，请查收确认邮件', true); else { setMessage('登录成功', true); show(false); } });
    root.querySelector('[data-auth-forgot]').addEventListener('click', async () => { const email = root.querySelector('[name=email]').value.trim(); if (!email) { setMessage('请先填写邮箱'); return; } const { error } = await db.auth.resetPasswordForEmail(email, { redirectTo: new URL(import.meta.env.BASE_URL, location.origin).href }); if (error) setMessage(friendlyError(error)); else setMessage('重置密码邮件已发送，请去邮箱点击链接', true); });
    recoveryForm.addEventListener('submit', async event => { event.preventDefault(); const values = new FormData(event.currentTarget), password = values.get('new-password'), confirm = values.get('confirm-password'); if (password !== confirm) { setMessage('两次输入的密码不一致'); return; } const { error } = await db.auth.updateUser({ password }); if (error) { setMessage(friendlyError(error)); return; } setMessage('密码已更新', true); setTimeout(() => show(false), 700); });
    root.querySelectorAll('[data-auth-oauth]').forEach(button => button.addEventListener('click', () => { pendingOAuthMethod = button.dataset.authOauth; return db.auth.signInWithOAuth({ provider: button.dataset.authOauth, options: { redirectTo: emailRedirectTo() } }); }));
    user.querySelector('.auth-avatar').addEventListener('click', () => { const menu = user.querySelector('.auth-dropdown'); menu.hidden = !menu.hidden; });
    root.querySelector('[data-auth-signout]').addEventListener('click', () => db.auth.signOut());
    try { startSync(); } catch (error) { console.warn('Auth sync failed to start', error); }
    db.auth.getSession().then(({ data }) => { paint(data.session); if (data.session) identify(data.session.user.id); }); db.auth.onAuthStateChange((event, session) => { paint(session); if (event === 'PASSWORD_RECOVERY') show(true, true); if (session) { identify(session.user.id); if (event === 'SIGNED_IN' && pendingOAuthMethod) { track('login', { method: pendingOAuthMethod }); pendingOAuthMethod = null; } } if (event === 'SIGNED_OUT') reset(); });
  }
</script>
