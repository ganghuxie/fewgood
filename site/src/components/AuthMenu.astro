<div class="auth-menu" data-auth-menu hidden>
  <button class="auth-login" type="button" data-auth-open><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4.5 21a7.5 7.5 0 0 1 15 0"/></svg><span>登录</span></button>
  <div class="auth-user" hidden>
    <button class="auth-avatar" type="button" aria-label="账户菜单" aria-expanded="false"></button>
    <div class="auth-dropdown" hidden><small data-auth-email></small><button type="button" data-auth-signout>退出登录</button></div>
  </div>
  <div class="auth-backdrop" data-auth-close hidden></div>
  <section class="auth-dialog" role="dialog" aria-modal="true" aria-labelledby="auth-title" hidden>
    <button class="auth-x" type="button" aria-label="关闭" data-auth-close>×</button>
    <h2 id="auth-title">登录 YouTuber</h2>
    {import.meta.env.PUBLIC_AUTH_OAUTH === 'true' && <>
      <div class="auth-oauth"><button type="button" data-auth-oauth="google"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M21.35 12.23c0-.72-.06-1.42-.18-2.09H12v3.96h5.24a4.48 4.48 0 0 1-1.94 2.94v2.45h3.14c1.84-1.7 2.91-4.2 2.91-7.26Z"/><path fill="#34A853" d="M12 21.5c2.63 0 4.84-.87 6.46-2.36l-3.14-2.45c-.87.58-1.98.92-3.32.92-2.55 0-4.71-1.72-5.49-4.03H3.27v2.53A9.75 9.75 0 0 0 12 21.5Z"/><path fill="#FBBC05" d="M6.51 13.58A5.86 5.86 0 0 1 6.2 12c0-.55.11-1.08.31-1.58V7.89H3.27A9.75 9.75 0 0 0 2.25 12c0 1.57.38 3.05 1.02 4.11l3.24-2.53Z"/><path fill="#EA4335" d="M12 6.39c1.43 0 2.71.49 3.72 1.45l2.79-2.79C16.84 3.46 14.63 2.5 12 2.5a9.75 9.75 0 0 0-8.73 5.39l3.24 2.53C6.29 8.11 8.45 6.39 12 6.39Z"/></svg><span>使用 Google 登录</span></button></div>
      <div class="auth-divider"><span>或</span></div>
    </>}
    <div class="auth-tabs"><button type="button" class="active" data-auth-mode="login">登录</button><button type="button" data-auth-mode="signup">注册</button></div>
    <form data-auth-form><label>邮箱<input name="email" type="email" autocomplete="email" required></label><label>密码<input name="password" type="password" autocomplete="current-password" minlength="6" required></label><p class="auth-message" aria-live="polite"></p><button class="auth-primary" type="submit">登录</button></form>
    <button class="auth-link" type="button" data-auth-magic>发送登录链接（免密码）</button>
  </section>
</div>
<style>
.auth-menu{display:flex;align-items:center}:global(.auth-menu[hidden]),:global(.auth-menu [hidden]){display:none !important}.auth-login{height:36px;padding:0 13px;border:1px solid #ccc;border-radius:18px;background:#fff;color:#065fd4;display:flex;align-items:center;gap:7px;font:500 14px inherit;cursor:pointer}.auth-login:hover{background:#f2f7ff}.auth-login svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.8}.auth-user{position:relative}.auth-avatar{width:32px;height:32px;border:0;border-radius:50%;background:#6b59c7;color:#fff;font-weight:600;cursor:pointer}.auth-dropdown{position:absolute;right:0;top:42px;width:210px;padding:10px 0;background:#fff;border:1px solid #ddd;border-radius:10px;box-shadow:0 8px 24px #0002;z-index:60}.auth-dropdown small{display:block;padding:4px 14px 10px;color:#606060;overflow:hidden;text-overflow:ellipsis}.auth-dropdown button{width:100%;border:0;background:#fff;padding:10px 14px;text-align:left;font:inherit;cursor:pointer}.auth-dropdown button:hover{background:#f2f2f2}.auth-backdrop{position:fixed;inset:0;background:#0008;z-index:70}.auth-dialog{position:fixed;z-index:71;top:50%;left:50%;width:min(400px,calc(100vw - 32px));transform:translate(-50%,-50%);padding:28px;background:#fff;border-radius:12px;box-shadow:0 16px 48px #0004}.auth-dialog h2{margin:0 0 20px;font-size:21px}.auth-x{position:absolute;right:12px;top:9px;border:0;background:none;font-size:27px;color:#606060;cursor:pointer}.auth-oauth{display:grid;gap:8px;margin-bottom:16px}.auth-oauth button{display:flex;align-items:center;justify-content:center;gap:9px;width:100%;height:42px;border:1px solid #ccc;border-radius:21px;background:#fff;font:500 15px inherit;cursor:pointer}.auth-oauth button:hover{background:#f8f8f8}.auth-oauth svg{width:18px;height:18px}.auth-divider{display:flex;align-items:center;gap:10px;margin:0 0 16px;color:#777;font-size:13px}.auth-divider::before,.auth-divider::after{content:"";height:1px;flex:1;background:#e5e5e5}.auth-tabs{display:flex;border-bottom:1px solid #ddd;margin-bottom:16px}.auth-tabs button{flex:1;border:0;border-bottom:2px solid transparent;background:none;padding:9px;font:inherit;cursor:pointer}.auth-tabs button.active{border-color:#065fd4;color:#065fd4;font-weight:600}.auth-dialog label{display:block;margin:12px 0;font-size:13px;color:#606060}.auth-dialog input{display:block;width:100%;height:40px;margin-top:5px;border:1px solid #bbb;border-radius:6px;padding:0 10px;font:16px inherit}.auth-primary{width:100%;height:40px;border:0;border-radius:20px;background:#065fd4;color:#fff;font:500 15px inherit;cursor:pointer}.auth-link{display:block;margin:14px auto 0;border:0;background:none;color:#065fd4;font:inherit;cursor:pointer}.auth-message{min-height:18px;margin:4px 0 10px;color:#d93025;font-size:13px}.auth-message.success{color:#188038}
</style>
<script>
  import { emailRedirectTo, getSupabase, supabaseEnabled } from '../scripts/supabase.js';
  import { startSync } from '../scripts/sync.js';
  import { identify, reset, track } from '../scripts/analytics.js';
  const root = document.querySelector('[data-auth-menu]');
  if (supabaseEnabled && root) {
    root.hidden = false;
    const db = getSupabase(), login = root.querySelector('[data-auth-open]'), user = root.querySelector('.auth-user'), dialog = root.querySelector('.auth-dialog'), backdrop = root.querySelector('.auth-backdrop'), message = root.querySelector('.auth-message');
    let pendingOAuthMethod = null;
    let mode = 'login';
    const show = open => { dialog.hidden = !open; backdrop.hidden = !open; if (open) root.querySelector('input')?.focus(); };
    const paint = session => { const email = session?.user?.email; login.hidden = !!email; user.hidden = !email; if (email) { user.querySelector('.auth-avatar').textContent = email[0].toUpperCase(); user.querySelector('[data-auth-email]').textContent = email; } };
    login.addEventListener('click', () => show(true)); root.querySelectorAll('[data-auth-close]').forEach(button => button.addEventListener('click', () => show(false)));
    document.addEventListener('keydown', event => { if (event.key === 'Escape') show(false); });
    root.querySelectorAll('[data-auth-mode]').forEach(button => button.addEventListener('click', () => { mode = button.dataset.authMode; root.querySelectorAll('[data-auth-mode]').forEach(tab => tab.classList.toggle('active', tab === button)); root.querySelector('.auth-primary').textContent = mode === 'login' ? '登录' : '注册'; message.textContent = ''; message.className = 'auth-message'; }));
    root.querySelector('[data-auth-form]').addEventListener('submit', async event => { event.preventDefault(); const values = new FormData(event.currentTarget), email = values.get('email'), password = values.get('password'); message.textContent = ''; const result = mode === 'login' ? await db.auth.signInWithPassword({ email, password }) : await db.auth.signUp({ email, password, options: { emailRedirectTo: emailRedirectTo() } }); if (result.error) message.textContent = result.error.message; else { track(mode === 'login' ? 'login' : 'signup', { method: 'password' }); message.textContent = mode === 'login' ? '登录成功' : '注册成功，请查收确认邮件'; message.className = 'auth-message success'; if (mode === 'login') show(false); } });
    root.querySelector('[data-auth-magic]').addEventListener('click', async () => { const email = root.querySelector('[name=email]').value; if (!email) { message.textContent = '请先输入邮箱'; return; } const { error } = await db.auth.signInWithOtp({ email, options: { emailRedirectTo: emailRedirectTo() } }); if (!error) track('login', { method: 'magic_link' }); message.textContent = error ? error.message : '登录链接已发送，请查收邮件'; message.className = error ? 'auth-message' : 'auth-message success'; });
    root.querySelectorAll('[data-auth-oauth]').forEach(button => button.addEventListener('click', () => { pendingOAuthMethod = button.dataset.authOauth; return db.auth.signInWithOAuth({ provider: button.dataset.authOauth, options: { redirectTo: emailRedirectTo() } }); }));
    user.querySelector('.auth-avatar').addEventListener('click', () => { const menu = user.querySelector('.auth-dropdown'); menu.hidden = !menu.hidden; });
    root.querySelector('[data-auth-signout]').addEventListener('click', () => db.auth.signOut());
    try { startSync(); } catch (error) { console.warn('Auth sync failed to start', error); }
    db.auth.getSession().then(({ data }) => { paint(data.session); if (data.session) identify(data.session.user.id); }); db.auth.onAuthStateChange((event, session) => { paint(session); if (session) { identify(session.user.id); if (event === 'SIGNED_IN' && pendingOAuthMethod) { track('login', { method: pendingOAuthMethod }); pendingOAuthMethod = null; } } if (event === 'SIGNED_OUT') reset(); });
  }
</script>
