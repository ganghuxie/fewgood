---
import { episodeExcerpt } from '../lib/audio-podcast-display.mjs';
import AudioPodcastLayout from './AudioPodcastLayout.astro';
import { pageNumbers } from '../lib/pagination.mjs';
import { EPISODE_COUNT_LABEL, PAGE_SIZE, episodePath, pageCount, previewPath, showPath, sliceEpisodePage } from '../lib/audio-podcast.mjs';
import { latestEpisodeMarker } from '../lib/audio-podcast-newness.mjs';
import { SMALL_COVER_WIDTH, coverDisplayUrl } from '../lib/audio-podcast-covers.mjs';
const { show, page = 1 } = Astro.props;
const base = import.meta.env.BASE_URL;
const episodes = show.episodes || [];
const pages = pageCount(episodes.length);
const pageEpisodes = sliceEpisodePage(episodes, page);
const pageLink = number => showPath(show.slug, number, base);
const latest = latestEpisodeMarker(show);
const showCoverUrl = show.feed?.cover_url;
---
<AudioPodcastLayout title={`${show.display_name} · 音频播客`}>
  <div data-audio-show-seen data-audio-show={latest?.slug} data-audio-latest-id={latest?.episodeId} data-audio-latest-published-at={latest?.publishedAt}>
  <a class="audio-back" href={previewPath(base)}>← 音频播客</a>
  <header class="audio-show-head">
    {showCoverUrl && <img onerror="const original=this.dataset.coverOriginal;if(original && this.getAttribute('src') !== original){this.removeAttribute('srcset');this.src=original;}else{this.hidden=true;}" data-cover-original={showCoverUrl} class="audio-cover audio-cover-large" src={coverDisplayUrl(showCoverUrl, { width: SMALL_COVER_WIDTH })} alt={`${show.display_name} 官方封面`} width="96" height="96" decoding="async" />}
    <div><h1>{show.display_name || show.name}</h1>
    <p class="audio-show-byline">{show.publisher} · {EPISODE_COUNT_LABEL} {episodes.length} 集</p>
    </div>
  </header>
    {show.limited_public_page_fallback && <p class="audio-source-status">仅收录近期公开免费单集，非完整历史</p>}
  <div class="audio-tabs" role="tablist" aria-label="节目内容">
    <button id="updates-tab" role="tab" aria-selected="true" aria-controls="updates-panel">单集更新</button>
    <button id="about-tab" role="tab" aria-selected="false" aria-controls="about-panel" tabindex="-1">节目详情</button>
  </div>
  <section id="updates-panel" class="audio-tab-panel audio-preview-section" role="tabpanel" aria-labelledby="updates-tab">
    <div class="audio-preview-section-head"><h2 id="episodes-heading">单集更新</h2><p>最新在前 · 第 {page} / {pages} 页 · 每页 {PAGE_SIZE} 集</p></div>
    {show.episodes.length === 0 && <p class="audio-source-status">{show.source_status === 'identity_verified_feed_unavailable' ? '内容暂不可用；节目身份已核验，暂未提供可解析的公开 RSS 单集。' : '暂未获取到单集；可通过节目官方入口查看。'}</p>}
    <ol class="audio-episode-list">
      {pageEpisodes.map(episode => {
        const coverUrl = episode.cover_url || showCoverUrl;
        return <li class="audio-episode"><a class="audio-episode-row" href={episodePath(show, episode, base)}>
        {coverUrl && <img class="audio-row-cover" src={coverDisplayUrl(coverUrl, { width: SMALL_COVER_WIDTH })} data-cover-original={coverUrl} alt="" width="64" height="64" decoding="async" loading="lazy" onerror="const original=this.dataset.coverOriginal;if(original && this.getAttribute('src') !== original){this.removeAttribute('srcset');this.src=original;}else{this.hidden=true;}" />}
        <div class="audio-row-copy"><h3>{episode.title || '未命名单集'}</h3><p class="audio-excerpt">{episodeExcerpt(episode)}</p><p class="audio-episode-meta"><time datetime={episode.published_at_utc}>{episode.published_display}</time><span>{episode.duration_display}</span>{episode.description_truncated && <span>说明可能不完整</span>}</p></div><span aria-hidden="true">↗</span>
      </a></li>})}
    </ol>
    <nav class="audio-pagination" aria-label="单集分页">
      {page > 1 && <a href={pageLink(page - 1)} rel="prev">上一页</a>}
      {pageNumbers(page, pages).map(number => number === null
        ? <span class="audio-gap" aria-hidden="true">…</span>
        : number === page
          ? <span aria-current="page">{number}</span>
          : <a href={pageLink(number)}>{number}</a>)}
      {page < pages && <a href={pageLink(page + 1)} rel="next">下一页</a>}
    </nav>
    <p class="audio-page-note">共 {episodes.length} 集 · {show.episode_count_label || EPISODE_COUNT_LABEL} · 分页只展示当前公开 RSS 中的快照</p>
  </section>
  <section id="about-panel" class="audio-tab-panel audio-show-details" role="tabpanel" aria-labelledby="about-tab" hidden>
    <p>{show.feed?.description_text || '发布者暂未在 RSS 中提供节目介绍。'}</p>
  </section>
  </div>
</AudioPodcastLayout>
<script is:inline>
  const tabs = [...document.querySelectorAll('.audio-tabs [role="tab"]')];
  function selectTab(selected) {
    tabs.forEach(tab => {
      const active = tab === selected;
      tab.setAttribute('aria-selected', String(active));
      tab.tabIndex = active ? 0 : -1;
      document.getElementById(tab.getAttribute('aria-controls')).hidden = !active;
    });
  }
  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => selectTab(tab));
    tab.addEventListener('keydown', event => {
      if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
      event.preventDefault();
      const next = tabs[event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : (index + 1) % tabs.length];
      selectTab(next); next.focus();
    });
  });
</script>
<script>
  import { markAudioShowSeen, markerFromDataset } from '../lib/audio-podcast-newness.mjs';
  const currentShow = document.querySelector('[data-audio-show-seen]');
  markAudioShowSeen(markerFromDataset(currentShow?.dataset));
</script>
