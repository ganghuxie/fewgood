---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const link = path => `${base}${path}`;
---
<aside id="site-sidebar" class="site-sidebar" aria-label="侧边栏">
  <a class="side-home" href={link('/')}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1Z"/></svg><span>首页</span></a>
  <div class="side-divider"></div>
  <a class="side-section" href={link('/following/')}><b>已关注</b><span>›</span></a>
  <div class="followed-list" data-followed-list><p>还没有关注的频道</p></div>
</aside>
<script>
  import { KEYS, channelHasNew, list, markChannelSeen } from '../scripts/library.js';
  const root = document.querySelector('[data-followed-list]');
  const base = import.meta.env.BASE_URL.replace(/\/$/, '');
  const esc = value => String(value || '').replace(/[&<>\"]/g, c => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;' }[c]));
  let channels = [];
  const render = () => { const map = Object.fromEntries(channels.map(c => [c.id, c])); const selected = list(KEYS.following); root.innerHTML = selected.length ? selected.map(c => { const data = map[c.id] || c; const latest = data.videos?.[0]?.published_at; return `<a class="followed-item" href="${base}/channel/${c.id}/"><img src="${esc(data.thumbnail || c.thumbnail)}" alt=""><span>${esc(data.title || c.title)}</span>${channelHasNew(c.id, latest) ? '<i class="new-dot" aria-label="有新视频"></i>' : ''}</a>`; }).join('') : '<p>还没有关注的频道</p>'; };
  fetch(`${import.meta.env.BASE_URL}channels.json`).then(response => response.json()).then(data => { channels = data.channels || []; render(); }).catch(render);
  document.addEventListener('youtuber:library-change', render);
</script>
<style is:global>
.site-sidebar{position:fixed;z-index:30;top:105px;bottom:0;left:0;width:240px;padding:14px 12px;background:#fff;transform:translateX(-100%);transition:transform .2s ease;overflow-y:auto}.sidebar-open .site-sidebar{transform:translateX(0)}.side-home,.side-section,.followed-item{display:flex;align-items:center;gap:16px;min-height:44px;padding:0 14px;border-radius:10px;color:#0f0f0f;text-decoration:none}.side-home:hover,.side-section:hover,.followed-item:hover{background:#f2f2f2}.side-home svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linejoin:round}.side-section{justify-content:space-between;font-size:14px}.side-section b{font-weight:500}.side-section span{font-size:25px;color:#606060}.side-divider{border-top:1px solid #e5e5e5;margin:14px 0}.followed-list p{padding:12px 14px;color:#606060;font-size:13px}.followed-item{gap:10px;min-height:40px;padding-right:8px;font-size:14px}.followed-item img{width:24px;height:24px;border-radius:50%;object-fit:cover;background:#eee;flex:none}.followed-item span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.new-dot{width:7px;height:7px;margin-left:auto;border-radius:50%;background:#065fd4;flex:none}.sidebar-backdrop{display:none}.sidebar-open .sidebar-backdrop{display:block;position:fixed;inset:0;z-index:25;background:#0006}@media(max-width:899px){.site-sidebar{top:0;width:280px;padding-top:70px;box-shadow:2px 0 8px #0002}}
</style>
